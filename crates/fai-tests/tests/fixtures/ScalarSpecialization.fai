module Main

let ack m n =
  if m = 0 then n + 1
  else if n = 0 then ack (m - 1) 1
  else ack (m - 1) (ack m (n - 1))

let descend level n =
  if level = 0 then n else descend (level - 1) (n + 1)

public main : Runtime -> Unit / { Console }
let main runtime =
  let combined = ack 2 (Array.sum (Array.range 0 3))
  let wrapped = descend 3 9223372036854775806
  let bounded = descend 8 (descend 8 0)
  runtime.console.writeLine (Int.toString combined ++ " " ++ Int.toString wrapped ++ " " ++ Int.toString bounded)
