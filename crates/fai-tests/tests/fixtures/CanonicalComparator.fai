module Main

let count cmp n a b acc =
  if n <= 0 then acc else count cmp (n - 1) a b (if cmp a b <= 0 then acc + 1 else acc)

public compared : Int -> Int -> Int
let compared a b = count (fun x y -> x - y) 3 a b 0

let twice cmp n a b acc =
  if n <= 0 then
    acc
  else
    let result = cmp a b
    let next = if result <= 0 then acc + result else acc
    twice cmp (n - 1) a b next

public reused : Int -> Int -> Int
let reused a b = twice (fun x y -> x - y) 2 a b 0

public main : Runtime -> Unit / { Console }
let main runtime =
  let small = compared (-4611686018427387904) 4611686018427387903 = 3
  let wrapped = compared 9223372036854775807 (-1) = 3 && compared (-9223372036854775808) 1 = 0
  let reusedResult = reused 7 9 = -4
  runtime.console.writeLine (if small && wrapped && reusedResult then "yes" else "no")
