module Main

public read : Int -> Array Int -> Int
let read i xs =
  let n = Array.length xs
  let j = i - 1
  if n > 0 then
    if i <= 0 then
      if j >= 0 then Array.unsafeGet j xs else 0
    else
      0
  else
    0

public main : Runtime -> Unit / { Console }
let main runtime =
  runtime.console.writeLine (Int.toString (read (0 - 9223372036854775807 - 1) [| 10 |]))
