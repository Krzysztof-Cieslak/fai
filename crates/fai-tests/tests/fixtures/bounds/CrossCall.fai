module Main

at : Int -> Array Int -> Int -> Int
let at i xs n =
  if n <= 0 then Array.unsafeGet i xs else at i xs (n - 1)

public read : Int -> Array Int -> Int
let read i xs =
  let j = i + 1
  if i >= 0 then
    if j < Array.length xs then at j xs 1 else 0
  else
    0

public main : Runtime -> Unit / { Console }
let main runtime =
  runtime.console.writeLine (Int.toString (read 9223372036854775807 [| 10 |]))
