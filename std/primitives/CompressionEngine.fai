module CompressionEngine

/// Immutable native codec snapshot, with content-based comparison and hashing.
public opaque type State =
  | StateCell Int

/// Code, message, detection offset, member index, total input and total output.
public type Error =
  | EngineError Int String Int Int Int Int

/// Next state, output, progress and optional terminal failure. Progress contains
/// consumed bytes, status, total input, total output and completed members.
public type Step = State * Bytes * Array Int * Option Error

/// Options: encode flag, format (raw/zlib/gzip), level, input/output limits,
/// output chunk bytes, gzip header bytes and gzip member limit.
public create : Array Int -> Result State Error
let create options = Prim.compressionCreate options
example: Result.isOk (create [| 1, 2, 6, 1024, 1024, 64, 1024, 16 |])
example: Result.isErr (create [||])

/// Request: input start offset and action (feed/sync flush/finish).
public step : State -> Bytes -> Array Int -> Step
let step state input request = Prim.compressionStep state input request
example: checkStep step

let checkStep run =
  match create [| 1, 2, 6, 1024, 1024, 64, 1024, 16 |] with
  | Err _ -> false
  | Ok state ->
    let (_, bytes, progress, error) = run state Bytes.empty [| 0, 2 |]
    Bytes.length bytes = 20 && Array.unsafeGet 1 progress = 4 && Option.isNone error
