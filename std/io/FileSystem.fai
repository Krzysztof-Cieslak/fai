module FileSystem

/// Stable categories shared by file, directory, and temporary-resource operations.
public type ErrorKind =
  | NotFound
  | AlreadyExists
  | PermissionDenied
  | NotDirectory
  | IsDirectory
  | DirectoryNotEmpty
  | InvalidPath
  | InvalidArgument
  | InvalidEncoding
  | Closed
  | Unsupported
  | CrossDevice
  | TooManyLinks
  | TooLarge
  | Cancelled
  | IoFailure

public type Error = {
  destination : Option Path,
  kind : ErrorKind,
  message : String,
  nativeCode : Option Int,
  operation : String,
  path : Option Path
}

/// Construct a portable error; host failures additionally retain native codes.
public error : ErrorKind -> String -> Option Path -> String -> Error
let error kind operation path message = {
  destination = None,
  kind = kind,
  message = message,
  nativeCode = None,
  operation = operation,
  path = path
}
example: (error Closed "read" None "closed").kind = Closed

public errorToString : Error -> String
let errorToString error =
  error.operation ++ (match error.path with
  | None -> ""
  | Some path -> " " ++ Path.display path) ++ ": " ++ error.message
example: errorToString (error Closed "read" None "closed") = "read: closed"

/// CreateNew is exclusive; Truncate/Append create if missing; Existing never creates.
public type WriteMode =
  | CreateNew
  | Truncate
  | Append
  | Existing

public type EntryKind =
  | RegularFile
  | Directory
  | SymbolicLink
  | Other

/// Metadata is a point-in-time snapshot; native identity is opaque binary data.
public type Metadata = {
  accessed : Option Instant,
  created : Option Instant,
  identity : Bytes,
  kind : EntryKind,
  length : Int,
  modified : Option Instant,
  readonly : Bool
}

/// The kind is a cheap hint, not a guarantee about a later operation.
public type Entry = { hint : Option EntryKind, name : Path, path : Path }

/// Scope failures preserve both the callback failure and a failed cleanup.
public type ScopeError 'error =
  | OpenError Error
  | OpenAndCloseError Error Error
  | BodyError 'error
  | CloseError Error
  | BodyAndCloseError 'error Error

public scopeResult : Result 'a 'error -> Result Unit Error -> Result 'a (ScopeError 'error)
let scopeResult body cleanup =
  match (body, cleanup) with
  | (Ok value, Ok _) -> Ok value
  | (Err error, Ok _) -> Err (BodyError error)
  | (Ok _, Err error) -> Err (CloseError error)
  | (Err first, Err last) -> Err (BodyAndCloseError first last)
example: scopeResult (Ok 3) (Ok ()) = Ok 3

let present result =
  match result with
  | Ok _ -> Ok true
  | Err error -> if error.kind = NotFound then Ok false else Err error

/// Existence of a followed target. Permission and I/O errors remain errors.
public exists : FileSystem -> Path -> Result Bool Error / { FileSystem }
let exists fs path = present (fs.metadata path)

/// Existence of an entry itself, including a dangling symbolic link.
public entryExists : FileSystem -> Path -> Result Bool Error / { FileSystem }
let entryExists fs path = present (fs.linkMetadata path)
