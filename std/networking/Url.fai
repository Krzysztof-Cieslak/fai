module Url

// An opaque URL/reference value (absolute, network-path, or relative), in the style of the
// date & time value types. Parse one with `parse` and read its parts with the
// accessors; render it with `toString`. The components cover the common subset:
// scheme, userinfo, host (including bracketed IPv6 literals), port, path, raw
// query, and fragment. Scheme and authority are independent: a network-path
// reference has a host but no scheme, while an origin-form target has neither.
//
// The query is kept raw (faithful to the wire); `queryPairs` decodes it into
// key/value pairs on demand, and `encodeComponent`/`decodeComponent` apply
// percent-encoding. The components live in a record behind a single hidden
// constructor (an opaque union, so the type is nominal across files).
public opaque type Url =
  | MkUrl { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String }

// Unwrap the components record.
fields : Url -> { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String }
let fields url =
  match url with
  | MkUrl r -> r

// The empty component record (an origin-form URL with just an empty path).
emptyFields : { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String }
let emptyFields = {
  fragment = None,
  host = None,
  path = "",
  port = None,
  query = None,
  scheme = None,
  userinfo = None
}

// Whether an `Option` holds a value.
isSome : Option 'a -> Bool
let isSome opt =
  match opt with
  | Some x -> true
  | None -> false

// Split `s` on the first occurrence of `sep`: `Some (before, after)`, or `None`
// when `sep` does not occur. `after` keeps any further occurrences intact.
splitFirst : String -> String -> Option (String * String)
let splitFirst sep s =
  match String.split sep s with
  | [] -> None
  | only :: [] -> None
  | first :: rest -> Some (first, String.join sep rest)

// Parse `host[:port]` (or `[ipv6][:port]`) into a host and optional port.
parseHostPort : String -> Result (Option String * Option Int) String
let parseHostPort hp =
  if String.take 1 hp = "[" then
    parseBracketHost hp
  else
    match splitFirst ":" hp with
    | None -> if validHost hp then Ok (Some hp, None) else Err "invalid URL host"
    | Some (h, p) ->
      if validHost h then
        Result.map (fun port -> (Some h, Some port)) (parsePort p)
      else
        Err "invalid URL host"

// Parse a bracketed IPv6 authority `[....](:port)?`.
parseBracketHost : String -> Result (Option String * Option Int) String
let parseBracketHost hp =
  match splitFirst "]" hp with
  | None -> Err "unterminated bracketed URL host"
  | Some (inside, after) ->
    let host = inside ++ "]"
    if not (validHost (String.drop 1 inside)) then
      Err "invalid bracketed URL host"
    else
      let port =
        if after = "" then
          Ok None
        else if String.take 1 after = ":" then
          Result.map (fun value -> Some value) (parsePort (String.drop 1 after))
        else
          Err "invalid text after bracketed URL host"
      Result.map (fun port -> (Some host, port)) port

validAuthorityBytes : Bytes -> Int -> Bool
let validAuthorityBytes bytes i =
  if i >= Bytes.length bytes then
    true
  else
    let byte = Bytes.unsafeGet i bytes
    byte > 32 && byte <> 127 && byte <> 92 && validAuthorityBytes bytes (i + 1)

validHost : String -> Bool
let validHost host =
  host <> "" && not (String.contains host "[") && not (String.contains host "]") && not (String.contains host "@") && validAuthorityBytes (Bytes.fromString host) 0

portFrom : Bytes -> Int -> Int -> Result Int String
let portFrom bytes i value =
  if i >= Bytes.length bytes then
    Ok value
  else
    let digit = Bytes.unsafeGet i bytes - 48
    if digit < 0 || digit > 9 || value > (65535 - digit) / 10 then
      Err "invalid URL port"
    else
      portFrom bytes (i + 1) (value * 10 + digit)

parsePort : String -> Result Int String
let parsePort text =
  if text = "" then Err "empty URL port" else portFrom (Bytes.fromString text) 0 0

// `Some s` unless `s` is empty.
someNonEmpty : String -> Option String
let someNonEmpty s = if s = "" then None else Some s

// Parse an authority `[userinfo@]host[:port]` into its parts.
parseAuthority : String -> Result (Option String * Option String * Option Int) String
let parseAuthority authority =
  match splitFirst "@" authority with
  | None ->
    match parseHostPort authority with
    | Err e -> Err e
    | Ok (host, port) -> Ok (None, host, port)
  | Some (ui, hostport) ->
    if not (validAuthorityBytes (Bytes.fromString ui) 0) then
      Err "invalid URL userinfo"
    else
      match parseHostPort hostport with
      | Err e -> Err e
      | Ok (host, port) -> Ok (someNonEmpty ui, host, port)

// Parse `authority[/path]` after an explicit `//` marker.
parseAuthorityPath : String -> Result Url String
let parseAuthorityPath remainder =
  let (authority, path) =
    match splitFirst "/" remainder with
    | None -> (remainder, "/")
    | Some (authority, rest) -> (authority, "/" ++ rest)
  match parseAuthority authority with
  | Err e -> Err e
  | Ok (ui, host, port) ->
    Ok (MkUrl { emptyFields with host = host, path = path, port = port, userinfo = ui })

/// Parse a nonempty URL or URI reference: an absolute scheme, a `//host/path`
/// network-path reference, or a relative/origin-form path. Schemes are lower-cased;
/// authorities require a nonempty host and decimal ports in 0..65535.
public parse : String -> Result Url String
let parse input = if input = "" then Err "empty URL" else parseReference input
example: Result.map path (parse "https://example.com/p") = Ok "/p"

// Unlike a standalone URL, an empty reference is meaningful during resolution.
parseReference : String -> Result Url String
let parseReference input =
  match splitTrailing (splitFirst "#" input) input with
  | (beforeFrag, fragment) ->
    match splitTrailing (splitFirst "?" beforeFrag) beforeFrag with
    | (beforeQuery, query) -> assemble beforeQuery query fragment

isAlphaCode : Int -> Bool
let isAlphaCode code = (code >= 65 && code <= 90) || (code >= 97 && code <= 122)

schemeTail : Bytes -> Int -> Bool
let schemeTail bytes i =
  if i >= Bytes.length bytes then
    true
  else
    let code = Bytes.unsafeGet i bytes
    (isAlnumCode code || code = 43 || code = 45 || code = 46) && schemeTail bytes (i + 1)

splitScheme : String -> Result (Option String * String) String
let splitScheme text =
  match splitFirst ":" text with
  | None -> Ok (None, text)
  | Some (prefix, rest) ->
    if String.contains prefix "/" then
      Ok (None, text)
    else
      let bytes = Bytes.fromString prefix
      if Bytes.length bytes > 0 && isAlphaCode (Bytes.unsafeGet 0 bytes) && schemeTail bytes 1 then
        Ok (Some (String.toLower prefix), rest)
      else
        Err "invalid URL scheme"

// Apply a `splitFirst` result as `(head, Some tail)`, or `(whole, None)` when the
// separator was absent.
splitTrailing : Option (String * String) -> String -> (String * Option String)
let splitTrailing split whole =
  match split with
  | None -> (whole, None)
  | Some (head, tail) -> (head, Some tail)

// Assemble the scheme/authority/path part with an already-extracted query and
// fragment.
assemble : String -> Option String -> Option String -> Result Url String
let assemble rest query fragment =
  match splitScheme rest with
  | Err e -> Err e
  | Ok (scheme, path) ->
    if String.take 2 path = "//" then
      match parseAuthorityPath (String.drop 2 path) with
      | Err e -> Err e
      | Ok url ->
        let base = fields url
        Ok (MkUrl { base with fragment = fragment, query = query, scheme = scheme })
    else
      Ok (MkUrl { emptyFields with
        fragment = fragment,
        path = path,
        query = query,
        scheme = scheme
      })

/// The scheme (lower-cased), e.g. `Some "https"`; `None` for an origin-form target.
public scheme : Url -> Option String
let scheme url = (fields url).scheme
example: scheme (orEmpty (parse "https://a.test/")) = Some "https"

/// The userinfo (`user:pass`) if present.
public userinfo : Url -> Option String
let userinfo url = (fields url).userinfo
example: userinfo (orEmpty (parse "https://u@a.test/")) = Some "u"

/// The host (a registered name or a bracketed IPv6 literal) if present.
public host : Url -> Option String
let host url = (fields url).host
example: host (orEmpty (parse "https://a.test:9/p")) = Some "a.test"

/// The explicit port if one was given.
public port : Url -> Option Int
let port url = (fields url).port
example: port (orEmpty (parse "https://a.test:9/p")) = Some 9

/// The path (`"/"`-rooted for an absolute URL; may be empty for a bare relative).
public path : Url -> String
let path url = (fields url).path
example: path (orEmpty (parse "https://a.test/x/y")) = "/x/y"

/// The raw query string (without the leading `?`) if present.
public query : Url -> Option String
let query url = (fields url).query
example: query (orEmpty (parse "https://a.test/?a=1&b=2")) = Some "a=1&b=2"

/// The fragment (without the leading `#`) if present.
public fragment : Url -> Option String
let fragment url = (fields url).fragment
example: fragment (orEmpty (parse "https://a.test/#top")) = Some "top"

// Unwrap a parse result, falling back to the empty URL (for use in contracts).
orEmpty : Result Url String -> Url
let orEmpty r =
  match r with
  | Ok u -> u
  | Err e -> MkUrl emptyFields

/// The effective port: the explicit port, else the scheme default (80 for `http`,
/// 443 for `https`), else `None`.
public effectivePort : Url -> Option Int
let effectivePort url =
  match (fields url).port with
  | Some p -> Some p
  | None ->
    if (fields url).scheme = Some "http" then
      Some 80
    else if (fields url).scheme = Some "https" then Some 443 else None
example: effectivePort (orEmpty (parse "https://a.test/")) = Some 443

/// Whether the scheme is `https`.
public isHttps : Url -> Bool
let isHttps url = (fields url).scheme = Some "https"
example: isHttps (orEmpty (parse "https://a.test/")) = true

/// The origin-form request target: the path (defaulting to `/`) plus `?query`. This
/// is what goes on the HTTP request line.
public requestTarget : Url -> String
let requestTarget url =
  let r = fields url
  let p = if r.path = "" then "/" else r.path
  match r.query with
  | Some q -> p ++ "?" ++ q
  | None -> p
example: requestTarget (orEmpty (parse "https://a.test/p?x=1")) = "/p?x=1"

/// Render the URL back to a string (scheme://[userinfo@]host[:port]path?query#frag,
/// or just path?query#frag for an origin-form URL).
public toString : Url -> String
let toString url =
  let r = fields url
  let q =
    match r.query with
    | Some s -> "?" ++ s
    | None -> ""
  let f =
    match r.fragment with
    | Some s -> "#" ++ s
    | None -> ""
  renderAuthority r ++ r.path ++ q ++ f
example: toString (orEmpty (parse "https://a.test:8/p?x=1#h")) = "https://a.test:8/p?x=1#h"

// Render independent scheme/authority prefixes (both absent for origin-form).
renderAuthority : { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String } -> String
let renderAuthority r =
  let scheme =
    match r.scheme with
    | None -> ""
    | Some s -> s ++ ":"
  let authority =
    match r.host with
    | None -> ""
    | Some host ->
      let ui =
        match r.userinfo with
        | Some u -> u ++ "@"
        | None -> ""
      let port =
        match r.port with
        | Some n -> ":" ++ Int.toString n
        | None -> ""
      "//" ++ ui ++ host ++ port
  scheme ++ authority

/// Resolve a (possibly relative) reference against a base URL — for following a
/// redirect `Location`. A network-path (`//host/…`) inherits the base scheme;
/// an absolute-path or relative reference inherits its authority too. Literal
/// dot segments are removed. An empty path inherits the base query unless a new
/// query is supplied; an empty reference is valid here (but not in `parse`).
public resolve : Url -> String -> Result Url String
let resolve base ref =
  match parseReference ref with
  | Err e -> Err e
  | Ok r ->
    let rf = fields r
    if isSome rf.scheme then
      Ok (MkUrl { rf with path = removeDotSegments rf.path })
    else if isSome rf.host then
      Ok (MkUrl { rf with path = removeDotSegments rf.path, scheme = (fields base).scheme })
    else
      Ok (resolveRelative (fields base) rf)
example: Result.map host (resolve (orEmpty (parse "https://a.test/x/")) "/y") = Ok (Some "a.test")

// Reference-resolution examples use the base from the URI resolution algorithm.
resolved : String -> Result String String
let resolved reference =
  Result.map toString (resolve (orEmpty (parse "http://a/b/c/d;p?q")) reference)
example: resolved "g:h" = Ok "g:h"
example: resolved "g" = Ok "http://a/b/c/g"
example: resolved "./g" = Ok "http://a/b/c/g"
example: resolved "g/" = Ok "http://a/b/c/g/"
example: resolved "/g" = Ok "http://a/g"
example: resolved "//g" = Ok "http://g/"
example: resolved "?y" = Ok "http://a/b/c/d;p?y"
example: resolved "g?y" = Ok "http://a/b/c/g?y"
example: resolved "#s" = Ok "http://a/b/c/d;p?q#s"
example: resolved "g#s" = Ok "http://a/b/c/g#s"
example: resolved "g?y#s" = Ok "http://a/b/c/g?y#s"
example: resolved ";x" = Ok "http://a/b/c/;x"
example: resolved "g;x" = Ok "http://a/b/c/g;x"
example: resolved "g;x?y#s" = Ok "http://a/b/c/g;x?y#s"
example: resolved "" = Ok "http://a/b/c/d;p?q"
example: resolved "." = Ok "http://a/b/c/"
example: resolved "./" = Ok "http://a/b/c/"
example: resolved ".." = Ok "http://a/b/"
example: resolved "../" = Ok "http://a/b/"
example: resolved "../g" = Ok "http://a/b/g"
example: resolved "../.." = Ok "http://a/"
example: resolved "../../" = Ok "http://a/"
example: resolved "../../g" = Ok "http://a/g"
example: resolved "../../../g" = Ok "http://a/g"
example: resolved "../../../../g" = Ok "http://a/g"
example: resolved "/./g" = Ok "http://a/g"
example: resolved "/../g" = Ok "http://a/g"
example: resolved "g." = Ok "http://a/b/c/g."
example: resolved ".g" = Ok "http://a/b/c/.g"
example: resolved "g.." = Ok "http://a/b/c/g.."
example: resolved "..g" = Ok "http://a/b/c/..g"
example: resolved "./../g" = Ok "http://a/b/g"
example: resolved "./g/." = Ok "http://a/b/c/g/"
example: resolved "g/./h" = Ok "http://a/b/c/g/h"
example: resolved "g/../h" = Ok "http://a/b/c/h"
example: resolved "g;x=1/./y" = Ok "http://a/b/c/g;x=1/y"
example: resolved "g;x=1/../y" = Ok "http://a/b/c/y"
example: resolved "g?y/./x" = Ok "http://a/b/c/g?y/./x"
example: resolved "g#s/../x" = Ok "http://a/b/c/g#s/../x"
example: resolved "http:g" = Ok "http:g"
example: resolved "%2E%2E/g" = Ok "http://a/b/c/%2E%2E/g"
example: resolved "g%2Fh" = Ok "http://a/b/c/g%2Fh"
example: resolved "/g//h/../" = Ok "http://a/g//"
example: resolved "//b.test:8080/x" = Ok "http://b.test:8080/x"
example: resolved "//[::1]:443/x" = Ok "http://[::1]:443/x"
example: Result.map toString (parse "//b.test/x") = Ok "//b.test/x"
example: Result.map toString (resolve (orEmpty (parse "https://a.test/x?q#old")) "") = Ok "https://a.test/x?q"
example: Result.isErr (parse "http://a.test:65536/")
example: Result.isErr (parse "http://a.test:-1/")
example: Result.isErr (parse "http://a.test:bad/")
example: Result.isErr (parse "http://a.test:/")
example: Result.isErr (parse "http://[::1/")
example: Result.isErr (parse "http://[::1]extra/")
example: Result.isErr (parse "http:///x")
example: Result.map effectivePort (parse "http://a.test:00080/") = Ok (Some 80)

// Resolve a reference record `rf` with no authority against the base's scheme and
// authority, merging the path.
resolveRelative : { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String } -> { fragment : Option String, host : Option String, path : String, port : Option Int, query : Option String, scheme : Option String, userinfo : Option String } -> Url
let resolveRelative base rf =
  let p =
    if String.take 1 rf.path = "/" then
      removeDotSegments rf.path
    else if rf.path = "" then
      base.path
    else if isSome base.host && base.path = "" then
      removeDotSegments ("/" ++ rf.path)
    else
      removeDotSegments (mergePath base.path rf.path)
  let query = if rf.path = "" && not (isSome rf.query) then base.query else rf.query
  MkUrl { rf with
    host = base.host,
    path = p,
    port = base.port,
    query = query,
    scheme = base.scheme,
    userinfo = base.userinfo
  }

// Normalize literal path segments without decoding escaped dots or separators.
removeDotSegments : String -> String
let removeDotSegments path = normalizeSegments (String.split "/" path) []

popSegment : List String -> List String
let popSegment stack =
  match stack with
  | [] -> []
  | one :: [] -> [""]
  | one :: rest -> rest

normalizeSegments : List String -> List String -> String
let normalizeSegments segments stack =
  match segments with
  | [] -> String.join "/" (List.reverse stack)
  | "." :: [] -> String.join "/" (List.reverse ("" :: stack))
  | "." :: rest -> normalizeSegments rest stack
  | ".." :: [] -> String.join "/" (List.reverse ("" :: popSegment stack))
  | ".." :: rest -> normalizeSegments rest (popSegment stack)
  | segment :: rest -> normalizeSegments rest (segment :: stack)
forall path: removeDotSegments (removeDotSegments path) = removeDotSegments path

// Merge a relative path against the base path's directory (everything up to and
// including the last `/`).
mergePath : String -> String -> String
let mergePath basePath rel =
  match splitFirst "/" basePath with
  | None -> rel
  | Some (head, tail) -> dirOf basePath ++ rel

// The directory portion of a path: up to and including its last `/` (empty if none).
dirOf : String -> String
let dirOf p =
  match String.split "/" p with
  | [] -> ""
  | one :: [] -> ""
  | parts -> String.join "/" (dropLast parts) ++ "/"

// Every element but the last.
dropLast : List 'a -> List 'a
let dropLast xs =
  match List.reverse xs with
  | [] -> []
  | last :: rest -> List.reverse rest

/// Decode the query into key/value pairs (`a=1&b=2` → `[("a","1"),("b","2")]`),
/// percent-decoding each key and value. A pair without `=` yields an empty value.
public queryPairs : Url -> List (String * String)
let queryPairs url =
  match (fields url).query with
  | None -> []
  | Some q -> List.map decodePair (String.split "&" q)
example: queryPairs (orEmpty (parse "https://a.test/?a=1&b=2")) = [("a", "1"), ("b", "2")]

// Decode one `key=value` segment, percent-decoding both halves.
decodePair : String -> (String * String)
let decodePair seg =
  match splitFirst "=" seg with
  | None -> (decodeComponent seg, "")
  | Some (k, v) -> (decodeComponent k, decodeComponent v)

/// Percent-encode a string for use in a URL component: ASCII letters, digits, and
/// `- _ . ~` pass through; every other byte becomes `%XX`.
public encodeComponent : String -> String
let encodeComponent s = encodeFrom s 0 (String.length s) ""
example: encodeComponent "a b&c" = "a%20b%26c"

// Append the percent-encoding of `s`'s characters from index `i` to `n` onto `acc`.
encodeFrom : String -> Int -> Int -> String -> String
let encodeFrom s i n acc =
  if i >= n then acc else encodeFrom s (i + 1) n (acc ++ encodeChar (String.substring i 1 s))

// Encode a single character: keep it if unreserved, else percent-encode its bytes.
encodeChar : String -> String
let encodeChar c = if isUnreserved c then c else encodeBytes (Bytes.toList (Bytes.fromString c)) ""

// Whether a one-character string is an unreserved URL character (ASCII letter,
// digit, or one of `- _ . ~`). A multi-byte (non-ASCII) character is reserved, so
// its UTF-8 bytes get percent-encoded.
isUnreserved : String -> Bool
let isUnreserved c = isAlnumCode (firstByte c) || c = "-" || c = "_" || c = "." || c = "~"

// Whether a byte is an ASCII letter or digit.
isAlnumCode : Int -> Bool
let isAlnumCode code =
  (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)

// Append the `%XX` encoding of each byte onto `acc`.
encodeBytes : List Int -> String -> String
let encodeBytes bytes acc =
  match bytes with
  | [] -> acc
  | b :: rest -> encodeBytes rest (acc ++ "%" ++ hexDigit (b / 16) ++ hexDigit (Int.floorMod b 16))

// A single upper-case hex digit for `0..15` (the percent-encoding convention).
hexDigit : Int -> String
let hexDigit n = String.substring n 1 "0123456789ABCDEF"

/// Percent-decode a string (`%XX` → the byte; `+` is left as-is). Invalid escapes
/// pass through literally. If decoded bytes are not valid UTF-8, return the
/// original component unchanged rather than losing text.
public decodeComponent : String -> String
let decodeComponent s =
  let bytes = Bytes.fromString s
  match Bytes.toString (Bytes.fromList (decodeFrom bytes 0 (Bytes.length bytes) [])) with
  | Some decoded -> decoded
  | None -> s
example: decodeComponent "a%20b%26c" = "a b&c"
example: decodeComponent "café%20😀" = "café 😀"
example: decodeComponent "%GG%2G" = "%GG%2G"
example: decodeComponent "%41%FF" = "%41%FF"
example: queryPairs (orEmpty (parse "/?q=café%20😀&bad=%GG")) = [("q", "café 😀"), ("bad", "%GG")]
forall s: decodeComponent (encodeComponent s) = s

// Decode UTF-8 bytes, accumulating in reverse. A literal character keeps every
// byte, and a '%' consumes three bytes only when both hex digits are valid.
decodeFrom : Bytes -> Int -> Int -> List Int -> List Int
let decodeFrom s i n acc =
  if i >= n then
    List.reverse acc
  else if Bytes.unsafeGet i s = 37 && n - i >= 3 then
    match (hexVal (Bytes.unsafeGet (i + 1) s), hexVal (Bytes.unsafeGet (i + 2) s)) with
    | (Some hi, Some lo) -> decodeFrom s (i + 3) n ((hi * 16 + lo) :: acc)
    | _ -> decodeFrom s (i + 1) n (37 :: acc)
  else
    decodeFrom s (i + 1) n (Bytes.unsafeGet i s :: acc)

// The first byte of a (single-character) string.
firstByte : String -> Int
let firstByte c =
  let b = Bytes.fromString c
  if Bytes.length b > 0 then Bytes.unsafeGet 0 b else 0

// The numeric value of a hex byte (case-insensitive), or None for a non-digit.
hexVal : Int -> Option Int
let hexVal code =
  if code >= 48 && code <= 57 then
    Some (code - 48)
  else if code >= 97 && code <= 102 then
    Some (code - 87)
  else if code >= 65 && code <= 70 then Some (code - 55) else None
