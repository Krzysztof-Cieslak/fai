module SemverProperties

let bigNumber values =
  "1" ++ String.join "" (List.map (fun value ->
    Int.toString ((Int.and value 15) % 10)) (List.take 40 values))

let make values = Semver.fromParts {
  build = ["source"],
  major = bigNumber values,
  minor = "2",
  patch = "3",
  prerelease = ["rc", "1"]
}

let sign value = if value < 0 then -1 else if value > 0 then 1 else 0

let roundTrip values =
  match make values with
  | Err _ -> false
  | Ok version ->
    Semver.parse (Semver.toString version) = Ok version && Semver.fromParts (Semver.parts version) = Ok version && Semver.compare version version = 0

let case001 testInput =
  let values = testInput
  let testActual = roundTrip values
  Expect.isTrue "property: roundTrip values" testActual

let antisymmetric first second =
  match (make first, make second) with
  | (Ok first, Ok second) ->
    sign (Semver.compare first second) = 0 - sign (Semver.compare second first)
  | _ -> false

let case002 testInput =
  let (first, second) = testInput
  let testActual = antisymmetric first second
  Expect.isTrue "property: antisymmetric first second" testActual

let transitive first second third =
  match (make first, make second, make third) with
  | (Ok a, Ok b, Ok c) ->
    if Semver.compare a b <= 0 && Semver.compare b c <= 0 then Semver.compare a c <= 0 else true
  | _ -> false

let case003 testInput =
  let (first, second, third) = testInput
  let testActual = transitive first second third
  Expect.isTrue "property: transitive first second third" testActual

let bumps values =
  match make values with
  | Err _ -> false
  | Ok version ->
    let major = Semver.bumpMajor version
    let minor = Semver.bumpMinor version
    let patch = Semver.bumpPatch version
    let released = Semver.release version
    Semver.compare major version > 0 && Semver.compare minor version > 0 && Semver.compare patch version > 0 && Semver.compare released version > 0 && (Semver.parts major).minor = "0" && (Semver.parts major).patch = "0" && (Semver.parts minor).patch = "0" && (Semver.parts patch).build = [] && (Semver.parts patch).prerelease = [] && Semver.release released = released

let case004 testInput =
  let values = testInput
  let testActual = bumps values
  Expect.isTrue "property: bumps values" testActual

let metadata values stamp =
  match make values with
  | Err _ -> false
  | Ok original ->
    match Semver.fromParts { Semver.parts original with build = [Int.toString stamp] } with
    | Err _ -> false
    | Ok changed -> Semver.samePrecedence original changed && Semver.compare original changed = 0

let case005 testInput =
  let (values, stamp) = testInput
  let testActual = metadata values stamp
  Expect.isTrue "property: metadata values stamp" testActual

let total text =
  match Semver.parse text with
  | Ok version -> Semver.toString version = text
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset <= Bytes.length (Bytes.fromString text)

let case006 testInput =
  let text = testInput
  let testActual = total text
  Expect.isTrue "property: total text" testActual

let rangeTotal text =
  match SemverRange.parse text with
  | Ok range -> SemverRange.parse (SemverRange.toString range) = Ok range
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset <= Bytes.length (Bytes.fromString text)

let case007 testInput =
  let text = testInput
  let testActual = rangeTotal text
  Expect.isTrue "property: rangeTotal text" testActual

let matching values =
  let core = bigNumber values
  match (Semver.parse (core ++ ".2.3"), SemverRange.parse ("^" ++ core ++ ".0.0")) with
  | (Ok version, Ok range) ->
    SemverRange.matches range version && SemverRange.maxSatisfying range [
      version,
      version
    ] = Some version && not (SemverRange.matches range (Semver.bumpMajor version))
  | _ -> false

let case008 testInput =
  let values = testInput
  let testActual = matching values
  Expect.isTrue "property: matching values" testActual

let machineIntegers major minor patch =
  let major = Int.and major 9223372036854775807
  let minor = Int.and minor 9223372036854775807
  let patch = Int.and patch 9223372036854775807
  match Semver.fromInts major minor patch with
  | Err _ -> false
  | Ok version ->
    Semver.toInts version = Ok {
      major = major,
      minor = minor,
      patch = patch
    } && SemverFai.validateVersion version = Ok ()

let case009 testInput =
  let (major, minor, patch) = testInput
  let testActual = machineIntegers major minor patch
  Expect.isTrue "property: machineIntegers major minor patch" testActual

let stableComparisons low high word =
  let low = Int.and low 15
  let high = Int.and high 15
  let major = Int.and word 15
  let minor = Int.and (Int.shiftRightLogical word 4) 15
  let patch = Int.and (Int.shiftRightLogical word 8) 15
  let source = ">=" ++ Int.toString low ++ ".2.3, <" ++ Int.toString high ++ ".4.5"
  match (SemverRange.parse source, Semver.fromInts major minor patch) with
  | (Ok range, Ok version) ->
    SemverRange.matches range version = ((major, minor, patch) >= (low, 2, 3) && (major, minor, patch) < (high, 4, 5))
  | _ -> false

let case010 testInput =
  let (low, high, word) = testInput
  let testActual = stableComparisons low high word
  Expect.isTrue "property: stableComparisons low high word" testActual

let canonicalPreserves low high =
  let low = Int.and low 15
  let high = Int.and high 15
  let first = ">=" ++ Int.toString low ++ ".0.0"
  let second = "<" ++ Int.toString high ++ ".0.0"
  SemverRange.parse (first ++ ", " ++ second ++ " || *") = SemverRange.parse ("* || " ++ second ++ ", " ++ first ++ ", " ++ first)

let case011 testInput =
  let (low, high) = testInput
  let testActual = canonicalPreserves low high
  Expect.isTrue "property: canonicalPreserves low high" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "SemverProperties" [
  Test.property "property: roundTrip values" (Test.list Test.int) case001,
  Test.property "property: antisymmetric first second" (Test.tuple2 (Test.list Test.int) (Test.list Test.int)) case002,
  Test.property "property: transitive first second third" (Test.tuple3 (Test.list Test.int) (Test.list Test.int) (Test.list Test.int)) case003,
  Test.property "property: bumps values" (Test.list Test.int) case004,
  Test.property "property: metadata values stamp" (Test.tuple2 (Test.list Test.int) Test.int) case005,
  Test.property "property: total text" Test.string case006,
  Test.property "property: rangeTotal text" Test.string case007,
  Test.property "property: matching values" (Test.list Test.int) case008,
  Test.property "property: machineIntegers major minor patch" (Test.tuple3 Test.int Test.int Test.int) case009,
  Test.property "property: stableComparisons low high word" (Test.tuple3 Test.int Test.int Test.int) case010,
  Test.property "property: canonicalPreserves low high" (Test.tuple2 Test.int Test.int) case011
]
