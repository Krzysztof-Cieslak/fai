module SemverFaiSpec

example: SemverFai.parseVersion "18446744073709551615.18446744073709551615.18446744073709551615" |> Result.isOk
example: SemverFai.parseVersion "18446744073709551616.0.0" |> Result.isErr
example: Semver.parse "18446744073709551616.0.0" |> Result.isOk
example: SemverFai.parseVersion "1.2.3+build" |> Result.isErr
example: SemverFai.parseVersion "v1.2.3" |> Result.isErr
example: SemverFai.parseVersion "1.2.3-999999999999999999999999999999999999" |> Result.isOk
example: SemverFai.parseRequirement "^18446744073709551615.0.0" |> Result.isOk
example: SemverFai.parseRequirement "^18446744073709551616.0.0" |> Result.isErr
example: SemverRange.parse "^18446744073709551616.0.0" |> Result.isOk
example: SemverFai.parseRequirement "1.2" |> Result.isErr
example: SemverFai.parseRequirement "1.2.3+build" |> Result.isErr
example: SemverFai.parseRequirement "*" |> Result.isOk
example: (match SemverFai.parseVersion "1.18446744073709551616.0" with
| Err error ->
  error.kind = Semver.OutOfRange && error.offset = Some 2 && error.component = Some "minor"
| _ -> false)
example: (match SemverFai.parseVersion "1.2.18446744073709551616" with
| Err error ->
  error.kind = Semver.OutOfRange && error.offset = Some 4 && error.component = Some "patch"
| _ -> false)
example: (match SemverFai.parseVersion "1.2.3-alpha+build" with
| Err error ->
  error.kind = Semver.BuildMetadataNotAllowed && error.offset = Some 11 && error.component = Some "build"
| _ -> false)
example: (match SemverFai.parseRequirement ">=2.0.0 || ^0.18446744073709551616.0" with
| Err error ->
  error.kind = Semver.OutOfRange && error.offset = Some 14 && error.component = Some "minor"
| _ -> false)
example: (match Semver.parse "18446744073709551615.0.0" with
| Err _ -> false
| Ok version ->
  SemverFai.validateVersion version = Ok () && Result.isErr (SemverFai.validateVersion (Semver.bumpMajor version)))
example: (match SemverRange.parse "^0.18446744073709551616.0" with
| Err _ -> false
| Ok range ->
  (match SemverFai.validateRequirement range with
  | Err error -> error.offset = None && error.component = Some "minor"
  | _ -> false))
example: (match Semver.parse "1.2.3+build" with
| Err _ -> false
| Ok version ->
  (match SemverFai.validateVersion version with
  | Err error -> error.offset = None && error.kind = Semver.BuildMetadataNotAllowed
  | _ -> false))
