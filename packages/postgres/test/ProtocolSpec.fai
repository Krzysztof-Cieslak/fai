module ProtocolSpec

import sql.Sql

let case001 _ =
  let testActual = PgWire.signed 2 (PgWire.int16 (-32768))
  let testExpected = Ok (-32768)
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case002 _ =
  let testActual = PgWire.signed 4 (PgWire.int32 (-2147483648))
  let testExpected = Ok (-2147483648)
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case003 testInput =
  let n = testInput
  let testActual = PgWire.signed 8 (PgWire.int64 n)
  let testExpected = Ok n
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case004 _ =
  let testActual = Result.isErr (PgWire.signed 4 (Bytes.fromList [1]))
  Expect.isTrue "Result.isErr (PgWire.signed 4 (Bytes.fromList [1]))" testActual

let case005 _ =
  let testActual = PgWire.frame 100 (Bytes.fromList [90, 0, 0]) = Ok None
  Expect.isTrue "PgWire.frame 100 (Bytes.fromList [90, 0, 0]) = Ok None" testActual

let case006 _ =
  let testActual = Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 0, 0, 0, 3]))
  Expect.isTrue "Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 0, 0, 0, 3]))" testActual

let case007 _ =
  let testActual = Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 255, 255, 255, 255]))
  Expect.isTrue "Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 255, 255, 255, 255]))" testActual

let case008 _ =
  let testActual =
    PgWire.frame 100 (PgWire.packet 90 (Bytes.fromString "I")) = Ok (Some ({
      body = Bytes.fromString "I",
      tag = 90
    }, Bytes.empty))
  Expect.isTrue "PgWire.frame 100 (PgWire.packet 90 (Bytes.fromString \"I\")) = Ok (Some ({ body = Bytes.fromString \"I\", tag = 90 }, Bytes.empty))" testActual

let case009 _ =
  let testActual = PgWire.string (PgWire.zero "é😀") 0
  let testExpected = Ok ("é😀", 7)
  Expect.equal ((Test.result (Test.tuple2 Test.string Test.int) Test.string)).show testExpected testActual

let case010 _ =
  let testActual = Result.isErr (PgWire.string (Bytes.fromString "no terminator") 0)
  Expect.isTrue "Result.isErr (PgWire.string (Bytes.fromString \"no terminator\") 0)" testActual

let case011 _ =
  let testActual =
    PgWire.row (PgWire.join [
      PgWire.int16 2,
      PgWire.int32 (-1),
      PgWire.int32 0
    ]) = Ok [| None, Some Bytes.empty |]
  Expect.isTrue "PgWire.row (PgWire.join [ PgWire.int16 2, PgWire.int32 (-1), PgWire.int32 0 ]) = Ok [| None, Some Bytes.empty |]" testActual

let case012 _ =
  let testActual =
    Result.isErr (PgWire.row (PgWire.join [PgWire.int16 1, PgWire.int32 5, Bytes.fromString "abc"]))
  Expect.isTrue "Result.isErr (PgWire.row (PgWire.join [ PgWire.int16 1, PgWire.int32 5, Bytes.fromString \"abc\" ]))" testActual

let case013 _ =
  let testActual = PgWire.decimalInt "9223372036854775807"
  let testExpected = Ok 9223372036854775807
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case014 _ =
  let testActual = PgWire.decimalInt "-9223372036854775808"
  let testExpected = Ok (-9223372036854775808)
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case015 _ =
  let testActual = Result.isErr (PgWire.decimalInt "9223372036854775808")
  Expect.isTrue "Result.isErr (PgWire.decimalInt \"9223372036854775808\")" testActual

let case016 _ =
  let testActual = PgWire.affected (PgWire.zero "INSERT 0 12")
  let testExpected = Ok 12
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case017 _ =
  let testActual = PgTypes.decode 16 1 (Bytes.fromList [1]) = Ok (Sql.Boolean true)
  Expect.isTrue "PgTypes.decode 16 1 (Bytes.fromList [1]) = Ok (Sql.Boolean true)" testActual

let case018 _ =
  let testActual = PgTypes.decode 700 1 (PgWire.int32 1065353216) = Ok (Sql.Real 1.0)
  Expect.isTrue "PgTypes.decode 700 1 (PgWire.int32 1065353216) = Ok (Sql.Real 1.0)" testActual

let case019 _ =
  let testActual = PgTypes.decode 700 1 (PgWire.int32 (-2147483648)) = Ok (Sql.Real (-0.0))
  Expect.isTrue "PgTypes.decode 700 1 (PgWire.int32 (-2147483648)) = Ok (Sql.Real (-0.0))" testActual

let case020 _ =
  let testActual =
    PgTypes.decode 1082 1 (PgWire.int32 0) = Ok (Sql.Date (Sql.Finite (LocalDate.fromEpochDay 10957)))
  Expect.isTrue "PgTypes.decode 1082 1 (PgWire.int32 0) = Ok (Sql.Date (Sql.Finite (LocalDate.fromEpochDay 10957)))" testActual

let case021 _ =
  let testActual = PgTypes.decode 1083 1 (PgWire.int64 86400000000) = Ok (Sql.Time Sql.EndOfDay)
  Expect.isTrue "PgTypes.decode 1083 1 (PgWire.int64 86400000000) = Ok (Sql.Time Sql.EndOfDay)" testActual

let case022 _ =
  let testActual =
    PgTypes.decode 1184 1 (PgWire.int64 9223372036854775807) = Ok (Sql.TimestampTz Sql.PositiveInfinity)
  Expect.isTrue "PgTypes.decode 1184 1 (PgWire.int64 9223372036854775807) = Ok (Sql.TimestampTz Sql.PositiveInfinity)" testActual

let case023 _ =
  let testActual = Result.isErr (PgTypes.parameter 21 (Sql.Integer 32768))
  Expect.isTrue "Result.isErr (PgTypes.parameter 21 (Sql.Integer 32768))" testActual

let case024 _ =
  let testActual =
    PgTypes.parameter 20 (Sql.Integer (-9223372036854775808)) = Ok (Some (Bytes.fromString "-9223372036854775808"))
  Expect.isTrue "PgTypes.parameter 20 (Sql.Integer (-9223372036854775808)) = Ok (Some (Bytes.fromString \"-9223372036854775808\"))" testActual

let case025 _ =
  let testActual =
    Result.isErr (PgTypes.parameter 1083 (Sql.Time (Sql.TimeOfDay (LocalTime.fromNanoOfDay 1))))
  Expect.isTrue "Result.isErr (PgTypes.parameter 1083 (Sql.Time (Sql.TimeOfDay (LocalTime.fromNanoOfDay 1))))" testActual

let case026 _ =
  let testActual = PgAuth.base64Decode "AQID" = Ok (Bytes.fromList [1, 2, 3])
  Expect.isTrue "PgAuth.base64Decode \"AQID\" = Ok (Bytes.fromList [1, 2, 3])" testActual

let case027 _ =
  let testActual = Result.isErr (PgAuth.base64Decode "AR==")
  Expect.isTrue "Result.isErr (PgAuth.base64Decode \"AR==\")" testActual

let case028 testInput =
  let text = testInput
  let testActual =
    PgAuth.base64Decode (Http.base64Encode (Bytes.fromString text)) = Ok (Bytes.fromString text)
  Expect.isTrue "property: PgAuth.base64Decode (Http.base64Encode (Bytes.fromString text)) = Ok (Bytes.fromString text)" testActual

let first = PgAuth.first "user" "rOprNGfwEbeRWgbNEkqO" "n,," Bytes.empty

let challenge =
  "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"

let proof = PgAuth.respond 10000 "pencil" first challenge

let case029 _ =
  let testActual = Result.map (fun final -> final.message) proof
  let testExpected =
    Ok "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
  Expect.equal ((Test.result Test.string Test.string)).show testExpected testActual

let case030 _ =
  let testActual =
    (match proof with
    | Err _ -> false
    | Ok final -> PgAuth.verify final "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=" = Ok ())
  Expect.isTrue "(match proof with | Err _ -> false | Ok final -> PgAuth.verify final \"v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=\" = Ok ())" testActual

let case031 _ =
  let testActual = Result.isErr (PgAuth.respond 1 "pencil" first challenge)
  Expect.isTrue "Result.isErr (PgAuth.respond 1 \"pencil\" first challenge)" testActual

let case032 _ =
  let testActual = Result.isErr (PgAuth.respond 10000 "pencil" first "r=wrong,s=YQ==,i=10")
  Expect.isTrue "Result.isErr (PgAuth.respond 10000 \"pencil\" first \"r=wrong,s=YQ==,i=10\")" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "ProtocolSpec" [
  Test.test "PgWire.signed 2 (PgWire.int16 (-32768)) = Ok (-32768)" case001,
  Test.test "PgWire.signed 4 (PgWire.int32 (-2147483648)) = Ok (-2147483648)" case002,
  Test.property "property: PgWire.signed 8 (PgWire.int64 n) = Ok n" Test.int case003,
  Test.test "Result.isErr (PgWire.signed 4 (Bytes.fromList [1]))" case004,
  Test.test "PgWire.frame 100 (Bytes.fromList [90, 0, 0]) = Ok None" case005,
  Test.test "Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 0, 0, 0, 3]))" case006,
  Test.test "Result.isErr (PgWire.frame 100 (Bytes.fromList [90, 255, 255, 255, 255]))" case007,
  Test.test "PgWire.frame 100 (PgWire.packet 90 (Bytes.fromString \"I\")) = Ok (Some ({ body = Bytes.fromString \"I\", tag = 90 }, Bytes.empty))" case008,
  Test.test "PgWire.string (PgWire.zero \"é😀\") 0 = Ok (\"é😀\", 7)" case009,
  Test.test "Result.isErr (PgWire.string (Bytes.fromString \"no terminator\") 0)" case010,
  Test.test "PgWire.row (PgWire.join [ PgWire.int16 2, PgWire.int32 (-1), PgWire.int32 0 ]) = Ok [| None, Some Bytes.empty |]" case011,
  Test.test "Result.isErr (PgWire.row (PgWire.join [ PgWire.int16 1, PgWire.int32 5, Bytes.fromString \"abc\" ]))" case012,
  Test.test "PgWire.decimalInt \"9223372036854775807\" = Ok 9223372036854775807" case013,
  Test.test "PgWire.decimalInt \"-9223372036854775808\" = Ok (-9223372036854775808)" case014,
  Test.test "Result.isErr (PgWire.decimalInt \"9223372036854775808\")" case015,
  Test.test "PgWire.affected (PgWire.zero \"INSERT 0 12\") = Ok 12" case016,
  Test.test "PgTypes.decode 16 1 (Bytes.fromList [1]) = Ok (Sql.Boolean true)" case017,
  Test.test "PgTypes.decode 700 1 (PgWire.int32 1065353216) = Ok (Sql.Real 1.0)" case018,
  Test.test "PgTypes.decode 700 1 (PgWire.int32 (-2147483648)) = Ok (Sql.Real (-0.0))" case019,
  Test.test "PgTypes.decode 1082 1 (PgWire.int32 0) = Ok (Sql.Date (Sql.Finite (LocalDate.fromEpochDay 10957)))" case020,
  Test.test "PgTypes.decode 1083 1 (PgWire.int64 86400000000) = Ok (Sql.Time Sql.EndOfDay)" case021,
  Test.test "PgTypes.decode 1184 1 (PgWire.int64 9223372036854775807) = Ok (Sql.TimestampTz Sql.PositiveInfinity)" case022,
  Test.test "Result.isErr (PgTypes.parameter 21 (Sql.Integer 32768))" case023,
  Test.test "PgTypes.parameter 20 (Sql.Integer (-9223372036854775808)) = Ok (Some (Bytes.fromString \"-9223372036854775808\"))" case024,
  Test.test "Result.isErr (PgTypes.parameter 1083 (Sql.Time (Sql.TimeOfDay (LocalTime.fromNanoOfDay 1))))" case025,
  Test.test "PgAuth.base64Decode \"AQID\" = Ok (Bytes.fromList [1, 2, 3])" case026,
  Test.test "Result.isErr (PgAuth.base64Decode \"AR==\")" case027,
  Test.property "property: PgAuth.base64Decode (Http.base64Encode (Bytes.fromString text)) = Ok (Bytes.fromString text)" Test.string case028,
  Test.test "Result.map (fun final -> final.message) proof = Ok \"c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=\"" case029,
  Test.test "(match proof with | Err _ -> false | Ok final -> PgAuth.verify final \"v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=\" = Ok ())" case030,
  Test.test "Result.isErr (PgAuth.respond 1 \"pencil\" first challenge)" case031,
  Test.test "Result.isErr (PgAuth.respond 10000 \"pencil\" first \"r=wrong,s=YQ==,i=10\")" case032
]
