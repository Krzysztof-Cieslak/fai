module PgUuidSpec

import sql.Sql
import uuid.Uuid

let text = "01234567-89ab-cdef-0123-456789abcdef"

let bytes = Bytes.fromList [1, 35, 69, 103, 137, 171, 205, 239, 1, 35, 69, 103, 137, 171, 205, 239]

let parsed =
  match Uuid.parse text with
  | Ok uuid -> PgTypes.decode 2950 1 bytes = Ok (Sql.Uuid uuid)
  | Err _ -> false

let case001 _ =
  let testActual = parsed
  Expect.isTrue "parsed" testActual

let case002 _ =
  let testActual = PgTypes.decode 2950 1 (Uuid.toBytes Uuid.nil) = Ok (Sql.Uuid Uuid.nil)
  Expect.isTrue "PgTypes.decode 2950 1 (Uuid.toBytes Uuid.nil) = Ok (Sql.Uuid Uuid.nil)" testActual

let case003 _ =
  let testActual = PgTypes.decode 2950 1 (Uuid.toBytes Uuid.max) = Ok (Sql.Uuid Uuid.max)
  Expect.isTrue "PgTypes.decode 2950 1 (Uuid.toBytes Uuid.max) = Ok (Sql.Uuid Uuid.max)" testActual

let case004 _ =
  let testActual = PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 15)) = Err "invalid UUID"
  Expect.isTrue "PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 15)) = Err \"invalid UUID\"" testActual

let case005 _ =
  let testActual = PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 17)) = Err "invalid UUID"
  Expect.isTrue "PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 17)) = Err \"invalid UUID\"" testActual

let case006 _ =
  let testActual =
    PgTypes.parameter 2950 (Sql.Uuid Uuid.max) = Ok (Some (Bytes.fromString "ffffffff-ffff-ffff-ffff-ffffffffffff"))
  Expect.isTrue "PgTypes.parameter 2950 (Sql.Uuid Uuid.max) = Ok (Some (Bytes.fromString \"ffffffff-ffff-ffff-ffff-ffffffffffff\"))" testActual

let case007 _ =
  let testActual = PgTypes.parameter 25 (Sql.Uuid Uuid.nil) = Err "UUID parameter type mismatch"
  Expect.isTrue "PgTypes.parameter 25 (Sql.Uuid Uuid.nil) = Err \"UUID parameter type mismatch\"" testActual

let v7 =
  match Uuid.v7FromRandom 1645557742000 (Bytes.fromList [
    12,
    195,
    24,
    196,
    220,
    12,
    12,
    7,
    57,
    143
  ]) with
  | Err _ -> false
  | Ok uuid ->
    PgTypes.decode 2950 1 (Uuid.toBytes uuid) = Ok (Sql.Uuid uuid) && PgTypes.parameter 2950 (Sql.Uuid uuid) = Ok (Some (Bytes.fromString "017f22e2-79b0-7cc3-98c4-dc0c0c07398f"))

let case008 _ =
  let testActual = v7
  Expect.isTrue "v7" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "PgUuidSpec" [
  Test.test "parsed" case001,
  Test.test "PgTypes.decode 2950 1 (Uuid.toBytes Uuid.nil) = Ok (Sql.Uuid Uuid.nil)" case002,
  Test.test "PgTypes.decode 2950 1 (Uuid.toBytes Uuid.max) = Ok (Sql.Uuid Uuid.max)" case003,
  Test.test "PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 15)) = Err \"invalid UUID\"" case004,
  Test.test "PgTypes.decode 2950 1 (Bytes.fromList (List.range 0 17)) = Err \"invalid UUID\"" case005,
  Test.test "PgTypes.parameter 2950 (Sql.Uuid Uuid.max) = Ok (Some (Bytes.fromString \"ffffffff-ffff-ffff-ffff-ffffffffffff\"))" case006,
  Test.test "PgTypes.parameter 25 (Sql.Uuid Uuid.nil) = Err \"UUID parameter type mismatch\"" case007,
  Test.test "v7" case008
]
