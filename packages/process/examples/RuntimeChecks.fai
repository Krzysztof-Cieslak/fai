module ProcessRuntimeChecks

public type R = {
  clock : Clock,
  concurrency : Concurrency,
  console : Console,
  env : Env,
  process : ProcessHost.Process
}

let runtime = {
  clock = stdClock,
  concurrency = stdConcurrency,
  console = stdConsole,
  env = stdEnv,
  process = ProcessHost.native
}

let settings = { Process.defaults with
  bufferBytes = 4096,
  chunkBytes = 1024,
  graceMs = 0,
  timeoutMs = Some 10000
}

let command python fixture mode args = Process.command python (fixture :: mode :: args)

let good output = Process.expectSuccess output |> Result.isOk

let outputIs bytes result =
  match result with
  | Ok output -> good output && output.stdout = bytes
  | Err _ -> false

report : Console -> String -> Bool -> Bool / { Console }
let report console name passed =
  let printed = console.writeLine ((if passed then "ok " else "FAIL ") ++ name)
  passed

let stopOutput chunk = Ok Process.Stop

let failOutput chunk = Err (Process.error Process.ConsumerFailure "consumer failed")

let escaped child = Ok child

writeInput : Bytes -> Process.Child -> Result Unit Process.Error / { ProcessHost.Process }
let writeInput bytes child = Process.write child bytes

let continueOutput chunk = Ok Process.Continue

checks : R -> String -> String -> Bool / { Concurrency, Console, ProcessHost.Process }
let checks env python fixture =
  let binary = Bytes.fromList (List.range 0 256)
  let echoed =
    Process.run env settings (command python fixture "echo" [] |> Process.stdinBytes binary)
  let a = report env.console "binary echo" (outputIs binary echoed)
  let args = ["", "a b", "a\"b", "trailing\\", "hé😀"]
  let b =
    report env.console "argv" (outputIs (Bytes.fromString (String.join "\n" args)) (Process.run env settings (command python fixture "args" args)))
  let c =
    report env.console "environment" (outputIs (Bytes.fromString "value") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value")))
  let d =
    report env.console "unset environment" (outputIs (Bytes.fromString "<absent>") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value" |> Process.unsetEnvironment "FAI_PROCESS_VALUE")))
  let exit = Process.run env settings (command python fixture "exit" ["37"])
  let e =
    report env.console "exit status" (match exit with
    | Ok output -> output.exits = [Some (ProcessHost.Exited 37)]
    | Err _ -> false)
  let input = Bytes.fromList (List.map (fun _ -> 105) (List.range 0 131072))
  let exchange =
    Process.run env settings (command python fixture "flood" [] |> Process.stdinBytes input)
  let f =
    report env.console "full duplex" (match exchange with
    | Ok output ->
      good output && Bytes.length output.stdout = 131072 && List.map Bytes.length output.stderr = [
        131072
      ]
    | Err _ -> false)
  let timeout =
    Process.run env { settings with timeoutMs = Some 100 } (command python fixture "hold" [])
  let g =
    report env.console "deadline" (match timeout with
    | Err failure -> failure.kind = Process.DeadlineExceeded
    | Ok _ -> false)
  let limited =
    Process.run env { settings with maxCaptureBytes = 16 } (command python fixture "flood" [])
  let h =
    report env.console "capture limit" (match limited with
    | Err failure -> failure.kind = Process.CaptureLimitExceeded && failure.partial.truncated
    | Ok _ -> false)
  let stopped = Process.withOutput env settings (command python fixture "hold" []) stopOutput
  let i =
    report env.console "consumer stop" (match stopped with
    | Ok output -> output.stopped
    | Err _ -> false)
  let failed = Process.withOutput env settings (command python fixture "hold" []) failOutput
  let j =
    report env.console "consumer error" (match failed with
    | Err failure -> failure.message = "consumer failed"
    | Ok _ -> false)
  let retained = Process.withChild env settings (command python fixture "hold" []) escaped
  let k =
    report env.console "expired alias" (match retained with
    | Err _ -> false
    | Ok result ->
      (match Process.next result.value with
      | Err failure -> failure.kind = Process.Closed
      | Ok _ -> false))
  let streaming =
    Process.communicate env settings (command python fixture "echo" []) (writeInput binary) continueOutput
  let l = report env.console "streaming input" (outputIs binary streaming)
  a && b && c && d && e && f && g && h && i && j && k && l

public main : R -> Unit / { Concurrency, Console, Env, ProcessHost.Process }
let main env =
  match env.env.args () with
  | [python, fixture] ->
    env.console.writeLine (if checks env python fixture then
      "process checks passed"
    else
      "process checks FAILED")
  | _ -> env.console.writeLine "expected Python executable and fixture path"
