module ProcessRuntimeChecks

public type R = {
  clock : Clock,
  concurrency : Concurrency,
  console : Console,
  env : Env,
  process : ProcessHost.Process
}

let runtime = {
  clock = stdClock,
  concurrency = stdConcurrency,
  console = stdConsole,
  env = stdEnv,
  process = ProcessHost.native
}

let settings = { Process.defaults with
  bufferBytes = 4096,
  chunkBytes = 1024,
  graceMs = 0,
  timeoutMs = Some 10000
}

let command python fixture mode args = Process.command python (fixture :: mode :: args)

let good output = Process.expectSuccess output |> Result.isOk

let outputIs bytes result =
  match result with
  | Ok output -> good output && output.stdout = bytes
  | Err _ -> false

report : Console -> String -> Bool -> Bool / { Console }
let report console name passed =
  let printed = console.writeLine ((if passed then "ok " else "FAIL ") ++ name)
  passed

let stopOutput chunk = Ok Process.Stop

let failOutput chunk = Err (Process.error Process.ConsumerFailure "consumer failed")

let escaped child = Ok child

writeInput : Bytes -> Process.Child -> Result Unit Process.Error / { ProcessHost.Process }
let writeInput bytes child = Process.write child bytes

let continueOutput chunk = Ok Process.Continue

waitInput : Concurrency -> Channel Unit -> Process.Child -> Result Unit Process.Error / { Concurrency }
let waitInput concurrency gate child =
  let waited = concurrency.recv gate
  Ok ()

notifyOutput : Concurrency -> Channel Unit -> Process.Chunk -> Result Process.Control Process.Error / { Concurrency }
let notifyOutput concurrency ready chunk =
  let sent = concurrency.send ready ()
  Ok Process.Continue

cancelledWork : R -> String -> String -> Channel Unit -> Unit -> Result Process.Output Process.Error / { Concurrency, ProcessHost.Process }
let cancelledWork env python fixture ready unit =
  Process.withOutput env settings (command python fixture "hold" []) (notifyOutput env.concurrency ready)

cancelInScope : R -> String -> String -> Nursery -> Bool / { Concurrency, ProcessHost.Process }
let cancelInScope env python fixture nursery =
  let ready = env.concurrency.channel 1
  let task = env.concurrency.spawn nursery (cancelledWork env python fixture ready)
  let started = env.concurrency.recv ready
  let cancelled = env.concurrency.cancel task
  match env.concurrency.await task with
  | Err failure -> failure.kind = Process.Cancelled
  | Ok _ -> false

slowOutput : Clock -> Process.Chunk -> Result Process.Control Process.Error / { Clock }
let slowOutput clock chunk =
  let waited = clock.sleep 600
  Ok Process.Continue

let showBytes bytes = String.join "," (List.map Int.toString (Bytes.toList bytes))

let expectOutput expected result =
  Expect.ok Process.errorToString (fun output -> Expect.all [
    Expect.isTrue "child exited successfully" (good output),
    Expect.equal showBytes expected output.stdout
  ]) result

let scenarioNames = [
  "binary echo",
  "argv",
  "environment",
  "unset environment",
  "exit status",
  "full duplex",
  "deadline",
  "capture limit",
  "consumer stop",
  "consumer error",
  "expired alias",
  "streaming input",
  "pipeline",
  "partial pipeline startup",
  "early stop cancels producer",
  "task cancellation",
  "descendant pipe cleanup",
  "deadline includes consumer",
  "discard output",
  "discard input",
  "inherit output"
]

scenario : R -> String -> String -> String -> Test.Check / { Clock, Concurrency, ProcessHost.Process }
let scenario env python fixture name =
  let binary = Bytes.fromList (List.range 0 256)
  match name with
  | "binary echo" ->
    expectOutput binary (Process.run env settings (command python fixture "echo" [] |> Process.stdinBytes binary))
  | "argv" ->
    let args = ["", "a b", "a\"b", "trailing\\", "hé😀"]
    expectOutput (Bytes.fromString (String.join "\n" args)) (Process.run env settings (command python fixture "args" args))
  | "environment" ->
    expectOutput (Bytes.fromString "value") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value"))
  | "unset environment" ->
    expectOutput (Bytes.fromString "<absent>") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value" |> Process.unsetEnvironment "FAI_PROCESS_VALUE"))
  | "exit status" ->
    let result = Process.run env settings (command python fixture "exit" ["37"])
    Expect.ok Process.errorToString (fun output ->
      Expect.isTrue "exit code is retained" (output.exits = [Some (ProcessHost.Exited 37)])) result
  | "full duplex" ->
    let input = Bytes.fromList (List.map (fun _ -> 105) (List.range 0 131072))
    let result =
      Process.run env settings (command python fixture "flood" [] |> Process.stdinBytes input)
    Expect.ok Process.errorToString (fun output -> Expect.all [
      Expect.isTrue "child exited successfully" (good output),
      Expect.equal Int.toString 131072 (Bytes.length output.stdout),
      Expect.isTrue "stderr was drained concurrently" (List.map Bytes.length output.stderr = [
        131072
      ])
    ]) result
  | "deadline" ->
    let result =
      Process.run env { settings with timeoutMs = Some 100 } (command python fixture "hold" [])
    Expect.isTrue "operation deadline terminates the child" (match result with
    | Err failure -> failure.kind = Process.DeadlineExceeded
    | Ok _ -> false)
  | "capture limit" ->
    let result =
      Process.run env { settings with maxCaptureBytes = 16 } (command python fixture "flood" [])
    Expect.isTrue "capture limit retains truncated output" (match result with
    | Err failure -> failure.kind = Process.CaptureLimitExceeded && failure.partial.truncated
    | Ok _ -> false)
  | "consumer stop" ->
    Expect.ok Process.errorToString (fun output ->
      Expect.isTrue "consumer stopped the child" output.stopped) (Process.withOutput env settings (command python fixture "hold" []) stopOutput)
  | "consumer error" ->
    let result = Process.withOutput env settings (command python fixture "hold" []) failOutput
    Expect.isTrue "consumer failure is retained" (match result with
    | Err failure -> failure.message = "consumer failed"
    | Ok _ -> false)
  | "expired alias" ->
    let result = Process.withChild env settings (command python fixture "hold" []) escaped
    match result with
    | Err error -> Test.error (Process.errorToString error)
    | Ok result ->
      Expect.isTrue "retained child is closed" (match Process.next result.value with
      | Err failure -> failure.kind = Process.Closed
      | Ok _ -> false)
  | "streaming input" ->
    expectOutput binary (Process.communicate env settings (command python fixture "echo" []) (writeInput binary) continueOutput)
  | "pipeline" ->
    let pipeline = Process.pipeline [
      command python fixture "echo" [] |> Process.stdinText "pipeline",
      command python fixture "upper" [],
      command python fixture "count" []
    ]
    let result = Process.runPipeline env settings pipeline
    Expect.andThen (fun _ ->
      Expect.ok Process.errorToString (fun output ->
        Expect.equal Int.toString 3 (List.length output.exits)) result) (expectOutput (Bytes.fromString "8") result)
  | "partial pipeline startup" ->
    let result =
      Process.runPipeline env settings (Process.pipeline [
        Process.command "/fai-does-not-exist/program" [],
        command python fixture "hold" []
      ])
    Expect.isTrue "partial startup fails without leaving a child" (match result with
    | Err failure -> failure.kind = Process.SpawnFailure
    | Ok _ -> false)
  | "early stop cancels producer" ->
    let gate = env.concurrency.channel 1
    Expect.ok Process.errorToString (fun output ->
      Expect.isTrue "producer was cancelled" output.stopped) (Process.communicate env settings (command python fixture "hold" []) (waitInput env.concurrency gate) stopOutput)
  | "task cancellation" ->
    Expect.isTrue "task cancellation terminates the session" (env.concurrency.scope (cancelInScope env python fixture))
  | "descendant pipe cleanup" ->
    let result =
      Process.run env { settings with
        drainTimeoutMs = Some 100
      } (command python fixture "descendant" [])
    Expect.isTrue "descendant pipes are bounded" (match result with
    | Err failure -> failure.kind = Process.DrainDeadlineExceeded
    | Ok _ -> false)
  | "deadline includes consumer" ->
    let result =
      Process.withOutput env { settings with
        timeoutMs = Some 500
      } (command python fixture "args" ["ready"]) (slowOutput env.clock)
    Expect.isTrue "consumer time counts toward the deadline" (match result with
    | Err failure -> failure.kind = Process.DeadlineExceeded
    | Ok _ -> false)
  | "discard output" ->
    expectOutput Bytes.empty (Process.run env settings (command python fixture "args" [
      "discarded"
    ] |> Process.stdout Process.Discard))
  | "discard input" ->
    expectOutput Bytes.empty (Process.run env settings (command python fixture "echo" [] |> Process.stdin Process.Discard))
  | "inherit output" ->
    expectOutput Bytes.empty (Process.run env settings (command python fixture "args" [
      "inherited-marker\n"
    ] |> Process.stdout Process.Inherit))
  | _ -> Test.error ("unknown process scenario: " ++ name)

checkedScenario : R -> String -> String -> String -> Bool / { Clock, Concurrency, Console, ProcessHost.Process }
let checkedScenario env python fixture name =
  report env.console name (scenario env python fixture name = Test.pass)

checks : R -> String -> String -> Bool / { Clock, Concurrency, Console, ProcessHost.Process }
let checks env python fixture =
  List.all identity (List.map (checkedScenario env python fixture) scenarioNames)

namedScenario : String -> Test.Context -> Test.Check / { Clock, Concurrency, Env, ProcessHost.Process }
let namedScenario name ctx =
  match (ctx.runtime.env.get "FAI_TEST_PYTHON", ctx.runtime.env.get "FAI_TEST_PROCESS_FIXTURE") with
  | (Some python, Some fixture) ->
    let env = {
      clock = ctx.runtime.clock,
      concurrency = ctx.runtime.concurrency,
      console = ctx.runtime.console,
      env = ctx.runtime.env,
      process = ProcessHost.native
    }
    scenario env python fixture name
  | _ -> Test.error "process integration requires FAI_TEST_PYTHON and FAI_TEST_PROCESS_FIXTURE"

tests : Test.Suite Test.Context { Clock, Concurrency, Env, ProcessHost.Process }
let tests =
  Test.describe "native process sessions" (List.map (fun name ->
    Test.test name (namedScenario name)) scenarioNames)

public main : R -> Unit / { Clock, Concurrency, Console, Env, ProcessHost.Process }
let main env =
  match env.env.args () with
  | [python, fixture, "inherit-stdin"] ->
    let result =
      Process.run env settings (command python fixture "echo" [] |> Process.stdin Process.Inherit)
    env.console.writeLine (if outputIs (Bytes.fromList (List.range 0 256)) result then
      "inherited input ok"
    else
      "inherited input FAILED")
  | [python, fixture] ->
    env.console.writeLine (if checks env python fixture then
      "process checks passed"
    else
      "process checks FAILED")
  | _ -> env.console.writeLine "expected Python executable and fixture path"
