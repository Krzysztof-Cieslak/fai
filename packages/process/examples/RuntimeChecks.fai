module ProcessRuntimeChecks

public type R = {
  clock : Clock,
  concurrency : Concurrency,
  console : Console,
  env : Env,
  process : ProcessHost.Process
}

let runtime = {
  clock = stdClock,
  concurrency = stdConcurrency,
  console = stdConsole,
  env = stdEnv,
  process = ProcessHost.native
}

let settings = { Process.defaults with
  bufferBytes = 4096,
  chunkBytes = 1024,
  graceMs = 0,
  timeoutMs = Some 10000
}

let command python fixture mode args = Process.command python (fixture :: mode :: args)

let good output = Process.expectSuccess output |> Result.isOk

describeNative : ProcessHost.Error -> String
let describeNative native =
  Int.toString native.kind ++ ":" ++ Int.toString native.code ++ ":" ++ native.message

describeExit : Option ProcessHost.Exit -> String
let describeExit exit =
  match exit with
  | None -> "pending"
  | Some (ProcessHost.Exited code) -> "exit " ++ Int.toString code
  | Some (ProcessHost.Signaled signal core) -> "signal " ++ Int.toString signal

debugResult : Console -> Result Process.Output Process.Error -> Unit / { Console }
let debugResult console result =
  match result with
  | Ok output ->
    console.writeLine ("process result: " ++ String.join "," (List.map describeExit output.exits) ++ " stdout=" ++ Option.withDefault "<binary>" (Bytes.toString output.stdout))
  | Err failure ->
    console.writeLine ("process error: " ++ failure.message ++ " native=" ++ (match failure.native with
    | None -> "none"
    | Some native ->
      describeNative native) ++ " cleanup=" ++ String.join "," (List.map describeNative failure.cleanup) ++ " exits=" ++ String.join "," (List.map describeExit failure.partial.exits))

let outputIs bytes result =
  match result with
  | Ok output -> good output && output.stdout = bytes
  | Err _ -> false

report : Console -> String -> Bool -> Bool / { Console }
let report console name passed =
  let printed = console.writeLine ((if passed then "ok " else "FAIL ") ++ name)
  passed

let stopOutput chunk = Ok Process.Stop

let failOutput chunk = Err (Process.error Process.ConsumerFailure "consumer failed")

let escaped child = Ok child

writeInput : Bytes -> Process.Child -> Result Unit Process.Error / { ProcessHost.Process }
let writeInput bytes child = Process.write child bytes

let continueOutput chunk = Ok Process.Continue

waitInput : Concurrency -> Channel Unit -> Process.Child -> Result Unit Process.Error / { Concurrency }
let waitInput concurrency gate child =
  let waited = concurrency.recv gate
  Ok ()

notifyOutput : Concurrency -> Channel Unit -> Process.Chunk -> Result Process.Control Process.Error / { Concurrency }
let notifyOutput concurrency ready chunk =
  let sent = concurrency.send ready ()
  Ok Process.Continue

cancelledWork : R -> String -> String -> Channel Unit -> Unit -> Result Process.Output Process.Error / { Concurrency, ProcessHost.Process }
let cancelledWork env python fixture ready unit =
  Process.withOutput env settings (command python fixture "hold" []) (notifyOutput env.concurrency ready)

cancelInScope : R -> String -> String -> Nursery -> Bool / { Concurrency, ProcessHost.Process }
let cancelInScope env python fixture nursery =
  let ready = env.concurrency.channel 1
  let task = env.concurrency.spawn nursery (cancelledWork env python fixture ready)
  let started = env.concurrency.recv ready
  let cancelled = env.concurrency.cancel task
  match env.concurrency.await task with
  | Err failure -> failure.kind = Process.Cancelled
  | Ok _ -> false

slowOutput : Clock -> Process.Chunk -> Result Process.Control Process.Error / { Clock }
let slowOutput clock chunk =
  let waited = clock.sleep 600
  Ok Process.Continue

checks : R -> String -> String -> Bool / { Clock, Concurrency, Console, ProcessHost.Process }
let checks env python fixture =
  let binary = Bytes.fromList (List.range 0 256)
  let echoed =
    Process.run env settings (command python fixture "echo" [] |> Process.stdinBytes binary)
  let debug = debugResult env.console echoed
  let a = report env.console "binary echo" (outputIs binary echoed)
  let args = ["", "a b", "a\"b", "trailing\\", "hé😀"]
  let b =
    report env.console "argv" (outputIs (Bytes.fromString (String.join "\n" args)) (Process.run env settings (command python fixture "args" args)))
  let c =
    report env.console "environment" (outputIs (Bytes.fromString "value") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value")))
  let d =
    report env.console "unset environment" (outputIs (Bytes.fromString "<absent>") (Process.run env settings (command python fixture "env" [] |> Process.setEnvironment "FAI_PROCESS_VALUE" "value" |> Process.unsetEnvironment "FAI_PROCESS_VALUE")))
  let exit = Process.run env settings (command python fixture "exit" ["37"])
  let e =
    report env.console "exit status" (match exit with
    | Ok output -> output.exits = [Some (ProcessHost.Exited 37)]
    | Err _ -> false)
  let input = Bytes.fromList (List.map (fun _ -> 105) (List.range 0 131072))
  let exchange =
    Process.run env settings (command python fixture "flood" [] |> Process.stdinBytes input)
  let f =
    report env.console "full duplex" (match exchange with
    | Ok output ->
      good output && Bytes.length output.stdout = 131072 && List.map Bytes.length output.stderr = [
        131072
      ]
    | Err _ -> false)
  let timeout =
    Process.run env { settings with timeoutMs = Some 100 } (command python fixture "hold" [])
  let g =
    report env.console "deadline" (match timeout with
    | Err failure -> failure.kind = Process.DeadlineExceeded
    | Ok _ -> false)
  let limited =
    Process.run env { settings with maxCaptureBytes = 16 } (command python fixture "flood" [])
  let h =
    report env.console "capture limit" (match limited with
    | Err failure -> failure.kind = Process.CaptureLimitExceeded && failure.partial.truncated
    | Ok _ -> false)
  let stopped = Process.withOutput env settings (command python fixture "hold" []) stopOutput
  let i =
    report env.console "consumer stop" (match stopped with
    | Ok output -> output.stopped
    | Err _ -> false)
  let failed = Process.withOutput env settings (command python fixture "hold" []) failOutput
  let j =
    report env.console "consumer error" (match failed with
    | Err failure -> failure.message = "consumer failed"
    | Ok _ -> false)
  let retained = Process.withChild env settings (command python fixture "hold" []) escaped
  let k =
    report env.console "expired alias" (match retained with
    | Err _ -> false
    | Ok result ->
      (match Process.next result.value with
      | Err failure -> failure.kind = Process.Closed
      | Ok _ -> false))
  let streaming =
    Process.communicate env settings (command python fixture "echo" []) (writeInput binary) continueOutput
  let l = report env.console "streaming input" (outputIs binary streaming)
  let pipeline = Process.pipeline [
    command python fixture "echo" [] |> Process.stdinText "pipeline",
    command python fixture "upper" [],
    command python fixture "count" []
  ]
  let piped = Process.runPipeline env settings pipeline
  let m =
    report env.console "pipeline" (outputIs (Bytes.fromString "8") piped && (match piped with
    | Ok output -> List.length output.exits = 3
    | Err _ -> false))
  let partial =
    Process.runPipeline env settings (Process.pipeline [
      Process.command "/fai-does-not-exist/program" [],
      command python fixture "hold" []
    ])
  let n =
    report env.console "partial pipeline startup" (match partial with
    | Err failure -> failure.kind = Process.SpawnFailure
    | Ok _ -> false)
  let gate = env.concurrency.channel 1
  let early =
    Process.communicate env settings (command python fixture "hold" []) (waitInput env.concurrency gate) stopOutput
  let o =
    report env.console "early stop cancels producer" (match early with
    | Ok output -> output.stopped
    | Err _ -> false)
  let p =
    report env.console "task cancellation" (env.concurrency.scope (cancelInScope env python fixture))
  let inherited =
    Process.run env { settings with
      drainTimeoutMs = Some 100
    } (command python fixture "descendant" [])
  let q =
    report env.console "descendant pipe cleanup" (match inherited with
    | Err failure -> failure.kind = Process.DrainDeadlineExceeded
    | Ok _ -> false)
  let slow =
    Process.withOutput env { settings with
      timeoutMs = Some 500
    } (command python fixture "args" ["ready"]) (slowOutput env.clock)
  let r =
    report env.console "deadline includes consumer" (match slow with
    | Err failure -> failure.kind = Process.DeadlineExceeded
    | Ok _ -> false)
  let discarded =
    Process.run env settings (command python fixture "args" [
      "discarded"
    ] |> Process.stdout Process.Discard)
  let s = report env.console "discard output" (outputIs Bytes.empty discarded)
  let nullInput =
    Process.run env settings (command python fixture "echo" [] |> Process.stdin Process.Discard)
  let t = report env.console "discard input" (outputIs Bytes.empty nullInput)
  let inherited =
    Process.run env settings (command python fixture "args" [
      "inherited-marker\n"
    ] |> Process.stdout Process.Inherit)
  let u = report env.console "inherit output" (outputIs Bytes.empty inherited)
  a && b && c && d && e && f && g && h && i && j && k && l && m && n && o && p && q && r && s && t && u

public main : R -> Unit / { Clock, Concurrency, Console, Env, ProcessHost.Process }
let main env =
  match env.env.args () with
  | [python, fixture, "inherit-stdin"] ->
    let result =
      Process.run env settings (command python fixture "echo" [] |> Process.stdin Process.Inherit)
    env.console.writeLine (if outputIs (Bytes.fromList (List.range 0 256)) result then
      "inherited input ok"
    else
      "inherited input FAILED")
  | [python, fixture] ->
    env.console.writeLine (if checks env python fixture then
      "process checks passed"
    else
      "process checks FAILED")
  | _ -> env.console.writeLine "expected Python executable and fixture path"
