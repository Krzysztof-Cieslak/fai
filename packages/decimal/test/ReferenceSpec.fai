module DecimalReferenceSpec

// Independent reference values generated using Python decimal at precision 200.
let decimal text = Result.withDefault Decimal.nan (Decimal.parse text)

let divided places mode a b expected inexact =
  Decimal.divideToScale places mode (decimal a) (decimal b) = Ok {
    inexact = inexact,
    value = decimal expected
  }
example: divided 20 Decimal.HalfEven "123456789012345678901234567890.12345" "987654321.12345" "124999998857813359419.54281053540886603320" true
example: divided 20 Decimal.Floor "-123456789012345678901234567890.12345" "987654321.12345" "-124999998857813359419.54281053540886603321" true
example: divided 12 Decimal.HalfEven "999999999999999999999999999999" "333333333333333333333333333333" "3.000000000000" false
example: divided 30 Decimal.HalfEven "100000000000000000000000000001" "99999999999999999999999999999" "1.000000000000000000000000000020" true
example: divided 32 Decimal.HalfEven "5" "200000000000000000000000000000" "0.00000000000000000000000000002500" false
example: divided 2 Decimal.HalfEven "999999999999999999.995" "1" "1000000000000000000.00" true
example: divided 20 Decimal.Ceiling "100000000000000000.0000000001" "10000000000000000" "10.00000000000000000001" true
example: Decimal.multiply (decimal "12345678901234567890.1234") (decimal "98765432109876543210.9876") = Ok (decimal "1219326311370217952261844047916481551580.39986984")
example: Decimal.multiply (decimal "-999999999999999999999999999999.9") (decimal "-0.0000000000000000000000000001") = Ok (decimal "99.99999999999999999999999999999")
