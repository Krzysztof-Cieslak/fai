module DecimalReferenceSpec

// Independent reference values generated using Python decimal at precision 200.
let decimal text = Result.withDefault Decimal.nan (Decimal.parse text)

let divided places mode a b expected inexact =
  Decimal.divideToScale places mode (decimal a) (decimal b) = Ok {
    inexact = inexact,
    value = decimal expected
  }

let case001 _ =
  let testActual =
    divided 20 Decimal.HalfEven "123456789012345678901234567890.12345" "987654321.12345" "124999998857813359419.54281053540886603320" true
  Expect.isTrue "divided 20 Decimal.HalfEven \"123456789012345678901234567890.12345\" \"987654321.12345\" \"124999998857813359419.54281053540886603320\" true" testActual

let case002 _ =
  let testActual =
    divided 20 Decimal.Floor "-123456789012345678901234567890.12345" "987654321.12345" "-124999998857813359419.54281053540886603321" true
  Expect.isTrue "divided 20 Decimal.Floor \"-123456789012345678901234567890.12345\" \"987654321.12345\" \"-124999998857813359419.54281053540886603321\" true" testActual

let case003 _ =
  let testActual =
    divided 12 Decimal.HalfEven "999999999999999999999999999999" "333333333333333333333333333333" "3.000000000000" false
  Expect.isTrue "divided 12 Decimal.HalfEven \"999999999999999999999999999999\" \"333333333333333333333333333333\" \"3.000000000000\" false" testActual

let case004 _ =
  let testActual =
    divided 30 Decimal.HalfEven "100000000000000000000000000001" "99999999999999999999999999999" "1.000000000000000000000000000020" true
  Expect.isTrue "divided 30 Decimal.HalfEven \"100000000000000000000000000001\" \"99999999999999999999999999999\" \"1.000000000000000000000000000020\" true" testActual

let case005 _ =
  let testActual =
    divided 32 Decimal.HalfEven "5" "200000000000000000000000000000" "0.00000000000000000000000000002500" false
  Expect.isTrue "divided 32 Decimal.HalfEven \"5\" \"200000000000000000000000000000\" \"0.00000000000000000000000000002500\" false" testActual

let case006 _ =
  let testActual =
    divided 2 Decimal.HalfEven "999999999999999999.995" "1" "1000000000000000000.00" true
  Expect.isTrue "divided 2 Decimal.HalfEven \"999999999999999999.995\" \"1\" \"1000000000000000000.00\" true" testActual

let case007 _ =
  let testActual =
    divided 20 Decimal.Ceiling "100000000000000000.0000000001" "10000000000000000" "10.00000000000000000001" true
  Expect.isTrue "divided 20 Decimal.Ceiling \"100000000000000000.0000000001\" \"10000000000000000\" \"10.00000000000000000001\" true" testActual

let case008 _ =
  let testActual =
    Decimal.multiply (decimal "12345678901234567890.1234") (decimal "98765432109876543210.9876") = Ok (decimal "1219326311370217952261844047916481551580.39986984")
  Expect.isTrue "Decimal.multiply (decimal \"12345678901234567890.1234\") (decimal \"98765432109876543210.9876\") = Ok (decimal \"1219326311370217952261844047916481551580.39986984\")" testActual

let case009 _ =
  let testActual =
    Decimal.multiply (decimal "-999999999999999999999999999999.9") (decimal "-0.0000000000000000000000000001") = Ok (decimal "99.99999999999999999999999999999")
  Expect.isTrue "Decimal.multiply (decimal \"-999999999999999999999999999999.9\") (decimal \"-0.0000000000000000000000000001\") = Ok (decimal \"99.99999999999999999999999999999\")" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "DecimalReferenceSpec" [
  Test.test "divided 20 Decimal.HalfEven \"123456789012345678901234567890.12345\" \"987654321.12345\" \"124999998857813359419.54281053540886603320\" true" case001,
  Test.test "divided 20 Decimal.Floor \"-123456789012345678901234567890.12345\" \"987654321.12345\" \"-124999998857813359419.54281053540886603321\" true" case002,
  Test.test "divided 12 Decimal.HalfEven \"999999999999999999999999999999\" \"333333333333333333333333333333\" \"3.000000000000\" false" case003,
  Test.test "divided 30 Decimal.HalfEven \"100000000000000000000000000001\" \"99999999999999999999999999999\" \"1.000000000000000000000000000020\" true" case004,
  Test.test "divided 32 Decimal.HalfEven \"5\" \"200000000000000000000000000000\" \"0.00000000000000000000000000002500\" false" case005,
  Test.test "divided 2 Decimal.HalfEven \"999999999999999999.995\" \"1\" \"1000000000000000000.00\" true" case006,
  Test.test "divided 20 Decimal.Ceiling \"100000000000000000.0000000001\" \"10000000000000000\" \"10.00000000000000000001\" true" case007,
  Test.test "Decimal.multiply (decimal \"12345678901234567890.1234\") (decimal \"98765432109876543210.9876\") = Ok (decimal \"1219326311370217952261844047916481551580.39986984\")" case008,
  Test.test "Decimal.multiply (decimal \"-999999999999999999999999999999.9\") (decimal \"-0.0000000000000000000000000001\") = Ok (decimal \"99.99999999999999999999999999999\")" case009
]
