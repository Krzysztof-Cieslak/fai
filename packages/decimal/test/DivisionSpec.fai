module DecimalDivisionSpec

let decimal text = Result.withDefault Decimal.nan (Decimal.parse text)

let exact a b expected =
  Result.map Decimal.toString (Decimal.divideExact (decimal a) (decimal b)) = Ok expected

let scale places mode a b expected inexact =
  Result.map (fun result ->
    (Decimal.toString result.value, result.inexact)) (Decimal.divideToScale places mode (decimal a) (decimal b)) = Ok (expected, inexact)

let round places mode text expected inexact =
  Result.map (fun result ->
    (Decimal.toString result.value, result.inexact)) (Decimal.roundToScale places mode (decimal text)) = Ok (expected, inexact)

let case001 _ =
  let testActual = exact "1" "8" "0.125"
  Expect.isTrue "exact \"1\" \"8\" \"0.125\"" testActual

let case002 _ =
  let testActual = exact "1" "40" "0.025"
  Expect.isTrue "exact \"1\" \"40\" \"0.025\"" testActual

let case003 _ =
  let testActual = exact "1" "2" "0.5"
  Expect.isTrue "exact \"1\" \"2\" \"0.5\"" testActual

let case004 _ =
  let testActual = exact "6" "3" "2"
  Expect.isTrue "exact \"6\" \"3\" \"2\"" testActual

let case005 _ =
  let testActual = exact "1.2" "0.3" "4"
  Expect.isTrue "exact \"1.2\" \"0.3\" \"4\"" testActual

let case006 _ =
  let testActual = exact "-1" "2" "-0.5"
  Expect.isTrue "exact \"-1\" \"2\" \"-0.5\"" testActual

let case007 _ =
  let testActual = exact "999999999999999999" "999999999999999999" "1"
  Expect.isTrue "exact \"999999999999999999\" \"999999999999999999\" \"1\"" testActual

let case008 _ =
  let testActual = exact "999999999999999999000000000" "999999999999999999" "1000000000"
  Expect.isTrue "exact \"999999999999999999000000000\" \"999999999999999999\" \"1000000000\"" testActual

let case009 _ =
  let testActual = Decimal.divideExact (decimal "1") (decimal "3") |> Result.isErr
  Expect.isTrue "Decimal.divideExact (decimal \"1\") (decimal \"3\") |> Result.isErr" testActual

let case010 _ =
  let testActual = scale 2 Decimal.HalfEven "1" "3" "0.33" true
  Expect.isTrue "scale 2 Decimal.HalfEven \"1\" \"3\" \"0.33\" true" testActual

let case011 _ =
  let testActual = scale 2 Decimal.HalfEven "1" "8" "0.12" true
  Expect.isTrue "scale 2 Decimal.HalfEven \"1\" \"8\" \"0.12\" true" testActual

let case012 _ =
  let testActual = scale 2 Decimal.HalfEven "3" "8" "0.38" true
  Expect.isTrue "scale 2 Decimal.HalfEven \"3\" \"8\" \"0.38\" true" testActual

let case013 _ =
  let testActual = scale 2 Decimal.HalfAwayFromZero "1" "8" "0.13" true
  Expect.isTrue "scale 2 Decimal.HalfAwayFromZero \"1\" \"8\" \"0.13\" true" testActual

let case014 _ =
  let testActual = scale 2 Decimal.HalfTowardZero "3" "8" "0.37" true
  Expect.isTrue "scale 2 Decimal.HalfTowardZero \"3\" \"8\" \"0.37\" true" testActual

let case015 _ =
  let testActual = scale 2 Decimal.Floor "-1" "3" "-0.34" true
  Expect.isTrue "scale 2 Decimal.Floor \"-1\" \"3\" \"-0.34\" true" testActual

let case016 _ =
  let testActual = scale 2 Decimal.Ceiling "-1" "3" "-0.33" true
  Expect.isTrue "scale 2 Decimal.Ceiling \"-1\" \"3\" \"-0.33\" true" testActual

let case017 _ =
  let testActual = scale 2 Decimal.AwayFromZero "1" "3" "0.34" true
  Expect.isTrue "scale 2 Decimal.AwayFromZero \"1\" \"3\" \"0.34\" true" testActual

let case018 _ =
  let testActual = scale 2 Decimal.TowardZero "-1" "3" "-0.33" true
  Expect.isTrue "scale 2 Decimal.TowardZero \"-1\" \"3\" \"-0.33\" true" testActual

let case019 _ =
  let testActual = scale 2 Decimal.Exact "1" "4" "0.25" false
  Expect.isTrue "scale 2 Decimal.Exact \"1\" \"4\" \"0.25\" false" testActual

let case020 _ =
  let testActual = Decimal.divideToScale 2 Decimal.Exact (decimal "1") (decimal "3") |> Result.isErr
  Expect.isTrue "Decimal.divideToScale 2 Decimal.Exact (decimal \"1\") (decimal \"3\") |> Result.isErr" testActual

let case021 _ =
  let testActual = round 2 Decimal.HalfEven "1.235" "1.24" true
  Expect.isTrue "round 2 Decimal.HalfEven \"1.235\" \"1.24\" true" testActual

let case022 _ =
  let testActual = round 2 Decimal.HalfEven "1.225" "1.22" true
  Expect.isTrue "round 2 Decimal.HalfEven \"1.225\" \"1.22\" true" testActual

let case023 _ =
  let testActual = round 2 Decimal.HalfEven "-1.225" "-1.22" true
  Expect.isTrue "round 2 Decimal.HalfEven \"-1.225\" \"-1.22\" true" testActual

let case024 _ =
  let testActual = round 2 Decimal.HalfEven "1.2300" "1.23" false
  Expect.isTrue "round 2 Decimal.HalfEven \"1.2300\" \"1.23\" false" testActual

let case025 _ =
  let testActual = round (-2) Decimal.HalfEven "1250" "1200" true
  Expect.isTrue "round (-2) Decimal.HalfEven \"1250\" \"1200\" true" testActual

let case026 _ =
  let testActual = round (-2) Decimal.HalfEven "1350" "1400" true
  Expect.isTrue "round (-2) Decimal.HalfEven \"1350\" \"1400\" true" testActual

let case027 _ =
  let testActual = round 0 Decimal.Ceiling "-0.01" "0" true
  Expect.isTrue "round 0 Decimal.Ceiling \"-0.01\" \"0\" true" testActual

let case028 _ =
  let testActual = round 0 Decimal.Floor "-0.01" "-1" true
  Expect.isTrue "round 0 Decimal.Floor \"-0.01\" \"-1\" true" testActual

let case029 _ =
  let testActual = round 0 Decimal.HalfEven "1e-1000000" "0" true
  Expect.isTrue "round 0 Decimal.HalfEven \"1e-1000000\" \"0\" true" testActual

let case030 _ =
  let testActual =
    Result.map (fun result ->
      Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal "1234") (decimal "5")) = Ok "247"
  Expect.isTrue "Result.map (fun result -> Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal \"1234\") (decimal \"5\")) = Ok \"247\"" testActual

let case031 _ =
  let testActual =
    Result.map (fun result ->
      Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal "1") (decimal "3000")) = Ok "0.000333"
  Expect.isTrue "Result.map (fun result -> Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal \"1\") (decimal \"3000\")) = Ok \"0.000333\"" testActual

let case032 _ =
  let testActual = Decimal.toFixed 2 Decimal.HalfEven (decimal "1.2") = Ok ("1.20", false)
  Expect.isTrue "Decimal.toFixed 2 Decimal.HalfEven (decimal \"1.2\") = Ok (\"1.20\", false)" testActual

let case033 _ =
  let testActual = Decimal.toFixed 2 Decimal.HalfEven (decimal "0.001") = Ok ("0.00", true)
  Expect.isTrue "Decimal.toFixed 2 Decimal.HalfEven (decimal \"0.001\") = Ok (\"0.00\", true)" testActual

let case034 _ =
  let testActual = Decimal.toFixed 4 Decimal.HalfEven (decimal "0.001") = Ok ("0.0010", false)
  Expect.isTrue "Decimal.toFixed 4 Decimal.HalfEven (decimal \"0.001\") = Ok (\"0.0010\", false)" testActual

let case035 _ =
  let testActual = Decimal.toFixed 2 Decimal.HalfEven (decimal "0") = Ok ("0.00", false)
  Expect.isTrue "Decimal.toFixed 2 Decimal.HalfEven (decimal \"0\") = Ok (\"0.00\", false)" testActual

let case036 _ =
  let testActual = Decimal.toScientific 4 Decimal.HalfEven (decimal "123.45") = Ok ("1.234e2", true)
  Expect.isTrue "Decimal.toScientific 4 Decimal.HalfEven (decimal \"123.45\") = Ok (\"1.234e2\", true)" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "DecimalDivisionSpec" [
  Test.test "exact \"1\" \"8\" \"0.125\"" case001,
  Test.test "exact \"1\" \"40\" \"0.025\"" case002,
  Test.test "exact \"1\" \"2\" \"0.5\"" case003,
  Test.test "exact \"6\" \"3\" \"2\"" case004,
  Test.test "exact \"1.2\" \"0.3\" \"4\"" case005,
  Test.test "exact \"-1\" \"2\" \"-0.5\"" case006,
  Test.test "exact \"999999999999999999\" \"999999999999999999\" \"1\"" case007,
  Test.test "exact \"999999999999999999000000000\" \"999999999999999999\" \"1000000000\"" case008,
  Test.test "Decimal.divideExact (decimal \"1\") (decimal \"3\") |> Result.isErr" case009,
  Test.test "scale 2 Decimal.HalfEven \"1\" \"3\" \"0.33\" true" case010,
  Test.test "scale 2 Decimal.HalfEven \"1\" \"8\" \"0.12\" true" case011,
  Test.test "scale 2 Decimal.HalfEven \"3\" \"8\" \"0.38\" true" case012,
  Test.test "scale 2 Decimal.HalfAwayFromZero \"1\" \"8\" \"0.13\" true" case013,
  Test.test "scale 2 Decimal.HalfTowardZero \"3\" \"8\" \"0.37\" true" case014,
  Test.test "scale 2 Decimal.Floor \"-1\" \"3\" \"-0.34\" true" case015,
  Test.test "scale 2 Decimal.Ceiling \"-1\" \"3\" \"-0.33\" true" case016,
  Test.test "scale 2 Decimal.AwayFromZero \"1\" \"3\" \"0.34\" true" case017,
  Test.test "scale 2 Decimal.TowardZero \"-1\" \"3\" \"-0.33\" true" case018,
  Test.test "scale 2 Decimal.Exact \"1\" \"4\" \"0.25\" false" case019,
  Test.test "Decimal.divideToScale 2 Decimal.Exact (decimal \"1\") (decimal \"3\") |> Result.isErr" case020,
  Test.test "round 2 Decimal.HalfEven \"1.235\" \"1.24\" true" case021,
  Test.test "round 2 Decimal.HalfEven \"1.225\" \"1.22\" true" case022,
  Test.test "round 2 Decimal.HalfEven \"-1.225\" \"-1.22\" true" case023,
  Test.test "round 2 Decimal.HalfEven \"1.2300\" \"1.23\" false" case024,
  Test.test "round (-2) Decimal.HalfEven \"1250\" \"1200\" true" case025,
  Test.test "round (-2) Decimal.HalfEven \"1350\" \"1400\" true" case026,
  Test.test "round 0 Decimal.Ceiling \"-0.01\" \"0\" true" case027,
  Test.test "round 0 Decimal.Floor \"-0.01\" \"-1\" true" case028,
  Test.test "round 0 Decimal.HalfEven \"1e-1000000\" \"0\" true" case029,
  Test.test "Result.map (fun result -> Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal \"1234\") (decimal \"5\")) = Ok \"247\"" case030,
  Test.test "Result.map (fun result -> Decimal.toString result.value) (Decimal.divideToPrecision 3 Decimal.HalfEven (decimal \"1\") (decimal \"3000\")) = Ok \"0.000333\"" case031,
  Test.test "Decimal.toFixed 2 Decimal.HalfEven (decimal \"1.2\") = Ok (\"1.20\", false)" case032,
  Test.test "Decimal.toFixed 2 Decimal.HalfEven (decimal \"0.001\") = Ok (\"0.00\", true)" case033,
  Test.test "Decimal.toFixed 4 Decimal.HalfEven (decimal \"0.001\") = Ok (\"0.0010\", false)" case034,
  Test.test "Decimal.toFixed 2 Decimal.HalfEven (decimal \"0\") = Ok (\"0.00\", false)" case035,
  Test.test "Decimal.toScientific 4 Decimal.HalfEven (decimal \"123.45\") = Ok (\"1.234e2\", true)" case036
]
