module DecimalProperties

let addSubtract a b =
  let a = Decimal.fromInt a
  let b = Decimal.fromInt b
  match Decimal.add a b with
  | Err _ -> false
  | Ok sum -> Decimal.subtract sum b = Ok a

let case001 testInput =
  let (a, b) = testInput
  let testActual = addSubtract a b
  Expect.isTrue "property: addSubtract a b" testActual

let multiplication a b c =
  let a = Decimal.fromInt a
  let b = Decimal.fromInt b
  let c = Decimal.fromInt c
  match (Decimal.multiply a b, Decimal.multiply b c) with
  | (Ok ab, Ok bc) ->
    Decimal.multiply ab c = Decimal.multiply a bc && Decimal.multiply a b = Decimal.multiply b a
  | _ -> false

let case002 testInput =
  let (a, b, c) = testInput
  let testActual = multiplication a b c
  Expect.isTrue "property: multiplication a b c" testActual

let quotientProduct a b =
  if b = 0 then
    true
  else
    let a = Decimal.fromInt a
    let b = Decimal.fromInt b
    match Decimal.multiply a b with
    | Err _ -> false
    | Ok product -> Decimal.divideExact product b = Ok a

let case003 testInput =
  let (a, b) = testInput
  let testActual = quotientProduct a b
  Expect.isTrue "property: quotientProduct a b" testActual

let sign value = if value < 0 then -1 else if value > 0 then 1 else 0

let case004 testInput =
  let (a, b) = testInput
  let testActual = sign (Decimal.compare (Decimal.fromInt a) (Decimal.fromInt b))
  let testExpected = sign (compare a b)
  Expect.equal (Test.int).show testExpected testActual

let case005 testInput =
  let value = testInput
  let testActual = Decimal.toIntExact (Decimal.fromInt value) = Ok value
  Expect.isTrue "property: Decimal.toIntExact (Decimal.fromInt value) = Ok value" testActual

let floatRoundTrip value =
  match Decimal.fromFloatExact value with
  | Err _ -> false
  | Ok decimal ->
    match Decimal.toFloat decimal with
    | Err _ -> false
    | Ok converted -> Float.toBits value = Float.toBits converted || decimal = Decimal.zero

let case006 testInput =
  let value = testInput
  let testActual = floatRoundTrip value
  Expect.isTrue "property: floatRoundTrip value" testActual

let parsed text =
  match Decimal.parse text with
  | Ok value -> Decimal.parse (Decimal.toString value) = Ok value
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset <= Bytes.length (Bytes.fromString text)

let case007 testInput =
  let text = testInput
  let testActual = parsed text
  Expect.isTrue "property: parsed text" testActual

let roundedTwice number places =
  let scale = Int.and places 15 - 7
  let value =
    Result.withDefault Decimal.nan (Decimal.fromParts {
      coefficient = Int.toString (Int.and number 9223372036854775807),
      exponent = -5,
      negative = number < 0
    })
  match Decimal.roundToScale scale Decimal.HalfEven value with
  | Err _ -> false
  | Ok rounded ->
    Decimal.roundToScale scale Decimal.HalfEven rounded.value = Ok {
      inexact = false,
      value = rounded.value
    }

let case008 testInput =
  let (number, places) = testInput
  let testActual = roundedTwice number places
  Expect.isTrue "property: roundedTwice number places" testActual

let integerDivision a b =
  let a = (Int.and a 65535) - 32768
  let b = Int.and b 255 + 1
  match Decimal.divideToScale 0 Decimal.TowardZero (Decimal.fromInt a) (Decimal.fromInt b) with
  | Err _ -> false
  | Ok rounded -> Decimal.toIntExact rounded.value = Ok (a / b) && rounded.inexact = (a % b <> 0)

let case009 testInput =
  let (a, b) = testInput
  let testActual = integerDivision a b
  Expect.isTrue "property: integerDivision a b" testActual

let case010 _ =
  let testActual =
    Set.size (Set.fromList [
      Result.withDefault Decimal.nan (Decimal.parse "1"),
      Result.withDefault Decimal.nan (Decimal.parse "1.00")
    ])
  let testExpected = 1
  Expect.equal (Test.int).show testExpected testActual

let case011 _ =
  let testActual = HashSet.size (HashSet.fromList [Decimal.nan, Decimal.nan])
  let testExpected = 1
  Expect.equal (Test.int).show testExpected testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "DecimalProperties" [
  Test.property "property: addSubtract a b" (Test.tuple2 Test.int Test.int) case001,
  Test.property "property: multiplication a b c" (Test.tuple3 Test.int Test.int Test.int) case002,
  Test.property "property: quotientProduct a b" (Test.tuple2 Test.int Test.int) case003,
  Test.property "property: sign (Decimal.compare (Decimal.fromInt a) (Decimal.fromInt b)) = sign (compare a b)" (Test.tuple2 Test.int Test.int) case004,
  Test.property "property: Decimal.toIntExact (Decimal.fromInt value) = Ok value" Test.int case005,
  Test.property "property: floatRoundTrip value" Test.float case006,
  Test.property "property: parsed text" Test.string case007,
  Test.property "property: roundedTwice number places" (Test.tuple2 Test.int Test.int) case008,
  Test.property "property: integerDivision a b" (Test.tuple2 Test.int Test.int) case009,
  Test.test "Set.size (Set.fromList [ Result.withDefault Decimal.nan (Decimal.parse \"1\"), Result.withDefault Decimal.nan (Decimal.parse \"1.00\") ]) = 1" case010,
  Test.test "HashSet.size (HashSet.fromList [Decimal.nan, Decimal.nan]) = 1" case011
]
