module DecimalArithmeticSpec

let decimal text = Result.withDefault Decimal.nan (Decimal.parse text)

let add a b expected =
  Result.map Decimal.toString (Decimal.add (decimal a) (decimal b)) = Ok expected

let sub a b expected =
  Result.map Decimal.toString (Decimal.subtract (decimal a) (decimal b)) = Ok expected

let mul a b expected =
  Result.map Decimal.toString (Decimal.multiply (decimal a) (decimal b)) = Ok expected
example: add "0.1" "0.2" "0.3"
example: add "999999999999999999" "1" "1000000000000000000"
example: add "-1.5" "1.5" "0"
example: add "-2" "1" "-1"
example: add "1" "-2" "-1"
example: add "1.25" "2.5" "3.75"
example: sub "1.2" "1.01" "0.19"
example: sub "-1.2" "1.01" "-2.21"
example: mul "1.5" "2" "3"
example: mul "-1.5" "-0.2" "0.3"
example: mul "999999999999999999" "999999999999999999" "9.99999999999999998000000000000000001e35"
example: decimal "1" = decimal "1.00"
example: decimal "-0" = decimal "+000.0e+99"
example: decimal "10" = decimal ".1e2"
example: Decimal.compare (decimal "9e999999") (decimal "1e1000000") < 0
example: Decimal.compare (decimal "-9e999999") (decimal "-1e1000000") > 0
example: Decimal.compare Decimal.negativeInfinity (decimal "-1e1000000") < 0
example: Decimal.compare Decimal.positiveInfinity Decimal.nan < 0
example: Decimal.compare Decimal.nan Decimal.nan = 0
example: Decimal.nan = Decimal.nan
example: Decimal.parse "1_000" |> Result.isErr
example: Decimal.parse " 1" |> Result.isErr
example: Decimal.parse "1 " |> Result.isErr
example: Decimal.parse "1e" |> Result.isErr
example: Decimal.parse "." |> Result.isErr
example: Decimal.parse "nan" |> Result.isErr
example: Decimal.toString (decimal "+001.2300e2") = "123"
example: Decimal.toString (decimal "1e-7") = "1e-7"
example: Decimal.toIntExact (decimal "-9223372036854775808") = Ok (-9223372036854775808)
example: Decimal.toIntExact (decimal "9223372036854775808") |> Result.isErr
example: Decimal.toIntExact (decimal "1.1") |> Result.isErr
