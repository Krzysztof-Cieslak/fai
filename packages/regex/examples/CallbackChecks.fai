module RegexCallbackChecks

replace : Console -> Regex.Captures -> Result String String / { Console }
let replace console captures =
  let text = Regex.text (Regex.whole captures)
  let logged = console.writeLine ("visit:" ++ text)
  if text = "b" then Err "stop" else Ok (String.toUpper text)

checks : Console -> Test.Check / { Console }
let checks console =
  match Regex.compile "." with
  | Err error -> Test.error (Regex.errorToString error)
  | Ok regex ->
    let result = Regex.replaceWith regex (replace console) "abc"
    let failed =
      match result with
      | Err error ->
        error.completed = 1 && error.cause = RegexTypes.ReplacementFailure "stop" && error.span = Some {
          endByte = 2,
          startByte = 1
        }
      | _ -> false
    let folded = Regex.fold regex "abc" 0 (fun count found -> Ok (count + 1, RegexTypes.Stop))
    let invalid =
      Regex.replaceWithLimits { Regex.limits with
        maxInputBytes = 0
      } 1 regex (fun _ -> Ok (Int.toString (1 / 0))) "a"
    Expect.all [
      Expect.isTrue "replacement retains completed count, cause and span" failed,
      Expect.equal Int.toString 1 folded.visited,
      Expect.isTrue "fold stops at the requested match" folded.stopped,
      Expect.isTrue "limit failure precedes callback execution" (Result.isErr invalid)
    ]

public main : Runtime -> Unit / { Console }
let main env =
  env.console.writeLine (if checks env.console = Test.pass then
    "regex callback checks passed"
  else
    "regex callback checks FAILED")

tests : Test.Suite Test.Context { Console }
let tests = Test.describe "regex callbacks" [
  Test.test "failures, early stop and input limits" (fun ctx -> checks ctx.runtime.console)
]
