module RegexTemplateSpec

let replace pattern template input =
  match Regex.compile pattern with
  | Err error -> Err error
  | Ok regex ->
    match RegexTemplate.compile regex template with
    | Err error -> Err error
    | Ok template -> RegexTemplate.replaceAll template input
example: replace "(?<year>[0-9]{4})-([0-9]{2})" "$2/${year}" "2026-10" = Ok "10/2026"
example: replace "(a)?b" "<$1>$$" "b ab" = Ok "<>$ <a>$"
example: replace "a" "$0" "abc" = Ok "abc"
example: replace "a" "${missing}" "no match" |> Result.isErr
example: replace "a" "${" "a" |> Result.isErr
example: replace "a" "$" "a" |> Result.isErr
example: replace "a" "$999999999999999999999999" "a" |> Result.isErr
example: replace "a" "${18446744073709551616}" "a" |> Result.isErr
example: replace "a" (RegexTemplate.escape "$1") "a" = Ok "$1"
example: (match Regex.compile "a" with
| Err _ -> false
| Ok regex ->
  RegexTemplate.compileWith { RegexTemplate.options with
    maxParts = 0
  } regex "text" |> Result.isErr)
example: (match RegexBytes.compile "(.)" with
| Err _ -> false
| Ok regex ->
  (match RegexTemplate.compileBytes regex (Bytes.fromList [255, 36, 49]) with
  | Err _ -> false
  | Ok template ->
    RegexTemplate.replaceAllBytes template (Bytes.fromList [
      1,
      2
    ]) = Ok (Bytes.fromList [255, 1, 255, 2])))
