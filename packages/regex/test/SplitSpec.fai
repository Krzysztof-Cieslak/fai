module RegexSplitSpec

let split pattern input =
  match Regex.compile pattern with
  | Err error -> Err error
  | Ok regex -> Regex.split regex input

let case001 _ =
  let testActual = split "," ",a,,b," = Ok [| "", "a", "", "b", "" |]
  Expect.isTrue "split \",\" \",a,,b,\" = Ok [| \"\", \"a\", \"\", \"b\", \"\" |]" testActual

let case002 _ =
  let testActual = split "(,)" "a,b" = Ok [| "a", "b" |]
  Expect.isTrue "split \"(,)\" \"a,b\" = Ok [| \"a\", \"b\" |]" testActual

let case003 _ =
  let testActual = split "" "é🙂" = Ok [| "", "é", "🙂", "" |]
  Expect.isTrue "split \"\" \"é🙂\" = Ok [| \"\", \"é\", \"🙂\", \"\" |]" testActual

let case004 _ =
  let testActual = split "" "" = Ok [| "", "" |]
  Expect.isTrue "split \"\" \"\" = Ok [| \"\", \"\" |]" testActual

let case005 _ =
  let testActual = split "," "" = Ok [| "" |]
  Expect.isTrue "split \",\" \"\" = Ok [| \"\" |]" testActual

let case006 _ =
  let testActual =
    (match Regex.compile "," with
    | Err _ -> false
    | Ok regex ->
      Regex.splitN 0 regex "a,b,c" = Ok [||] && Regex.splitN 1 regex "a,b,c" = Ok [|
        "a,b,c"
      |] && Regex.splitN 2 regex "a,b,c" = Ok [| "a", "b,c" |])
  Expect.isTrue "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitN 0 regex \"a,b,c\" = Ok [||] && Regex.splitN 1 regex \"a,b,c\" = Ok [| \"a,b,c\" |] && Reg…" testActual

let case007 _ =
  let testActual =
    (match Regex.compile "," with
    | Err _ -> false
    | Ok regex -> Regex.splitN (-1) regex "a,b" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitN (-1) regex \"a,b\" |> Result.isErr)" testActual

let case008 _ =
  let testActual =
    (match Regex.compile "," with
    | Err _ -> false
    | Ok regex ->
      Regex.splitWithLimits { Regex.limits with maxResults = 2 } regex "a,b" = Ok [| "a", "b" |])
  Expect.isTrue "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxResults = 2 } regex \"a,b\" = Ok [| \"a\", \"b\" |])" testActual

let case009 _ =
  let testActual =
    (match Regex.compile "," with
    | Err _ -> false
    | Ok regex ->
      Regex.splitWithLimits { Regex.limits with maxResults = 1 } regex "a,b" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxResults = 1 } regex \"a,b\" |> Result.isErr)" testActual

let case010 _ =
  let testActual =
    (match Regex.compile "," with
    | Err _ -> false
    | Ok regex ->
      Regex.splitWithLimits { Regex.limits with maxOutputBytes = 1 } regex "a,b" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxOutputBytes = 1 } regex \"a,b\" |> Result.isErr)" testActual

let case011 _ =
  let testActual =
    (match RegexBytes.compile "\\x00" with
    | Err _ -> false
    | Ok regex ->
      RegexBytes.split regex (Bytes.fromList [
        255,
        0,
        254
      ]) = Ok [| Bytes.fromList [255], Bytes.fromList [254] |])
  Expect.isTrue "(match RegexBytes.compile \"\\\\x00\" with | Err _ -> false | Ok regex -> RegexBytes.split regex (Bytes.fromList [ 255, 0, 254 ]) = Ok [| Bytes.fromList [255], B…" testActual

let escapedBytes values =
  let bytes = Bytes.fromList values
  match RegexBytes.compile (RegexBytes.escape bytes) with
  | Err _ -> false
  | Ok regex -> RegexBytes.isMatch regex bytes = Ok true

let case012 testInput =
  let values = testInput
  let testActual = escapedBytes values
  Expect.isTrue "property: escapedBytes values" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "RegexSplitSpec" [
  Test.test "split \",\" \",a,,b,\" = Ok [| \"\", \"a\", \"\", \"b\", \"\" |]" case001,
  Test.test "split \"(,)\" \"a,b\" = Ok [| \"a\", \"b\" |]" case002,
  Test.test "split \"\" \"é🙂\" = Ok [| \"\", \"é\", \"🙂\", \"\" |]" case003,
  Test.test "split \"\" \"\" = Ok [| \"\", \"\" |]" case004,
  Test.test "split \",\" \"\" = Ok [| \"\" |]" case005,
  Test.test "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitN 0 regex \"a,b,c\" = Ok [||] && Regex.splitN 1 regex \"a,b,c\" = Ok [| \"a,b,c\" |] && Reg…" case006,
  Test.test "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitN (-1) regex \"a,b\" |> Result.isErr)" case007,
  Test.test "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxResults = 2 } regex \"a,b\" = Ok [| \"a\", \"b\" |])" case008,
  Test.test "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxResults = 1 } regex \"a,b\" |> Result.isErr)" case009,
  Test.test "(match Regex.compile \",\" with | Err _ -> false | Ok regex -> Regex.splitWithLimits { Regex.limits with maxOutputBytes = 1 } regex \"a,b\" |> Result.isErr)" case010,
  Test.test "(match RegexBytes.compile \"\\\\x00\" with | Err _ -> false | Ok regex -> RegexBytes.split regex (Bytes.fromList [ 255, 0, 254 ]) = Ok [| Bytes.fromList [255], B…" case011,
  Test.property "property: escapedBytes values" (Test.list Test.int) case012
]
