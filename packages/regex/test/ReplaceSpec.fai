module RegexReplaceSpec

let all pattern replacement input =
  match Regex.compile pattern with
  | Err error -> Err error
  | Ok regex -> Regex.replaceAll regex replacement input

let case001 _ =
  let testActual = all "a" "$1" "banana" = Ok "b$1n$1n$1"
  Expect.isTrue "all \"a\" \"$1\" \"banana\" = Ok \"b$1n$1n$1\"" testActual

let case002 _ =
  let testActual = all "" "-" "é🙂" = Ok "-é-🙂-"
  Expect.isTrue "all \"\" \"-\" \"é🙂\" = Ok \"-é-🙂-\"" testActual

let case003 _ =
  let testActual = all "a*" "x" "aa" = Ok "x"
  Expect.isTrue "all \"a*\" \"x\" \"aa\" = Ok \"x\"" testActual

let case004 _ =
  let testActual = all "z" "other" "unchanged" = Ok "unchanged"
  Expect.isTrue "all \"z\" \"other\" \"unchanged\" = Ok \"unchanged\"" testActual

let case005 _ =
  let testActual =
    (match Regex.compile "a" with
    | Err _ -> false
    | Ok regex ->
      Regex.replaceN 1 regex "X" "banana" = Ok "bXnana" && Regex.replaceN 0 regex "X" "banana" = Ok "banana")
  Expect.isTrue "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceN 1 regex \"X\" \"banana\" = Ok \"bXnana\" && Regex.replaceN 0 regex \"X\" \"banana\" = Ok \"b…" testActual

let case006 _ =
  let testActual =
    (match Regex.compile "a" with
    | Err _ -> false
    | Ok regex -> Regex.replaceN (-1) regex "X" "banana" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceN (-1) regex \"X\" \"banana\" |> Result.isErr)" testActual

let case007 _ =
  let testActual =
    (match Regex.compile "." with
    | Err _ -> false
    | Ok regex ->
      Regex.replaceNWithLimits { Regex.limits with
        maxOutputBytes = 2
      } 100 regex "XX" "aaa" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \".\" with | Err _ -> false | Ok regex -> Regex.replaceNWithLimits { Regex.limits with maxOutputBytes = 2 } 100 regex \"XX\" \"aaa\" |> Result…" testActual

let case008 _ =
  let testActual =
    (match Regex.compile "." with
    | Err _ -> false
    | Ok regex ->
      Regex.replaceNWithLimits { Regex.limits with
        maxResults = 1
      } 100 regex "X" "aaa" |> Result.isErr)
  Expect.isTrue "(match Regex.compile \".\" with | Err _ -> false | Ok regex -> Regex.replaceNWithLimits { Regex.limits with maxResults = 1 } 100 regex \"X\" \"aaa\" |> Result.isErr)" testActual

let case009 _ =
  let testActual =
    (match Regex.compile "a" with
    | Err _ -> false
    | Ok regex ->
      Regex.replaceWith regex (fun captures ->
        Ok (String.toUpper (Regex.text (Regex.whole captures)))) "banana" = Ok "bAnAnA")
  Expect.isTrue "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceWith regex (fun captures -> Ok (String.toUpper (Regex.text (Regex.whole captures)))…" testActual

let failure =
  match Regex.compile "." with
  | Err _ -> false
  | Ok regex ->
    match Regex.replaceWith regex (fun captures ->
      if Regex.text (Regex.whole captures) = "b" then Err "stop" else Ok "X") "abc" with
    | Ok _ -> false
    | Err error ->
      error.completed = 1 && error.span = Some {
        endByte = 2,
        startByte = 1
      } && error.cause = RegexTypes.ReplacementFailure "stop"

let case010 _ =
  let testActual = failure
  Expect.isTrue "failure" testActual

let case011 _ =
  let testActual =
    (match RegexBytes.compile "\\xFF" with
    | Err _ -> false
    | Ok regex ->
      RegexBytes.replaceAll regex (Bytes.fromList [
        0,
        1
      ]) (Bytes.fromList [2, 255, 3]) = Ok (Bytes.fromList [2, 0, 1, 3]))
  Expect.isTrue "(match RegexBytes.compile \"\\\\xFF\" with | Err _ -> false | Ok regex -> RegexBytes.replaceAll regex (Bytes.fromList [ 0, 1 ]) (Bytes.fromList [2, 255, 3]) = Ok…" testActual

let case012 testInput =
  let input = testInput
  let testActual =
    match Regex.compile "." with
    | Err _ -> false
    | Ok regex ->
      (Regex.replaceWith regex (fun _ ->
        Ok "X") input |> Result.mapError RegexInternal.simpleError) = Regex.replaceAll regex "X" input
  Expect.isTrue "property: match Regex.compile \".\" with | Err _ -> false | Ok regex -> (Regex.replaceWith regex (fun _ -> Ok \"X\") input |> Result.mapError RegexInternal.simpl…" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "RegexReplaceSpec" [
  Test.test "all \"a\" \"$1\" \"banana\" = Ok \"b$1n$1n$1\"" case001,
  Test.test "all \"\" \"-\" \"é🙂\" = Ok \"-é-🙂-\"" case002,
  Test.test "all \"a*\" \"x\" \"aa\" = Ok \"x\"" case003,
  Test.test "all \"z\" \"other\" \"unchanged\" = Ok \"unchanged\"" case004,
  Test.test "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceN 1 regex \"X\" \"banana\" = Ok \"bXnana\" && Regex.replaceN 0 regex \"X\" \"banana\" = Ok \"b…" case005,
  Test.test "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceN (-1) regex \"X\" \"banana\" |> Result.isErr)" case006,
  Test.test "(match Regex.compile \".\" with | Err _ -> false | Ok regex -> Regex.replaceNWithLimits { Regex.limits with maxOutputBytes = 2 } 100 regex \"XX\" \"aaa\" |> Result…" case007,
  Test.test "(match Regex.compile \".\" with | Err _ -> false | Ok regex -> Regex.replaceNWithLimits { Regex.limits with maxResults = 1 } 100 regex \"X\" \"aaa\" |> Result.isErr)" case008,
  Test.test "(match Regex.compile \"a\" with | Err _ -> false | Ok regex -> Regex.replaceWith regex (fun captures -> Ok (String.toUpper (Regex.text (Regex.whole captures)))…" case009,
  Test.test "failure" case010,
  Test.test "(match RegexBytes.compile \"\\\\xFF\" with | Err _ -> false | Ok regex -> RegexBytes.replaceAll regex (Bytes.fromList [ 0, 1 ]) (Bytes.fromList [2, 255, 3]) = Ok…" case011,
  Test.property "property: match Regex.compile \".\" with | Err _ -> false | Ok regex -> (Regex.replaceWith regex (fun _ -> Ok \"X\") input |> Result.mapError RegexInternal.simpl…" Test.string case012
]
