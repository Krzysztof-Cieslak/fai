module YamlEncodingSpec

let scalar bytes =
  Result.map (fun value ->
    value = YamlData.String "é") (Yaml.loadBytes (Bytes.fromList bytes)) = Ok true
example: scalar [0xc3, 0xa9]
example: scalar [0xef, 0xbb, 0xbf, 0xc3, 0xa9]
example: scalar [0xff, 0xfe, 0xe9, 0x00]
example: scalar [0xfe, 0xff, 0x00, 0xe9]
example: scalar [0xff, 0xfe, 0, 0, 0xe9, 0, 0, 0]
example: scalar [0, 0, 0xfe, 0xff, 0, 0, 0, 0xe9]
example: Yaml.loadBytes (Bytes.fromList [0x61, 0, 0x62, 0]) = Ok (YamlData.String "ab")
example: Yaml.loadBytes (Bytes.fromList [0, 0x61, 0, 0x62]) = Ok (YamlData.String "ab")
example: Yaml.loadBytes (Bytes.fromList [0x61, 0, 0, 0, 0x62, 0, 0, 0]) = Ok (YamlData.String "ab")
example: Yaml.loadBytes (Bytes.fromList [0, 0, 0, 0x61, 0, 0, 0, 0x62]) = Ok (YamlData.String "ab")
example: Yaml.loadBytes (Bytes.fromList [
  0xff,
  0xfe,
  0x3d,
  0xd8,
  0,
  0xde
]) = Ok (YamlData.String "😀")
example: Yaml.loadBytes (Bytes.fromList [
  0xfe,
  0xff,
  0xd8,
  0x3d,
  0xde,
  0
]) = Ok (YamlData.String "😀")
example: Yaml.loadBytes (Bytes.fromList [
  0xff,
  0xfe,
  0,
  0,
  0,
  0xf6,
  1,
  0
]) = Ok (YamlData.String "😀")

let bad bytes offset =
  match Yaml.parseBytes (Bytes.fromList bytes) with
  | Err error ->
    error.kind = YamlTypes.InvalidEncoding && Option.map (fun span ->
      span.start.byte) error.primary = Some offset
  | _ -> false
example: bad [255] 0
example: bad [0xc0, 0xaf] 0
example: bad [0xed, 0xa0, 0x80] 0
example: bad [0xf4, 0x90, 0x80, 0x80] 0
example: bad [0xe2, 0x82] 0
example: bad [0xff, 0xfe, 0x61] 2
example: bad [0xff, 0xfe, 0, 0xd8] 2
example: bad [0xff, 0xfe, 0, 0xdc] 2
example: bad [0, 0, 0xfe, 0xff, 0, 0x11, 0, 0] 4
example: bad [0xef, 0xbb, 0xbf, 0] 3
example: bad [0x7f] 0
example: bad [0xef, 0xbf, 0xbe] 0

let utf16 bytes =
  Bytes.fromList (255 :: 254 :: List.concat (List.map (fun byte -> [byte, 0]) bytes))

let duplicate =
  match Yaml.loadBytes (utf16 [97, 58, 32, 49, 13, 10, 97, 58, 32, 50]) with
  | Err error ->
    error.kind = YamlTypes.DuplicateKey && Option.map (fun span ->
      span.start) error.primary = Some {
      byte = 14,
      column = 1,
      line = 2
    } && Option.map (fun span ->
      span.start) error.secondary = Some { byte = 2, column = 1, line = 1 }
  | _ -> false
example: duplicate
example: (match Yaml.load "é: 1\r\né: 2" with
| Err error ->
  Option.map (fun span -> span.start) error.primary = Some { byte = 7, column = 1, line = 2 }
| _ -> false)
example: (match Yaml.parse "# comment\n" with
| Ok document -> (YamlDocument.span document).start = { byte = 10, column = 1, line = 2 }
| _ -> false)
example: (match Yaml.parse "\"\\u0041\"" with
| Ok document ->
  YamlDocument.spelling document (YamlDocument.root document) = Some (Bytes.fromString "\"\\u0041\"")
| _ -> false)
