module YamlSource

internal type Point = { index : Int, position : YamlTypes.Position }

internal type Input = { bytes : Bytes, encoding : Int, original : Bytes, points : Array Point }

let at bytes index = Option.withDefault (-1) (Bytes.get index bytes)

let word bytes index little =
  if little then
    at bytes index + 256 * at bytes (index + 1)
  else
    256 * at bytes index + at bytes (index + 1)

let dword bytes index little =
  if little then
    word bytes index true + 65536 * word bytes (index + 2) true
  else
    65536 * word bytes index false + word bytes (index + 2) false

let detected bytes =
  if at bytes 0 = 0 && at bytes 1 = 0 && at bytes 2 = 254 && at bytes 3 = 255 then
    (4, 4)
  else if at bytes 0 = 255 && at bytes 1 = 254 && at bytes 2 = 0 && at bytes 3 = 0 then
    (3, 4)
  else if at bytes 0 = 254 && at bytes 1 = 255 then
    (2, 2)
  else if at bytes 0 = 255 && at bytes 1 = 254 then
    (1, 2)
  else if at bytes 0 = 239 && at bytes 1 = 187 && at bytes 2 = 191 then
    (0, 3)
  else if at bytes 0 = 0 && at bytes 1 = 0 && at bytes 2 = 0 then
    (4, 0)
  else if at bytes 1 = 0 && at bytes 2 = 0 && at bytes 3 = 0 then
    (3, 0)
  else if at bytes 0 = 0 && at bytes 1 >= 0 then
    (2, 0)
  else if at bytes 0 >= 0 && at bytes 1 = 0 then (1, 0) else (0, 0)

let continuation byte = byte >= 128 && byte <= 191

let utf8 bytes index =
  let a = at bytes index
  let b = at bytes (index + 1)
  let c = at bytes (index + 2)
  let d = at bytes (index + 3)
  if a < 128 then
    Some (a, 1)
  else if a >= 194 && a <= 223 && continuation b then
    Some ((a - 192) * 64 + b - 128, 2)
  else if a >= 224 && a <= 239 && continuation b && continuation c && (a <> 224 || b >= 160) && (a <> 237 || b < 160) then
    Some ((a - 224) * 4096 + (b - 128) * 64 + c - 128, 3)
  else if a >= 240 && a <= 244 && continuation b && continuation c && continuation d && (a <> 240 || b >= 144) && (a <> 244 || b < 144) then
    Some ((a - 240) * 262144 + (b - 128) * 4096 + (c - 128) * 64 + d - 128, 4)
  else
    None

let scalar bytes encoding index =
  if encoding = 0 then
    utf8 bytes index
  else if encoding <= 2 then
    if index + 1 >= Bytes.length bytes then
      None
    else
      let a = word bytes index (encoding = 1)
      if a >= 55296 && a <= 56319 then
        if index + 3 >= Bytes.length bytes then
          None
        else
          let b = word bytes (index + 2) (encoding = 1)
          if b < 56320 || b > 57343 then None else Some (65536 + (a - 55296) * 1024 + b - 56320, 4)
      else if a >= 56320 && a <= 57343 then None else Some (a, 2)
  else if index + 3 >= Bytes.length bytes then
    None
  else
    let code = dword bytes index (encoding = 3)
    if code > 1114111 || (code >= 55296 && code <= 57343) then None else Some (code, 4)

let printable code =
  code = 9 || code = 10 || code = 13 || code = 133 || (code >= 32 && code <= 126) || (code >= 160 && code <= 55295) || (code >= 57344 && code <= 65533) || (code >= 65536 && code <= 1114111)

let append bytes index output =
  if index = Bytes.length bytes then
    output
  else
    append bytes (index + 1) (Bytes.unsafeGet index bytes :: output)

decode : Bytes -> Int -> Int -> Int -> Int -> Int -> Int -> List Int -> Array Point -> Result Input YamlTypes.Error
let decode original encoding offset index line column count output points =
  let position = { byte = offset, column = column, line = line }
  let points =
    if count % 64 = 0 || offset = Bytes.length original then
      Array.push { index = index, position = position } points
    else
      points
  if offset = Bytes.length original then
    Ok {
      bytes = Bytes.fromList (List.reverse output),
      encoding = encoding,
      original = original,
      points = points
    }
  else
    match scalar original encoding offset with
    | None -> Err { (YamlTypes.error YamlTypes.InvalidEncoding "invalid YAML Unicode encoding") with
      primary = Some { finish = { position with byte = offset + 1 }, start = position }
    }
    | Some (code, width) ->
      if not (printable code) then
        Err { (YamlTypes.error YamlTypes.InvalidEncoding "character is not permitted in YAML") with
          primary = Some {
            finish = { position with byte = offset + width, column = column + 1 },
            start = position
          }
        }
      else
        let code = if code = 13 then 10 else code
        let consumed =
          if code = 10 && (match scalar original encoding offset with
          | Some (13, _) -> true
          | _ -> false) then
            match scalar original encoding (offset + width) with
            | Some (10, nextWidth) -> width + nextWidth
            | _ -> width
          else
            width
        let bytes =
          Bytes.fromString (Char.toString (Option.withDefault '\u{FFFD}' (Char.fromCode code)))
        let points =
          if consumed > width then
            Array.push {
              index = index + Bytes.length bytes,
              position = { byte = offset + consumed, column = 1, line = line + 1 }
            } points
          else
            points
        decode original encoding (offset + consumed) (index + Bytes.length bytes) (if code = 10 then
          line + 1
        else
          line) (if code = 10 then 1 else column + 1) (count + 1) (append bytes 0 output) points

internal read : YamlTypes.Options -> Bytes -> Result Input YamlTypes.Error
let read options bytes =
  match YamlTypes.validate options with
  | Err error -> Err error
  | Ok _ ->
    if Bytes.length bytes > options.maxBytes then
      Err (YamlTypes.error YamlTypes.LimitExceeded "YAML input exceeds byte limit")
    else
      let (encoding, start) = detected bytes
      decode bytes encoding start 0 1 1 0 [] Array.empty

let checkpoint points index low high =
  if low + 1 >= high then
    Array.unsafeGet low points
  else
    let middle = low + (high - low) / 2
    if (Array.unsafeGet middle points).index <= index then
      checkpoint points index middle high
    else
      checkpoint points index low middle

let positionFrom input target index position =
  if index >= target then
    position
  else
    match utf8 input.bytes index with
    | None -> position
    | Some (code, width) ->
      let rawWidth =
        if input.encoding = 0 then width else if input.encoding > 2 || code > 65535 then 4 else 2
      positionFrom input target (index + width) {
        byte = position.byte + rawWidth,
        column = if code = 10 then 1 else position.column + 1,
        line = if code = 10 then position.line + 1 else position.line
      }

internal position : Input -> Int -> YamlTypes.Position
let position input index =
  let index =
    if index < 0 then
      0
    else if index > Bytes.length input.bytes then Bytes.length input.bytes else index
  let point = checkpoint input.points index 0 (Array.length input.points)
  positionFrom input index point.index point.position

internal span : Input -> Int -> Int -> YamlTypes.Span
let span input start finish = { finish = position input finish, start = position input start }

internal issue : Input -> Int -> YamlTypes.ErrorKind -> Int -> Int -> String -> YamlTypes.Error
let issue input document kind start finish message = { (YamlTypes.error kind message) with
  document = document,
  primary = Some (span input start finish)
}
