module Deflate

/// Raw DEFLATE has no framing checksum.
public compress : Bytes -> Result Bytes Compression.Error
let compress input = Compression.compress Compression.RawDeflate input

public compressWith : Compression.EncodeOptions -> Bytes -> Result Bytes Compression.Error
let compressWith options input = Compression.compressWith Compression.RawDeflate options input

public decompress : Bytes -> Result Bytes Compression.Error
let decompress input = Compression.decompress Compression.RawDeflate input

public decompressWith : Compression.DecodeOptions -> Bytes -> Result Bytes Compression.Error
let decompressWith options input = Compression.decompressWith Compression.RawDeflate options input

public encoder : Compression.EncodeOptions -> Result Compression.Encoder Compression.Error
let encoder options = Compression.encoder Compression.RawDeflate options

public decoder : Compression.DecodeOptions -> Result Compression.Decoder Compression.Error
let decoder options = Compression.decoder Compression.RawDeflate options
