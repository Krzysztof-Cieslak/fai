module Base64Url

/// Select whether the final group carries '=' padding.
public type EncodeOptions = { padding : Encoding.OutputPadding }

/// Explicit padding acceptance; only the URL-safe alphabet is accepted.
public type DecodeOptions = { padding : Encoding.Padding }

/// URL-safe output omits padding by default.
public encodeOptions : EncodeOptions
let encodeOptions = { padding = Encoding.Unpadded }

/// Require unpadded URL-safe input by default.
public decodeOptions : DecodeOptions
let decodeOptions = { padding = Encoding.ForbidPadding }

/// Start an incremental URL-safe Base64 encoder.
public encoder : EncodeOptions -> Encoding.Encoder
let encoder options = Encoding.newEncoder EncodingCore.base64Url options.padding

/// Start an incremental URL-safe Base64 decoder.
public decoder : DecodeOptions -> Encoding.Decoder
let decoder options = Encoding.newDecoder EncodingCore.base64Url false options.padding

/// Encode URL-safe ASCII text with explicit padding.
public encodeWith : EncodeOptions -> Bytes -> String
let encodeWith options input = Encoding.encode (encoder options) input

/// URL-safe Base64 with the -_ alphabet and omitted padding.
public encode : Bytes -> String
let encode input = encodeWith encodeOptions input

/// Decode URL-safe ASCII bytes with explicit padding acceptance.
public decodeBytesWith : DecodeOptions -> Bytes -> Result Bytes Encoding.Error
let decodeBytesWith options input = Encoding.decode (decoder options) input

/// Decode URL-safe text with explicit padding acceptance.
public decodeWith : DecodeOptions -> String -> Result Bytes Encoding.Error
let decodeWith options input = decodeBytesWith options (Bytes.fromString input)

/// Decode unpadded URL-safe ASCII bytes, validating unused trailing bits.
public decodeBytes : Bytes -> Result Bytes Encoding.Error
let decodeBytes input = decodeBytesWith decodeOptions input

/// Decode unpadded URL-safe text; error offsets count UTF-8 bytes.
public decode : String -> Result Bytes Encoding.Error
let decode input = decodeWith decodeOptions input

/// Exact output length, rejecting negative input counts and Int overflow.
public encodedLengthWith : EncodeOptions -> Int -> Result Int Encoding.Error
let encodedLengthWith options count =
  Encoding.lengthFor EncodingCore.base64Url options.padding count

/// Exact unpadded output length for a nonnegative input byte count.
public encodedLength : Int -> Result Int Encoding.Error
let encodedLength count = encodedLengthWith encodeOptions count
