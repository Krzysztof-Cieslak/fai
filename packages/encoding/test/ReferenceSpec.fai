module EncodingReferenceSpec

// Independent vectors from Python's standard base64 module over bytes(range(256)).
let input = Bytes.fromList (List.range 0 256)

let hex =
  ""

let base64 =
  ""

let base64Url =
  "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn-AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmqq6ytrq-wsbKztLW2t7i5uru8vb6_wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t_g4eLj5OXm5-jp6uvs7e7v8PHy8_T19vf4-fr7_P3-_w"

let base32 =
  ""

let base32Hex =
  ""

let case001 _ =
  let testActual = Hex.encode input
  let testExpected = hex
  Expect.equal (Test.string).show testExpected testActual

let case002 _ =
  let testActual = Hex.decode hex = Ok input
  Expect.isTrue "Hex.decode hex = Ok input" testActual

let case003 _ =
  let testActual = Base64.encode input
  let testExpected = base64
  Expect.equal (Test.string).show testExpected testActual

let case004 _ =
  let testActual = Base64.decode base64 = Ok input
  Expect.isTrue "Base64.decode base64 = Ok input" testActual

let case005 _ =
  let testActual = Base64Url.encode input
  let testExpected = base64Url
  Expect.equal (Test.string).show testExpected testActual

let case006 _ =
  let testActual = Base64Url.decode base64Url = Ok input
  Expect.isTrue "Base64Url.decode base64Url = Ok input" testActual

let case007 _ =
  let testActual = Base32.encode input
  let testExpected = base32
  Expect.equal (Test.string).show testExpected testActual

let case008 _ =
  let testActual = Base32.decode base32 = Ok input
  Expect.isTrue "Base32.decode base32 = Ok input" testActual

let case009 _ =
  let testActual = Base32Hex.encode input
  let testExpected = base32Hex
  Expect.equal (Test.string).show testExpected testActual

let case010 _ =
  let testActual = Base32Hex.decode base32Hex = Ok input
  Expect.isTrue "Base32Hex.decode base32Hex = Ok input" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "EncodingReferenceSpec" [
  Test.test "Hex.encode input = hex" case001,
  Test.test "Hex.decode hex = Ok input" case002,
  Test.test "Base64.encode input = base64" case003,
  Test.test "Base64.decode base64 = Ok input" case004,
  Test.test "Base64Url.encode input = base64Url" case005,
  Test.test "Base64Url.decode base64Url = Ok input" case006,
  Test.test "Base32.encode input = base32" case007,
  Test.test "Base32.decode base32 = Ok input" case008,
  Test.test "Base32Hex.encode input = base32Hex" case009,
  Test.test "Base32Hex.decode base32Hex = Ok input" case010
]
