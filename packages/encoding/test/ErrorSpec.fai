example: Encoding.errorToString {
  kind = Encoding.InvalidLength,
  message = "incomplete encoding group",
  offset = Some 3
} = "incomplete encoding group at byte 3"
example: Encoding.errorToString {
  kind = Encoding.Overflow,
  message = "too long",
  offset = None
} = "too long"
