module DiffFailureSpec

let bad text = Result.isErr (UnifiedDiff.parse text)
example: bad "--- a\n+++ b\n@@ -0,1 +1,1 @@\n-x\n+y\n"
example: bad "--- a\n+++ b\n@@ -1,-1 +1,1 @@\n-x\n+y\n"
example: bad "--- a\n+++ b\n@@ -1,9223372036854775807 +1,1 @@\n-x\n+y\n"
example: bad "--- a\n+++ b\n@@ -1,1 +1,1 @@\n-x\n+y\n+extra\n"
example: bad "--- a\n+++ b\n@@ -1,1 +1,1 @@\n-x\n\\ No newline at end of file\n\\ No newline at end of file\n+y\n"
example: bad "--- a\n+++ b\n@@ -1,2 +1,2 @@\n x\n\\ No newline at end of file\n y\n"
example: bad "--- \"\\377\"\n+++ b\n"
example: bad "--- \"a\"junk\n+++ b\n"
example: bad "diff --git a/a b/a\nnew file mode 100644\n--- a/a\n+++ b/a\n"
example: bad "diff --git a/a b/a\nnew file mode 120000\n--- /dev/null\n+++ b/a\n"
example: bad "diff --git a/a b/a\nrename from a\nrename to b\n"
example: bad "diff --cc a\n"
example: bad "--- /dev/null\n+++ /dev/null\n"
example: bad "--- \"a\\000b\"\n+++ b\n"
example: bad "--- \"a\\012b\"\n+++ b\n"
example: UnifiedDiff.parse "" = Ok [||]
example: UnifiedDiff.parse "--- a\n+++ b\n@@ -1 +1 @@ function name\n-x\n+y\n" |> Result.isOk
example: UnifiedDiff.parse "--- \"a\\040b\"\n+++ \"a\\040b\"\n" |> Result.isOk

let text = "--- a\n+++ a\n@@ -1,1 +1,1 @@\n-x\n+y\n"

let parsed = Result.withDefault Array.empty (UnifiedDiff.parse text)

let file = Array.unsafeGet 0 parsed
example: UnifiedDiff.parseWith { UnifiedDiff.limits with maxFiles = 0 } text |> Result.isErr
example: UnifiedDiff.parseWith { UnifiedDiff.limits with maxHunks = 0 } text |> Result.isErr
example: UnifiedDiff.parseWith { UnifiedDiff.limits with maxLines = 1 } text |> Result.isErr
example: UnifiedDiff.parseWith { UnifiedDiff.limits with maxInputBytes = 1 } text |> Result.isErr
example: UnifiedDiff.toStringWith { UnifiedDiff.limits with
  maxOutputBytes = 1
} parsed |> Result.isErr
example: Patch.applyFile file None |> Result.isErr
example: Patch.applyFileWith Patch.limits (Patch.Relocate (-1)) file (Some "x\n") |> Result.isErr
example: Patch.applyFileWith { Patch.limits with
  maxSearchWork = 0
} Patch.Strict file (Some "x\n") |> Result.isErr
example: Patch.applyFileWith { Patch.limits with
  maxOutputBytes = 1
} Patch.Strict file (Some "x\n") |> Result.isErr
example: Patch.applyBatch parsed [| ("a", "x\n"), ("a", "x\n") |] |> Result.isErr
example: Patch.applyBatch (Array.append parsed parsed) [| ("a", "x\n") |] |> Result.isErr
example: Patch.applyBatch parsed [|
  ("a", "x\n")
|] = Ok [| { path = "a", relocations = Array.empty, text = Some "y\n" } |]
example: Patch.applyBatch (Array.append parsed [|
  { file with newPath = Some "other", oldPath = Some "other" }
|]) [| ("a", "x\n") |] |> Result.isErr

let invalidKey _ = 1 / 0
example: Diff.diffByWith { Diff.limits with
  maxWork = -1
} Diff.options invalidKey [| 1 |] [| 2 |] |> Result.isErr
example: DiffText.compareWith { DiffText.limits with
  unicode = { DiffText.limits.unicode with maxWork = -1 }
} DiffText.options "" "" |> Result.isErr
example: DiffText.linesWith { DiffText.limits with
  sequence = { Diff.limits with maxInputItems = 1 }
} "a\nb\n" |> Result.isErr
example: DiffInline.compareWith { DiffText.limits with
  unicode = { DiffText.limits.unicode with maxMappings = 0 }
} DiffText.options DiffInline.Graphemes "x" "y" |> Result.isErr
