module DiffInlineSpec

import unicode.UnicodeNormalize

let kinds options granularity old new =
  Result.map (fun detail ->
    Array.map (fun change ->
      change.kind) detail.changes) (DiffInline.compareWith DiffText.limits options granularity old new)
example: kinds DiffText.options DiffInline.Graphemes "a👩‍💻b" "a👩‍💻c" = Ok [|
  DiffText.Equal,
  DiffText.Deleted,
  DiffText.Inserted
|]
example: kinds { DiffText.options with
  case = DiffText.UnicodeInsensitive
} DiffInline.Graphemes "ß" "ss" = Ok [| DiffText.Equivalent |]
example: kinds { DiffText.options with
  normalization = Some UnicodeNormalize.NFC
} DiffInline.Graphemes "á" "a\u{301}" = Ok [| DiffText.Equivalent |]
example: kinds { DiffText.options with
  whitespace = DiffText.CollapseRuns
} DiffInline.Words "a  b" "a b" = Ok [| DiffText.Equivalent |]
example: kinds { DiffText.options with
  whitespace = DiffText.IgnoreTrailing
} DiffInline.Graphemes "a \n" "a\n" = Ok [| DiffText.Equivalent |]
example: kinds { DiffText.options with
  whitespace = DiffText.IgnoreAll
} DiffInline.Graphemes "a\r\n" "a\n" <> Ok [| DiffText.Equivalent |]
example: kinds { DiffText.options with
  whitespace = DiffText.IgnoreAll
} DiffInline.Graphemes "  " "" = Ok [| DiffText.Equivalent |]
example: (match DiffInline.compareWith { DiffText.limits with
  sequence = { Diff.limits with maxWork = 0 }
} { DiffText.options with
  sequence = { Diff.options with fallback = Diff.ReplaceRemainder }
} DiffInline.Graphemes "a" "b" with
| Err _ -> false
| Ok detail -> detail.quality = Diff.Coarse)
