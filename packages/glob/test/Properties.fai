module GlobProperties

let token value =
  match Int.and value 7 with
  | 0 -> [97]
  | 1 -> [98]
  | 2 -> [63]
  | 3 -> [42, 97]
  | 4 -> [47]
  | _ -> [99]

let pattern values = List.concat (List.map token (List.take 6 values))

let text values =
  97 :: List.map (fun value ->
    if Int.and value 3 = 3 then 47 else 97 + Int.and value 3) (List.take 8 values)

// Small exhaustive-style reference for the nonrecursive wildcard language.
let reference pattern input =
  match pattern with
  | [] -> List.isEmpty input
  | 42 :: rest ->
    reference rest input || (match input with
    | byte :: tail -> byte <> 47 && reference pattern tail
    | [] -> false)
  | byte :: rest ->
    match input with
    | found :: tail -> (byte = found || (byte = 63 && found <> 47)) && reference rest tail
    | [] -> false

let agrees values input =
  let source = pattern values
  match (Glob.compileBytes (Bytes.fromList source), Glob.candidateBytes (Bytes.fromList (text input))) with
  | (Ok compiled, Ok candidate) ->
    Glob.isMatch compiled candidate = reference source (Bytes.toList (Glob.candidateSpelling candidate))
  | _ -> false

let case001 testInput =
  let (values, input) = testInput
  let testActual = agrees values input
  Expect.isTrue "property: agrees values input" testActual

let normalized input =
  match Glob.candidateBytes (Bytes.fromList input) with
  | Err _ -> true
  | Ok candidate -> Glob.candidateBytes (Glob.candidateSpelling candidate) = Ok candidate

let case002 testInput =
  let input = testInput
  let testActual = normalized input
  Expect.isTrue "property: normalized input" testActual

let total input =
  match Glob.compileBytes (Bytes.fromList input) with
  | Ok compiled -> Glob.patternBytes compiled = Bytes.fromList input
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset <= List.length input

let case003 testInput =
  let input = testInput
  let testActual = total input
  Expect.isTrue "property: total input" testActual

let setExpected patterns candidate index output =
  match patterns with
  | [] -> List.reverse output
  | pattern :: rest ->
    setExpected rest candidate (index + 1) (if Glob.isMatch pattern candidate then
      index :: output
    else
      output)

let setAgrees first second input =
  match (Glob.compileBytes (Bytes.fromList (pattern first)), Glob.compileBytes (Bytes.fromList (pattern second)), Glob.candidateBytes (Bytes.fromList (text input))) with
  | (Ok first, Ok second, Ok candidate) ->
    let patterns = [first, second, first]
    match GlobSet.ofPatterns 1000 patterns with
    | Err _ -> false
    | Ok set -> GlobSet.matches set candidate = setExpected patterns candidate 0 []
  | _ -> false

let case004 testInput =
  let (first, second, input) = testInput
  let testActual = setAgrees first second input
  Expect.isTrue "property: setAgrees first second input" testActual

let ignoreTotal text =
  let bytes = Bytes.fromString text
  match Ignore.parse { base = Glob.root, name = "generated" } bytes with
  | Ok file -> Ignore.fileRuleCount file >= 0
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset <= Bytes.length bytes

let case005 testInput =
  let text = testInput
  let testActual = ignoreTotal text
  Expect.isTrue "property: ignoreTotal text" testActual

let matches pattern input =
  match (Glob.compile pattern, Glob.candidateBytes (Bytes.fromString input)) with
  | (Ok pattern, Ok input) -> Glob.isMatch pattern input
  | _ -> false

let case006 _ =
  let testActual =
    not (matches (String.joinArray "" (Array.repeat 100 "*a") ++ "b") (String.joinArray "" (Array.repeat 200 "a")))
  Expect.isTrue "not (matches (String.joinArray \"\" (Array.repeat 100 \"*a\") ++ \"b\") (String.joinArray \"\" (Array.repeat 200 \"a\")))" testActual

let case007 _ =
  let testActual =
    matches (String.joinArray "" (Array.repeat 100 "{a,b}")) (String.joinArray "" (Array.repeat 100 "a"))
  Expect.isTrue "matches (String.joinArray \"\" (Array.repeat 100 \"{a,b}\")) (String.joinArray \"\" (Array.repeat 100 \"a\"))" testActual

let case008 _ =
  let testActual =
    not (matches (String.joinArray "" (Array.repeat 100 "{a,b}")) (String.joinArray "" (Array.repeat 99 "a") ++ "c"))
  Expect.isTrue "not (matches (String.joinArray \"\" (Array.repeat 100 \"{a,b}\")) (String.joinArray \"\" (Array.repeat 99 \"a\") ++ \"c\"))" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "GlobProperties" [
  Test.property "property: agrees values input" (Test.tuple2 (Test.list Test.int) (Test.list Test.int)) case001,
  Test.property "property: normalized input" (Test.list Test.int) case002,
  Test.property "property: total input" (Test.list Test.int) case003,
  Test.property "property: setAgrees first second input" (Test.tuple3 (Test.list Test.int) (Test.list Test.int) (Test.list Test.int)) case004,
  Test.property "property: ignoreTotal text" Test.string case005,
  Test.test "not (matches (String.joinArray \"\" (Array.repeat 100 \"*a\") ++ \"b\") (String.joinArray \"\" (Array.repeat 200 \"a\")))" case006,
  Test.test "matches (String.joinArray \"\" (Array.repeat 100 \"{a,b}\")) (String.joinArray \"\" (Array.repeat 100 \"a\"))" case007,
  Test.test "not (matches (String.joinArray \"\" (Array.repeat 100 \"{a,b}\")) (String.joinArray \"\" (Array.repeat 99 \"a\") ++ \"c\"))" case008
]
