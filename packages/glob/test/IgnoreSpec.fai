module IgnoreSpec

let candidate path = Result.withDefault Glob.root (Glob.candidateBytes (Bytes.fromString path))

let file base text =
  Ignore.parse { base = candidate base, name = base ++ "/.gitignore" } (Bytes.fromString text)

let rules text =
  match file "" text with
  | Err _ -> Ignore.empty
  | Ok file -> Result.withDefault Ignore.empty (Ignore.append file Ignore.empty)

let ignored text path kind = Ignore.isIgnored (Ignore.decide (rules text) (candidate path) kind)

let case001 _ =
  let testActual = ignored "*.o\n" "a/b/file.o" FileSystem.RegularFile
  Expect.isTrue "ignored \"*.o\\n\" \"a/b/file.o\" FileSystem.RegularFile" testActual

let case002 _ =
  let testActual = not (ignored "/*.o\n" "a/b/file.o" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"/*.o\\n\" \"a/b/file.o\" FileSystem.RegularFile)" testActual

let case003 _ =
  let testActual = ignored "/file.o\n" "file.o" FileSystem.RegularFile
  Expect.isTrue "ignored \"/file.o\\n\" \"file.o\" FileSystem.RegularFile" testActual

let case004 _ =
  let testActual = ignored "doc/file\n" "doc/file" FileSystem.RegularFile
  Expect.isTrue "ignored \"doc/file\\n\" \"doc/file\" FileSystem.RegularFile" testActual

let case005 _ =
  let testActual = not (ignored "doc/file\n" "a/doc/file" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"doc/file\\n\" \"a/doc/file\" FileSystem.RegularFile)" testActual

let case006 _ =
  let testActual = ignored "build/\n!build/keep.txt\n" "build/keep.txt" FileSystem.RegularFile
  Expect.isTrue "ignored \"build/\\n!build/keep.txt\\n\" \"build/keep.txt\" FileSystem.RegularFile" testActual

let case007 _ =
  let testActual =
    not (ignored "build/*\n!build/keep.txt\n" "build/keep.txt" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"build/*\\n!build/keep.txt\\n\" \"build/keep.txt\" FileSystem.RegularFile)" testActual

let case008 _ =
  let testActual = ignored "build/\n" "build" FileSystem.Directory
  Expect.isTrue "ignored \"build/\\n\" \"build\" FileSystem.Directory" testActual

let case009 _ =
