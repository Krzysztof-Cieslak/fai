  Expect.isTrue "not (ignored \"build/\\n\" \"build\" FileSystem.SymbolicLink)" testActual

let case010 _ =
  let testActual = not (ignored "build/\n" "build" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"build/\\n\" \"build\" FileSystem.RegularFile)" testActual

let case011 _ =
  let testActual = ignored "build\n" "build" FileSystem.SymbolicLink
  Expect.isTrue "ignored \"build\\n\" \"build\" FileSystem.SymbolicLink" testActual

let case012 _ =
  let testActual = ignored "cache/\n" "a/cache/item" FileSystem.RegularFile
  Expect.isTrue "ignored \"cache/\\n\" \"a/cache/item\" FileSystem.RegularFile" testActual

let case013 _ =
  let testActual = ignored "a/**/b\n" "a/b" FileSystem.RegularFile
  Expect.isTrue "ignored \"a/**/b\\n\" \"a/b\" FileSystem.RegularFile" testActual

let case014 _ =
  let testActual = ignored "a/**/b\n" "a/x/y/b" FileSystem.RegularFile
  Expect.isTrue "ignored \"a/**/b\\n\" \"a/x/y/b\" FileSystem.RegularFile" testActual

let case015 _ =
  let testActual = not (ignored "a/**/b\n" "a/xb" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"a/**/b\\n\" \"a/xb\" FileSystem.RegularFile)" testActual

let case016 _ =
  let testActual = ignored "a***b\n" "axxb" FileSystem.RegularFile
  Expect.isTrue "ignored \"a***b\\n\" \"axxb\" FileSystem.RegularFile" testActual

let case017 _ =
  let testActual = not (ignored "a**/b\n" "a/x/b" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"a**/b\\n\" \"a/x/b\" FileSystem.RegularFile)" testActual

let case018 _ =
  let testActual = not (ignored "a/**\\/b\n" "a/b" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"a/**\\\\/b\\n\" \"a/b\" FileSystem.RegularFile)" testActual

let case019 _ =
  let testActual = ignored "a/**\\/b\n" "a/x/b" FileSystem.RegularFile
  Expect.isTrue "ignored \"a/**\\\\/b\\n\" \"a/x/b\" FileSystem.RegularFile" testActual

let case020 _ =
  let testActual = ignored "a/***/b\n" "a/x/y/b" FileSystem.RegularFile
  Expect.isTrue "ignored \"a/***/b\\n\" \"a/x/y/b\" FileSystem.RegularFile" testActual

let case021 _ =
  let testActual = ignored "**/file\n" "file" FileSystem.RegularFile
  Expect.isTrue "ignored \"**/file\\n\" \"file\" FileSystem.RegularFile" testActual

let case022 _ =
  let testActual = ignored "{a,b}\n" "{a,b}" FileSystem.RegularFile
  Expect.isTrue "ignored \"{a,b}\\n\" \"{a,b}\" FileSystem.RegularFile" testActual

let case023 _ =
  let testActual = not (ignored "{a,b}\n" "a" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"{a,b}\\n\" \"a\" FileSystem.RegularFile)" testActual

let case024 _ =
  let testActual = ignored "#comment\n\\#file\n" "#file" FileSystem.RegularFile
  Expect.isTrue "ignored \"#comment\\n\\\\#file\\n\" \"#file\" FileSystem.RegularFile" testActual

let case025 _ =
  let testActual = not (ignored "#comment\n" "#comment" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"#comment\\n\" \"#comment\" FileSystem.RegularFile)" testActual

let case026 _ =
  let testActual = ignored "\\!file\n" "!file" FileSystem.RegularFile
  Expect.isTrue "ignored \"\\\\!file\\n\" \"!file\" FileSystem.RegularFile" testActual

let case027 _ =
  let testActual = ignored "foo   \n" "foo" FileSystem.RegularFile
  Expect.isTrue "ignored \"foo \\n\" \"foo\" FileSystem.RegularFile" testActual

let case028 _ =
  let testActual = ignored "foo\\ \n" "foo " FileSystem.RegularFile
  Expect.isTrue "ignored \"foo\\\\ \\n\" \"foo \" FileSystem.RegularFile" testActual

let case029 _ =
  let testActual = ignored "foo\\  \n" "foo " FileSystem.RegularFile
  Expect.isTrue "ignored \"foo\\\\ \\n\" \"foo \" FileSystem.RegularFile (2)" testActual

let case030 _ =
  let testActual = not (ignored "foo\\ \n" "foo" FileSystem.RegularFile)
  Expect.isTrue "not (ignored \"foo\\\\ \\n\" \"foo\" FileSystem.RegularFile)" testActual

let case031 _ =
  let testActual = ignored " foo\n" " foo" FileSystem.RegularFile
  Expect.isTrue "ignored \" foo\\n\" \" foo\" FileSystem.RegularFile" testActual

let case032 _ =
