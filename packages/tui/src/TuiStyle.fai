module TuiStyle

public type Color =
  | Default
  | Indexed Int
  | Rgb Int Int Int

public type Style = {
  background : Color,
  bold : Bool,
  dim : Bool,
  foreground : Color,
  italic : Bool,
  reverse : Bool,
  underline : Bool
}

public type Theme = {
  accent : Style,
  error : Style,
  muted : Style,
  normal : Style,
  selected : Style
}

public normal : Style
let normal = {
  background = Default,
  bold = false,
  dim = false,
  foreground = Default,
  italic = false,
  reverse = false,
  underline = false
}

public defaultTheme : Theme
let defaultTheme = {
  accent = { normal with bold = true, foreground = Indexed 6 },
  error = { normal with foreground = Indexed 1 },
  muted = { normal with dim = true },
  normal = normal,
  selected = { normal with reverse = true }
}

let clamp n = if n < 0 then 0 else if n > 255 then 255 else n

let color foreground value =
  let prefix = if foreground then "38" else "48"
  match value with
  | Default -> if foreground then "39" else "49"
  | Indexed n -> prefix ++ ";5;" ++ Int.toString (clamp n)
  | Rgb r g b ->
    prefix ++ ";2;" ++ Int.toString (clamp r) ++ ";" ++ Int.toString (clamp g) ++ ";" ++ Int.toString (clamp b)

/// Complete SGR state, independent of the terminal's previous styling.
public ansi : Style -> String
let ansi style =
  "\u{1b}[0;" ++ color true style.foreground ++ ";" ++ color false style.background ++ (if style.bold then
    ";1"
  else
    "") ++ (if style.dim then
    ";2"
  else
    "") ++ (if style.italic then
    ";3"
  else
    "") ++ (if style.underline then ";4" else "") ++ (if style.reverse then ";7" else "") ++ "m"
example: ansi normal = "\u{1b}[0;39;49m"
