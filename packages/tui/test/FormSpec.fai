module FormSpec

let optional = Form.optional (Form.int (Form.named "optional" "Optional"))

let case001 _ =
  let testActual = Form.decode optional (Form.initial optional) = Ok None
  Expect.isTrue "Form.decode optional (Form.initial optional) = Ok None" testActual

let case002 _ =
  let testActual =
    Form.decode optional (Form.update (Form.Edited "optional" "12") (Form.initial optional)) = Ok (Some 12)
  Expect.isTrue "Form.decode optional (Form.update (Form.Edited \"optional\" \"12\") (Form.initial optional)) = Ok (Some 12)" testActual

let case003 _ =
  let testActual =
    Set.member "optional" (Form.update (Form.Edited "optional" "-") (Form.withValidation Form.OnChange (Form.initial optional))).touched
  Expect.isTrue "Set.member \"optional\" (Form.update (Form.Edited \"optional\" \"-\") (Form.withValidation Form.OnChange (Form.initial optional))).touched" testActual

let case004 _ =
  let testActual =
    not (Set.member "optional" (Form.update (Form.Blurred "optional") (Form.withValidation Form.OnSubmit (Form.initial optional))).touched)
  Expect.isTrue "not (Set.member \"optional\" (Form.update (Form.Blurred \"optional\") (Form.withValidation Form.OnSubmit (Form.initial optional))).touched)" testActual

let definition =
  Form.map2 (fun host port -> {
    host = host,
    port = port
  }) (Form.required (Form.text (Form.named "host" "Host"))) (Form.range 1 65535 (Form.int { Form.named "port" "Port" with
    initial = "5432"
  }))

let empty = Form.initial definition

let invalidPort =
  Form.update (Form.Edited "port" "-") (Form.update (Form.Edited "host" "localhost") empty)

let case005 _ =
  let testActual =
    (match TuiCmd.operations (Form.handle (Ui.id "form") definition Form.Submit invalidPort).command with
    | [TuiCmd.Focus id] -> id = Form.fieldId (Ui.id "form") "port"
    | _ -> false)
  Expect.isTrue "(match TuiCmd.operations (Form.handle (Ui.id \"form\") definition Form.Submit invalidPort).command with | [TuiCmd.Focus id] -> id = Form.fieldId (Ui.id \"form\")…" testActual

let rendered state =
  Result.map (fun frame ->
    String.joinArray "\n" (TuiScreen.lines frame.screen)) (TuiLayout.render (TuiLayout.context 80 20) TuiState.empty (Form.view (Ui.id "form") [] definition state))

let case006 _ =
  let testActual =
    Result.map (fun text -> String.contains text "This field is required") (rendered empty)
  let testExpected = Ok false
  Expect.equal ((Test.result Test.bool Test.string)).show testExpected testActual

let case007 _ =
  let testActual =
    Result.map (fun text ->
      String.contains text "This field is required") (rendered (Form.update (Form.Blurred "host") empty))
  let testExpected = Ok true
  Expect.equal ((Test.result Test.bool Test.string)).show testExpected testActual

let case008 _ =
  let testActual =
    Result.map (fun text ->
      String.contains text "This field is required") (rendered (Form.update (Form.Blurred "host") (Form.withValidation Form.OnSubmit empty)))
  let testExpected = Ok false
  Expect.equal ((Test.result Test.bool Test.string)).show testExpected testActual

let valid = Form.update (Form.Edited "host" "localhost") empty

let case009 _ =
  let testActual = Form.decode definition valid = Ok { host = "localhost", port = 5432 }
  Expect.isTrue "Form.decode definition valid = Ok { host = \"localhost\", port = 5432 }" testActual

let case010 _ =
  let testActual = Form.dirty valid
  Expect.isTrue "Form.dirty valid" testActual

let case011 _ =
  let testActual = not (Form.dirty empty)
  Expect.isTrue "not (Form.dirty empty)" testActual

let case012 _ =
  let testActual = List.length (Form.errors definition empty)
  let testExpected = 1
  Expect.equal (Test.int).show testExpected testActual

let case013 _ =
  let testActual = List.length (Form.errors definition (Form.update (Form.Edited "port" "-") empty))
  let testExpected = 2
  Expect.equal (Test.int).show testExpected testActual

let case014 _ =
  let testActual = Dict.get "port" (Form.update (Form.Edited "port" "-") empty).values
  let testExpected = Some "-"
  Expect.equal ((Test.option Test.string)).show testExpected testActual

let case015 _ =
  let testActual =
    Result.isErr (Form.decode definition (Form.update (Form.Edited "port" "9223372036854775808") valid))
  Expect.isTrue "Result.isErr (Form.decode definition (Form.update (Form.Edited \"port\" \"9223372036854775808\") valid))" testActual

let case016 _ =
  let testActual =
    Result.isErr (Form.decode definition (Form.update (Form.Edited "port" "65536") valid))
  Expect.isTrue "Result.isErr (Form.decode definition (Form.update (Form.Edited \"port\" \"65536\") valid))" testActual

let case017 _ =
  let testActual = (Form.handle (Ui.id "form") definition Form.Submit empty).state.submitted
  Expect.isTrue "(Form.handle (Ui.id \"form\") definition Form.Submit empty).state.submitted" testActual

let case018 _ =
  let testActual =
    (Form.handle (Ui.id "form") definition Form.Submit valid).value = Some {
      host = "localhost",
      port = 5432
    }
  Expect.isTrue "(Form.handle (Ui.id \"form\") definition Form.Submit valid).value = Some { host = \"localhost\", port = 5432 }" testActual

let case019 _ =
  let testActual =
    (Form.withErrors 0 [{ field = None, message = "obsolete" }] valid).serverErrors = []
  Expect.isTrue "(Form.withErrors 0 [{ field = None, message = \"obsolete\" }] valid).serverErrors = []" testActual

let case020 _ =
  let testActual =
    (Form.withErrors valid.revision [
      { field = Some "host", message = "unavailable" }
    ] valid).serverErrors = [{ field = Some "host", message = "unavailable" }]
  Expect.isTrue "(Form.withErrors valid.revision [ { field = Some \"host\", message = \"unavailable\" } ] valid).serverErrors = [{ field = Some \"host\", message = \"unavailable\" }]" testActual

let duplicate =
  Form.map2 (fun a b ->
    (a, b)) (Form.text (Form.named "same" "A")) (Form.text (Form.named "same" "B"))

let case021 _ =
  let testActual = Result.isErr (Form.validateDefinition duplicate)
  Expect.isTrue "Result.isErr (Form.validateDefinition duplicate)" testActual

let allInts = Form.int (Form.named "n" "Number")

let case022 testInput =
  let n = testInput
  let testActual =
    Form.decode allInts (Form.update (Form.Edited "n" (Int.toString n)) (Form.initial allInts)) = Ok n
  Expect.isTrue "property: Form.decode allInts (Form.update (Form.Edited \"n\" (Int.toString n)) (Form.initial allInts)) = Ok n" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "FormSpec" [
  Test.test "Form.decode optional (Form.initial optional) = Ok None" case001,
  Test.test "Form.decode optional (Form.update (Form.Edited \"optional\" \"12\") (Form.initial optional)) = Ok (Some 12)" case002,
  Test.test "Set.member \"optional\" (Form.update (Form.Edited \"optional\" \"-\") (Form.withValidation Form.OnChange (Form.initial optional))).touched" case003,
  Test.test "not (Set.member \"optional\" (Form.update (Form.Blurred \"optional\") (Form.withValidation Form.OnSubmit (Form.initial optional))).touched)" case004,
  Test.test "(match TuiCmd.operations (Form.handle (Ui.id \"form\") definition Form.Submit invalidPort).command with | [TuiCmd.Focus id] -> id = Form.fieldId (Ui.id \"form\")…" case005,
  Test.test "Result.map (fun text -> String.contains text \"This field is required\") (rendered empty) = Ok false" case006,
  Test.test "Result.map (fun text -> String.contains text \"This field is required\") (rendered (Form.update (Form.Blurred \"host\") empty)) = Ok true" case007,
  Test.test "Result.map (fun text -> String.contains text \"This field is required\") (rendered (Form.update (Form.Blurred \"host\") (Form.withValidation Form.OnSubmit empty)…" case008,
  Test.test "Form.decode definition valid = Ok { host = \"localhost\", port = 5432 }" case009,
  Test.test "Form.dirty valid" case010,
  Test.test "not (Form.dirty empty)" case011,
  Test.test "List.length (Form.errors definition empty) = 1" case012,
  Test.test "List.length (Form.errors definition (Form.update (Form.Edited \"port\" \"-\") empty)) = 2" case013,
  Test.test "Dict.get \"port\" (Form.update (Form.Edited \"port\" \"-\") empty).values = Some \"-\"" case014,
  Test.test "Result.isErr (Form.decode definition (Form.update (Form.Edited \"port\" \"9223372036854775808\") valid))" case015,
  Test.test "Result.isErr (Form.decode definition (Form.update (Form.Edited \"port\" \"65536\") valid))" case016,
  Test.test "(Form.handle (Ui.id \"form\") definition Form.Submit empty).state.submitted" case017,
  Test.test "(Form.handle (Ui.id \"form\") definition Form.Submit valid).value = Some { host = \"localhost\", port = 5432 }" case018,
  Test.test "(Form.withErrors 0 [{ field = None, message = \"obsolete\" }] valid).serverErrors = []" case019,
  Test.test "(Form.withErrors valid.revision [ { field = Some \"host\", message = \"unavailable\" } ] valid).serverErrors = [{ field = Some \"host\", message = \"unavailable\" }]" case020,
  Test.test "Result.isErr (Form.validateDefinition duplicate)" case021,
  Test.property "property: Form.decode allInts (Form.update (Form.Edited \"n\" (Int.toString n)) (Form.initial allInts)) = Ok n" Test.int case022
]
