module TomlCodecSpec

let roundTrip source =
  match Toml.parse source with
  | Err _ -> false
  | Ok document ->
    match Toml.toString (Toml.value document) with
    | Err _ -> false
    | Ok text -> Result.map Toml.value (Toml.parse text) = Ok (Toml.value document)
example: roundTrip "x = [1, 2, { a = 'b', c = [false, 3.0] }]\n[[items]]\na=2"
example: roundTrip "x=+inf\ny=-nan\nz=-0.0\na=1979-05-27T07:32Z"
example: roundTrip "'a.b'='literal'\nempty={}"
example: (match Toml.parse "x=1\ny='two'" with
| Ok document ->
  TomlDecode.decode (TomlDecode.map2 (fun x y ->
    (x, y)) (TomlDecode.field "x" TomlDecode.int) (TomlDecode.field "y" TomlDecode.string)) (Toml.value document) = Ok (1, "two")
| _ -> false)

let stringRoundTrip text =
  let value = TomlTypes.Table (Dict.singleton "x" (TomlTypes.String text))
  match Toml.toString value with
  | Ok source -> Result.map Toml.value (Toml.parse source) = Ok value
  | _ -> false
forall text: stringRoundTrip text
