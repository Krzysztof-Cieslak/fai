module TomlScalarSpec

let case001 _ =
  let testActual = TomlScalar.integer "9223372036854775807"
  let testExpected = Ok 9223372036854775807
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case002 _ =
  let testActual = TomlScalar.integer "-9223372036854775808"
  let testExpected = Ok (-9223372036854775807 - 1)
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case003 _ =
  let testActual = TomlScalar.integer "9223372036854775808" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"9223372036854775808\" |> Result.isErr" testActual

let case004 _ =
  let testActual = TomlScalar.integer "-9223372036854775809" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"-9223372036854775809\" |> Result.isErr" testActual

let case005 _ =
  let testActual = TomlScalar.integer "0x7fff_ffff_ffff_ffff"
  let testExpected = Ok 9223372036854775807
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case006 _ =
  let testActual = TomlScalar.integer "0x8000000000000000" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"0x8000000000000000\" |> Result.isErr" testActual

let case007 _ =
  let testActual = TomlScalar.integer "0b_1" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"0b_1\" |> Result.isErr" testActual

let case008 _ =
  let testActual = TomlScalar.integer "01" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"01\" |> Result.isErr" testActual

let case009 _ =
  let testActual = TomlScalar.integer "0_1" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"0_1\" |> Result.isErr" testActual

let case010 _ =
  let testActual = TomlScalar.integer "-0x1" |> Result.isErr
  Expect.isTrue "TomlScalar.integer \"-0x1\" |> Result.isErr" testActual

let case011 _ =
  let testActual = TomlScalar.integer "0o755"
  let testExpected = Ok 493
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case012 _ =
  let testActual = TomlScalar.integer "+1_000"
  let testExpected = Ok 1000
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case013 _ =
  let testActual = TomlScalar.floating "1.0_2e+3"
  let testExpected = Ok 1020.0
  Expect.equal ((Test.result Test.float Test.string)).show testExpected testActual

let case014 _ =
  let testActual = TomlScalar.floating "1_.0" |> Result.isErr
  Expect.isTrue "TomlScalar.floating \"1_.0\" |> Result.isErr" testActual

let case015 _ =
  let testActual = TomlScalar.floating "01.0" |> Result.isErr
  Expect.isTrue "TomlScalar.floating \"01.0\" |> Result.isErr" testActual

let case016 _ =
  let testActual = TomlScalar.floating "1e9999" |> Result.isErr
  Expect.isTrue "TomlScalar.floating \"1e9999\" |> Result.isErr" testActual

let case017 _ =
  let testActual = (TomlScalar.floating "-0.0" |> Result.map Float.toBits)
  let testExpected = Ok (-9223372036854775807 - 1)
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case018 _ =
  let testActual = (TomlScalar.floating "-inf" |> Result.map Float.toBits)
  let testExpected = Ok 0xfff0000000000000
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case019 _ =
  let testActual = TomlTemporal.parse "2024-02-29T12:30Z" |> Result.isOk
  Expect.isTrue "TomlTemporal.parse \"2024-02-29T12:30Z\" |> Result.isOk" testActual

let case020 _ =
  let testActual = TomlTemporal.parse "2023-02-29" |> Result.isErr
  Expect.isTrue "TomlTemporal.parse \"2023-02-29\" |> Result.isErr" testActual

let case021 _ =
  let testActual = TomlTemporal.parse "24:00:00" |> Result.isErr
  Expect.isTrue "TomlTemporal.parse \"24:00:00\" |> Result.isErr" testActual

let case022 _ =
  let testActual = TomlTemporal.parse "12:30:00.123456789123" |> Result.isOk
  Expect.isTrue "TomlTemporal.parse \"12:30:00.123456789123\" |> Result.isOk" testActual

let case023 _ =
  let testActual =
    (match TomlTemporal.parse "12:30:00.123456789123" with
    | Ok value -> TomlTemporal.toTime value |> Result.isErr
    | _ -> false)
  Expect.isTrue "(match TomlTemporal.parse \"12:30:00.123456789123\" with | Ok value -> TomlTemporal.toTime value |> Result.isErr | _ -> false)" testActual

let case024 testInput =
  let value = testInput
  let testActual = TomlScalar.integer (Int.toString value)
  let testExpected = Ok value
  Expect.equal ((Test.result Test.int Test.string)).show testExpected testActual

let case025 _ =
  let testActual =
    (match Toml.parse "n=9223372036854775808" with
    | Err error ->
      error.kind = TomlTypes.InvalidNumber && error.primary.startByte = 2 && error.primary.endByte = 21
    | _ -> false)
  Expect.isTrue "(match Toml.parse \"n=9223372036854775808\" with | Err error -> error.kind = TomlTypes.InvalidNumber && error.primary.startByte = 2 && error.primary.endByte = …" testActual

let case026 _ =
  let testActual =
    (match Toml.parse "n=2023-02-29" with
    | Err error -> error.kind = TomlTypes.InvalidTemporal
    | _ -> false)
  Expect.isTrue "(match Toml.parse \"n=2023-02-29\" with | Err error -> error.kind = TomlTypes.InvalidTemporal | _ -> false)" testActual

let case027 _ =
  let testActual =
    (match Toml.parseBytes (Bytes.fromList [97, 61, 39, 255, 39]) with
    | Err error ->
      error.kind = TomlTypes.InvalidUtf8 && error.primary.startByte = 3 && error.primary.endByte = 4
    | _ -> false)
  Expect.isTrue "(match Toml.parseBytes (Bytes.fromList [97, 61, 39, 255, 39]) with | Err error -> error.kind = TomlTypes.InvalidUtf8 && error.primary.startByte = 3 && error.…" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "TomlScalarSpec" [
  Test.test "TomlScalar.integer \"9223372036854775807\" = Ok 9223372036854775807" case001,
  Test.test "TomlScalar.integer \"-9223372036854775808\" = Ok (-9223372036854775807 - 1)" case002,
  Test.test "TomlScalar.integer \"9223372036854775808\" |> Result.isErr" case003,
  Test.test "TomlScalar.integer \"-9223372036854775809\" |> Result.isErr" case004,
  Test.test "TomlScalar.integer \"0x7fff_ffff_ffff_ffff\" = Ok 9223372036854775807" case005,
  Test.test "TomlScalar.integer \"0x8000000000000000\" |> Result.isErr" case006,
  Test.test "TomlScalar.integer \"0b_1\" |> Result.isErr" case007,
  Test.test "TomlScalar.integer \"01\" |> Result.isErr" case008,
  Test.test "TomlScalar.integer \"0_1\" |> Result.isErr" case009,
  Test.test "TomlScalar.integer \"-0x1\" |> Result.isErr" case010,
  Test.test "TomlScalar.integer \"0o755\" = Ok 493" case011,
  Test.test "TomlScalar.integer \"+1_000\" = Ok 1000" case012,
  Test.test "TomlScalar.floating \"1.0_2e+3\" = Ok 1020.0" case013,
  Test.test "TomlScalar.floating \"1_.0\" |> Result.isErr" case014,
  Test.test "TomlScalar.floating \"01.0\" |> Result.isErr" case015,
  Test.test "TomlScalar.floating \"1e9999\" |> Result.isErr" case016,
  Test.test "(TomlScalar.floating \"-0.0\" |> Result.map Float.toBits) = Ok (-9223372036854775807 - 1)" case017,
  Test.test "(TomlScalar.floating \"-inf\" |> Result.map Float.toBits) = Ok 0xfff0000000000000" case018,
  Test.test "TomlTemporal.parse \"2024-02-29T12:30Z\" |> Result.isOk" case019,
  Test.test "TomlTemporal.parse \"2023-02-29\" |> Result.isErr" case020,
  Test.test "TomlTemporal.parse \"24:00:00\" |> Result.isErr" case021,
  Test.test "TomlTemporal.parse \"12:30:00.123456789123\" |> Result.isOk" case022,
  Test.test "(match TomlTemporal.parse \"12:30:00.123456789123\" with | Ok value -> TomlTemporal.toTime value |> Result.isErr | _ -> false)" case023,
  Test.property "property: TomlScalar.integer (Int.toString value) = Ok value" Test.int case024,
  Test.test "(match Toml.parse \"n=9223372036854775808\" with | Err error -> error.kind = TomlTypes.InvalidNumber && error.primary.startByte = 2 && error.primary.endByte = …" case025,
  Test.test "(match Toml.parse \"n=2023-02-29\" with | Err error -> error.kind = TomlTypes.InvalidTemporal | _ -> false)" case026,
  Test.test "(match Toml.parseBytes (Bytes.fromList [97, 61, 39, 255, 39]) with | Err error -> error.kind = TomlTypes.InvalidUtf8 && error.primary.startByte = 3 && error.…" case027
]
