module LlmAssistantChecks

import json.Json
import llm.Llm
import llm.LlmJson
import llm.LlmOpenAI
import llm.LlmTool
import llm.LlmTypes
import process.Process

public type R = {
  clock : Clock,
  concurrency : Concurrency,
  console : Console,
  env : Env,
  fs : FileSystem,
  net : Net,
  process : ProcessHost.Process,
  sqlite : SqliteHost.Sqlite,
  tls : Tls
}

let runtime = {
  clock = stdClock,
  concurrency = stdConcurrency,
  console = stdConsole,
  env = stdEnv,
  fs = stdFs,
  net = stdNet,
  process = ProcessHost.native,
  sqlite = SqliteHost.native,
  tls = stdTls
}

toolCall : String -> Json.Value -> LlmTypes.ToolCall
let toolCall name arguments = {
  arguments = arguments,
  id = name,
  itemId = None,
  name = name,
  rawArguments = Json.toString arguments
}

check : R -> String -> String -> List String -> SqliteHost.Session -> Listener -> Nursery -> Test.Check / { Clock, Concurrency, FileSystem, Net, ProcessHost.Process, SqliteHost.Sqlite, Tls }
let check env directory executable arguments database listener nursery =
  let server =
    env.concurrency.spawn nursery (fun _ -> Http.serveListener env listener LlmMockServer.handle)
  let store = { host = env.sqlite, session = database }
  let config = LlmOpenAI.config "secret-not-in-snapshot"
  let config = { config with
    http = { config.http with
      baseUrl = "http://127.0.0.1:" ++ Int.toString (env.net.localPort listener) ++ "/"
    }
  }
  let gate = env.concurrency.channel 1
  let seeded = env.concurrency.send gate ()
  let services = {
    clock = env.clock,
    concurrency = env.concurrency,
    fs = env.fs,
    gate = gate,
    net = env.net,
    process = env.process,
    store = store,
    tls = env.tls
  }
  let settings = {
    config = config,
    maxTurns = 4,
    processOptions = { Process.defaults with timeoutMs = Some 10000 },
    session = "checks",
    toolBytes = 65536,
    workspace = directory
  }
  let initialized = LlmAssistantStore.initialize store "checks"
  let native name = Result.withDefault Path.empty (Path.fromString (directory ++ "/" ++ name))
  let a = env.fs.writeFile (native "a") "fixture-a"
  let b = env.fs.writeFile (native "b") "fixture-b"
  let result =
    LlmAssistantCore.run services settings (Llm.request "fixture") "read files" (fun _ -> ())
  let loaded = LlmAssistantStore.load store "checks" config (Llm.request "fixture")
  let saved =
    match result with
    | Err _ -> false
    | Ok request ->
      (match LlmAssistantStore.snapshot config request with
      | Err _ -> false
      | Ok json -> not (String.contains json "secret-not-in-snapshot"))
  let tools = LlmAssistantCore.registry services settings
  let wrote =
    LlmTool.execute tools (toolCall "write_file" (LlmJson.object [
      ("path", Json.String "written"),
      ("text", Json.String "from-tool")
    ]))
  let read = env.fs.readFile (native "written")
  let ignored = env.fs.writeFile (native ".gitignore") "written\n"
  let discovered =
    LlmTool.execute tools (toolCall "find_files" (LlmJson.object [
      ("pattern", Json.String "{a,b,written}"),
      ("limit", LlmJson.integer 10)
    ]))
  let ran =
    LlmTool.execute tools (toolCall "run_command" (LlmJson.object [
      ("executable", Json.String executable),
      ("arguments", LlmJson.array (List.map Json.String arguments)),
      ("directory", Json.Null)
    ]))
  let cancelled = env.concurrency.cancel server
  Expect.all [
    Expect.isTrue "store initialized" (Result.isOk initialized),
    Expect.isTrue "input files created" (Result.isOk a && Result.isOk b),
    Expect.isTrue "assistant completes its tool loop" (Result.isOk result),
    Expect.isTrue "stored snapshot excludes credentials" saved,
    Expect.isTrue "history restores without interrupted state" (match loaded with
    | Ok value -> not value.interrupted && value.request.history <> []
    | Err _ -> false),
    Expect.isTrue "write tool succeeds" (Result.isOk wrote),
    Expect.isTrue "write tool preserves content" (read = Ok "from-tool"),
    Expect.isTrue "command tool returns subprocess output" (match ran with
    | Ok result -> String.contains (Json.toString result.value) "fixture-process"
    | Err _ -> false),
    Expect.isTrue "ignore file created" (Result.isOk ignored),
    Expect.isTrue "discovery respects ignore rules and reports completeness" (match discovered with
    | Ok result ->
      Option.map (List.map (LlmJson.text "path")) (LlmJson.list "paths" result.value) = Some [
        Some "a",
        Some "b"
      ] && LlmJson.get "truncated" result.value = Some (Json.Boolean false)
    | Err _ -> false)
  ]

public main : R -> Unit / { Clock, Concurrency, Console, Env, FileSystem, Net, ProcessHost.Process, SqliteHost.Sqlite, Tls }
let main env =
  match env.env.args () with
  | [directory, python] ->
    match env.sqlite.open ":memory:" false 5000 with
    | Err error -> env.console.writeLine error.message
    | Ok database ->
      let result =
        match env.net.listen 0 with
        | Err error -> Test.error error
        | Ok listener ->
          env.concurrency.scope (check env directory python [
            "-c",
            "print('fixture-process')"
          ] database listener)
      let closed = env.sqlite.close database
      env.console.writeLine (if result = Test.pass then
        "assistant checks passed"
      else
        "assistant checks FAILED")
  | _ -> env.console.writeLine "expected a temporary directory and Python executable"

assistantScenario : Test.Context -> Test.Check / { Clock, Concurrency, FileSystem, Net, ProcessHost.Process, SqliteHost.Sqlite, Tls }
let assistantScenario ctx =
  let env = {
    clock = ctx.runtime.clock,
    concurrency = ctx.runtime.concurrency,
    console = ctx.runtime.console,
    env = ctx.runtime.env,
    fs = ctx.runtime.fs,
    net = ctx.runtime.net,
    process = ProcessHost.native,
    sqlite = SqliteHost.native,
    tls = ctx.runtime.tls
  }
  let (executable, arguments) =
    if Path.nativeEncoding = "windows" then
      ("powershell", [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "Write-Output fixture-process"
      ])
    else
      ("sh", ["-c", "printf fixture-process"])
  match (Path.toString ctx.tempRoot, env.sqlite.open ":memory:" false 5000) with
  | (Ok directory, Ok database) ->
    let result =
      match env.net.listen 0 with
      | Err error -> Test.error error
      | Ok listener ->
        env.concurrency.scope (check env directory executable arguments database listener)
    let closed = env.sqlite.close database
    Expect.all [result, Expect.isTrue "database closes after the scenario" (Result.isOk closed)]
  | (_, Err error) -> Test.error error.message
  | _ -> Test.error "test directory is not representable as text"

public tests : Test.Suite Test.Context { Clock, Concurrency, FileSystem, Net, ProcessHost.Process, SqliteHost.Sqlite, Tls }
let tests = Test.describe "assistant integration" [
  Test.test "tools, persistence and file discovery" assistantScenario
]
