module LlmOpenAICheck

import json.Json
import llm.Llm
import llm.LlmJson
import llm.LlmOpenAI

let frame value = "data: " ++ Json.toString value ++ "\n\n"

let obj = LlmJson.object

let str = Json.String

let num = LlmJson.integer

let item = obj [
  ("id", str "msg"),
  ("type", str "message"),
  ("role", str "assistant"),
  ("content", LlmJson.array [obj [("type", str "output_text"), ("text", str "hello")]])
]

let response = obj [
  ("id", str "resp"),
  ("model", str "fixture"),
  ("status", str "completed"),
  ("output", LlmJson.array [item])
]

let body =
  String.join "" (List.map frame [
    obj [
      ("type", str "response.created"),
      ("response", obj [("id", str "resp"), ("model", str "fixture")])
    ],
    obj [
      ("type", str "response.output_item.added"),
      ("output_index", num 0),
      ("item", obj [("id", str "msg"), ("type", str "message")])
    ],
    obj [
      ("type", str "response.content_part.added"),
      ("output_index", num 0),
      ("content_index", num 0)
    ],
    obj [
      ("type", str "response.output_text.delta"),
      ("output_index", num 0),
      ("content_index", num 0),
      ("delta", str "hello")
    ],
    obj [
      ("type", str "response.content_part.done"),
      ("output_index", num 0),
      ("content_index", num 0)
    ],
    obj [("type", str "response.completed"), ("response", response)]
  ])

handle : Http.Request 'e -> Result (Http.Response { }) String
let handle request =
  Ok (Http.chunkedResponse 200 (Headers.fromList [
    ("Content-Type", "text/event-stream"),
    ("x-request-id", "request-fixture")
  ]) (Http.stringBody body))

work : Llm.Client -> Result Llm.Response Llm.Error / { Clock, Concurrency, Net, Tls }
let work client = Llm.generate client (Llm.request "fixture" |> Llm.userText "hello")

session : Runtime -> Listener -> Nursery -> Test.Check / { Clock, Concurrency, Net, Tls }
let session env listener nursery =
  let server = env.concurrency.spawn nursery (fun _ -> Http.serveListener env listener handle)
  let config = LlmOpenAI.config "test"
  let config = { config with
    http = { config.http with
      baseUrl = "http://127.0.0.1:" ++ Int.toString (env.net.localPort listener) ++ "/"
    }
  }
  let result = Llm.withClient env config work
  let cancelled = env.concurrency.cancel server
  match result with
  | Ok response -> Expect.all [
    Expect.equal identity "hello" (Llm.text response),
    Expect.equal (Option.withDefault "<none>") (Some "request-fixture") response.requestId
  ]
  | Err error -> Test.error (Llm.errorToString error)

check : Runtime -> Test.Check / { Clock, Concurrency, Net, Tls }
let check env =
  match env.net.listen 0 with
  | Err error -> Test.error error
  | Ok listener -> env.concurrency.scope (session env listener)

public main : Runtime -> Unit / { Clock, Concurrency, Console, Net, Tls }
let main env =
  env.console.writeLine (if check env = Test.pass then
    "OpenAI loopback passed"
  else
    "OpenAI loopback FAILED")

public tests : Test.Suite Test.Context { Clock, Concurrency, Net, Tls }
let tests = Test.describe "OpenAI transport" [
  Test.test "streamed text and request identity" (fun ctx -> check ctx.runtime)
]
