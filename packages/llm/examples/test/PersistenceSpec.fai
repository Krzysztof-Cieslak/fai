module LlmPersistenceSpec

import llm.Llm
import llm.LlmAnthropic
import llm.LlmOpenAI

let config = LlmOpenAI.config "private-api-key"

let request = Llm.request "fixture" |> Llm.userText "remember this"

let saved = LlmAssistantStore.snapshot config request

let case001 _ =
  let testActual =
    (saved |> Result.map (fun text -> String.contains text "private-api-key")) = Ok false
  Expect.isTrue "(saved |> Result.map (fun text -> String.contains text \"private-api-key\")) = Ok false" testActual

let case002 _ =
  let testActual =
    (saved |> Result.map (fun text ->
      LlmAssistantStore.restore config (Llm.request "fixture") text |> Result.isOk)) = Ok true
  Expect.isTrue "(saved |> Result.map (fun text -> LlmAssistantStore.restore config (Llm.request \"fixture\") text |> Result.isOk)) = Ok true" testActual

let case003 _ =
  let testActual =
    (saved |> Result.map (fun text ->
      LlmAssistantStore.restore (LlmAnthropic.config "key") (Llm.request "fixture") text |> Result.isErr)) = Ok true
  Expect.isTrue "(saved |> Result.map (fun text -> LlmAssistantStore.restore (LlmAnthropic.config \"key\") (Llm.request \"fixture\") text |> Result.isErr)) = Ok true" testActual

let case004 _ =
  let testActual = LlmAssistantStore.restore config request "{\"version\":99}" |> Result.isErr
  Expect.isTrue "LlmAssistantStore.restore config request \"{\\\"version\\\":99}\" |> Result.isErr" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "LlmPersistenceSpec" [
  Test.test "(saved |> Result.map (fun text -> String.contains text \"private-api-key\")) = Ok false" case001,
  Test.test "(saved |> Result.map (fun text -> LlmAssistantStore.restore config (Llm.request \"fixture\") text |> Result.isOk)) = Ok true" case002,
  Test.test "(saved |> Result.map (fun text -> LlmAssistantStore.restore (LlmAnthropic.config \"key\") (Llm.request \"fixture\") text |> Result.isErr)) = Ok true" case003,
  Test.test "LlmAssistantStore.restore config request \"{\\\"version\\\":99}\" |> Result.isErr" case004
]
