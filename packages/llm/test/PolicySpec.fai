module LlmPolicySpec

import http_client.HttpClient

let config = { LlmOpenAI.config "key" with retryBaseMs = 100, retryCount = 2, retryMaxMs = 1000 }

decide : LlmConfig.Config -> Int -> (Llm.Error -> Llm.Error) -> Option Int
let decide config retries update =
  match Url.parse "https://example.com/" with
  | Err _ -> None
  | Ok url ->
    let head = {
      attempts = 1,
      headers = Headers.empty,
      reason = "rate limited",
      status = 429,
      url = url
    }
    let error = { LlmTypes.error LlmTypes.ProviderError "rate limited" with
      http = Some (HttpClient.EventStatus head),
      status = Some 429
    }
    LlmPolicy.delay config 0 retries (update error)

let case001 _ =
  let testActual = decide config 0 identity
  let testExpected = Some 100
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case002 _ =
  let testActual = decide config 1 identity
  let testExpected = Some 200
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case003 _ =
  let testActual = decide config 2 identity
  let testExpected = None
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case004 _ =
  let testActual = decide config 0 (fun error -> { error with eventsDelivered = 1 })
  let testExpected = None
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case005 _ =
  let testActual =
    decide config 0 (fun error -> { error with headers = Headers.fromList [("Retry-After", "2")] })
  let testExpected = Some 2000
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case006 _ =
  let testActual = decide { config with retryCount = 0 } 0 identity
  let testExpected = None
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case007 _ =
  let testActual = decide config 0 (fun error -> { error with status = Some 401 })
  let testExpected = None
  Expect.equal ((Test.option Test.int)).show testExpected testActual

let case008 _ =
  let testActual =
    decide config 0 (fun error -> { error with
      http = Some (HttpClient.Transport "connection lost")
    })
  let testExpected = None
  Expect.equal ((Test.option Test.int)).show testExpected testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "LlmPolicySpec" [
  Test.test "decide config 0 identity = Some 100" case001,
  Test.test "decide config 1 identity = Some 200" case002,
  Test.test "decide config 2 identity = None" case003,
  Test.test "decide config 0 (fun error -> { error with eventsDelivered = 1 }) = None" case004,
  Test.test "decide config 0 (fun error -> { error with headers = Headers.fromList [(\"Retry-After\", \"2\")] }) = Some 2000" case005,
  Test.test "decide { config with retryCount = 0 } 0 identity = None" case006,
  Test.test "decide config 0 (fun error -> { error with status = Some 401 }) = None" case007,
  Test.test "decide config 0 (fun error -> { error with http = Some (HttpClient.Transport \"connection lost\") }) = None" case008
]
