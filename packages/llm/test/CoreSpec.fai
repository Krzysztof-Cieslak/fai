module LlmCoreSpec

let person =
  LlmSchema.map2 (fun name age ->
    (name, age)) (LlmSchema.field "name" LlmSchema.string) (LlmSchema.field "age" LlmSchema.int)

let read text =
  match Json.parse text with
  | Err _ -> false
  | Ok value -> LlmSchema.decode person value = Ok ("Ada", 37)
example: read "{\"name\":\"Ada\",\"age\":37}"
example: not (read "{\"name\":\"Ada\",\"age\":37.5}")
example: not (read "{\"name\":\"Ada\",\"age\":37,\"extra\":true}")
example: not (read "{\"name\":\"Ada\",\"name\":\"Other\",\"age\":37}")
example: LlmSchema.describe (LlmSchema.map2 (fun a b ->
  (a, b)) (LlmSchema.field "x" LlmSchema.int) (LlmSchema.field "x" LlmSchema.int)) |> Result.isErr
example: LlmValidate.request LlmTypes.OpenAI Llm.limits (Llm.request "model" |> Llm.userText "hello") = Ok ()
example: LlmValidate.request LlmTypes.OpenAI Llm.limits (Llm.request "") |> Result.isErr
example: LlmValidate.request LlmTypes.OpenAI Llm.limits (Llm.request "model" |> Llm.maxOutputTokens 0) |> Result.isErr
example: LlmValidate.request LlmTypes.Anthropic Llm.limits { Llm.request "model" with
  history = [LlmTypes.Native LlmTypes.OpenAI Json.Null]
} |> Result.isErr
example: LlmValidate.toolName "read_file-2"
example: not (LlmValidate.toolName "read file")
example: LlmMessage.continueWith (LlmTypes.emptyResponse LlmTypes.OpenAI) [] (Llm.request "model") |> Result.isErr
example: LlmMessage.continueWith { LlmTypes.emptyResponse LlmTypes.OpenAI with
  finish = LlmTypes.Completed
} [] (Llm.request "model") = Ok (Llm.request "model")

let scripted = {
  generate = fun request -> Ok { LlmTypes.emptyResponse LlmTypes.OpenAI with
    finish = LlmTypes.Completed,
    model = request.model
  }
}

useModel : Llm.Model 'e -> Llm.Request -> Result Llm.Response Llm.Error / 'e
let useModel model request = model.generate request
example: useModel scripted (Llm.request "test") |> Result.isOk
forall text: (Llm.request "test" |> Llm.userText text).history = [
  LlmTypes.Message LlmTypes.User [LlmTypes.Text text]
]
