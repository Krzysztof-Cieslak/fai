module CsvChunkSpec

let finish parser records =
  let fed = CsvCore.finish parser
  match fed.status with
  | CsvCore.Failed error -> Err error
  | CsvCore.End -> Ok records
  | CsvCore.RecordReady record -> finish fed.parser (Array.push record records)
  | CsvCore.NeedInput -> finish fed.parser records

let run parser chunks current offset records =
  let fed = CsvCore.feed parser current offset
  match fed.status with
  | CsvCore.Failed error -> Err error
  | CsvCore.End -> Ok records
  | CsvCore.RecordReady record -> run fed.parser chunks current fed.next (Array.push record records)
  | CsvCore.NeedInput ->
    match chunks with
    | [] -> finish fed.parser records
    | chunk :: rest -> run fed.parser rest chunk 0 records

let parse text options chunks =
  match CsvCore.parser text options with
  | Err error -> Err error
  | Ok parser -> run parser chunks Bytes.empty 0 [||]

let splits text options bytes index expected =
  if index > Bytes.length bytes then
    true
  else
    parse text options [
      Bytes.slice 0 index bytes,
      Bytes.slice index (Bytes.length bytes) bytes
    ] = expected && splits text options bytes (index + 1) expected

let allSplits text options bytes = splits text options bytes 0 (parse text options [bytes])

let oneByteChunks bytes = List.map (fun byte -> Bytes.fromList [byte]) (Bytes.toList bytes)

let bytes = Bytes.fromString "\u{feff}name,note\r\né,\"🙂\r\na\"\"b\"\r\n"

let case001 _ =
  let testActual = allSplits true CsvTypes.options bytes
  Expect.isTrue "allSplits true CsvTypes.options bytes" testActual

let case002 _ =
  let testActual =
    parse true CsvTypes.options (oneByteChunks bytes) = parse true CsvTypes.options [bytes]
  Expect.isTrue "parse true CsvTypes.options (oneByteChunks bytes) = parse true CsvTypes.options [bytes]" testActual

let case003 _ =
  let testActual = allSplits true CsvTypes.options (Bytes.fromString "a\r\nb,c\r\n")
  Expect.isTrue "allSplits true CsvTypes.options (Bytes.fromString \"a\\r\\nb,c\\r\\n\")" testActual

let case004 _ =
  let testActual = allSplits true CsvTypes.options (Bytes.fromString "\"a\"\"b\"")
  Expect.isTrue "allSplits true CsvTypes.options (Bytes.fromString \"\\\"a\\\"\\\"b\\\"\")" testActual

let case005 _ =
  let testActual = allSplits true CsvTypes.options (Bytes.fromList [239, 187])
  Expect.isTrue "allSplits true CsvTypes.options (Bytes.fromList [239, 187])" testActual

let case006 _ =
  let testActual =
    allSplits false { CsvTypes.byteOptions with
      bom = CsvTypes.StripUtf8Bom
    } (Bytes.fromList [239, 10])
  Expect.isTrue "allSplits false { CsvTypes.byteOptions with bom = CsvTypes.StripUtf8Bom } (Bytes.fromList [239, 10])" testActual

let case007 _ =
  let testActual =
    allSplits true { CsvTypes.options with
      dialect = { CsvTypes.dialect with endings = CsvTypes.CrLfOnly }
    } bytes
  Expect.isTrue "allSplits true { CsvTypes.options with dialect = { CsvTypes.dialect with endings = CsvTypes.CrLfOnly } } bytes" testActual

let early =
  match CsvCore.parser true CsvTypes.options with
  | Err _ -> false
  | Ok parser ->
    let fed = CsvCore.feed parser (Bytes.fromList [97, 10, 255]) 0
    fed.next = 2 && (match fed.status with
    | CsvCore.RecordReady _ -> true
    | _ -> false)

let case008 _ =
  let testActual = early
  Expect.isTrue "early" testActual

let alias =
  match CsvCore.parser true CsvTypes.options with
  | Err _ -> false
  | Ok parser -> CsvCore.feed parser bytes 0 = CsvCore.feed parser bytes 0

let case009 _ =
  let testActual = alias
  Expect.isTrue "alias" testActual

let position =
  match parse true CsvTypes.options [Bytes.fromString "a\r\n\"é\n🙂\"\n"] with
  | Ok records ->
    let record = Array.unsafeGet 1 records
    record.source = Some {
      index = 1,
      span = {
        finish = { byteColumn = 6, byteOffset = 12, line = 3 },
        start = { byteColumn = 1, byteOffset = 3, line = 2 }
      }
    } && (Array.unsafeGet 0 record.fields).quoted
  | _ -> false

let case010 _ =
  let testActual = position
  Expect.isTrue "position" testActual

let invalid bytes position =
  match parse true CsvTypes.options [Bytes.fromList bytes] with
  | Err error ->
    error.kind = CsvTypes.InvalidUtf8 && Option.map (fun position ->
      position.byteOffset) error.position = Some position
  | _ -> false

let case011 _ =
  let testActual = invalid [97, 44, 255] 2
  Expect.isTrue "invalid [97, 44, 255] 2" testActual

let case012 _ =
  let testActual = invalid [97, 44, 240, 128, 128, 128] 2
  Expect.isTrue "invalid [97, 44, 240, 128, 128, 128] 2" testActual

let case013 _ =
  let testActual = invalid [97, 44, 237, 160, 128] 2
  Expect.isTrue "invalid [97, 44, 237, 160, 128] 2" testActual

let case014 _ =
  let testActual = invalid [97, 44, 240, 159, 153] 2
  Expect.isTrue "invalid [97, 44, 240, 159, 153] 2" testActual

let case015 testInput =
  let source = testInput
  let testActual = allSplits true CsvTypes.options (Bytes.fromString source)
  Expect.isTrue "property: allSplits true CsvTypes.options (Bytes.fromString source)" testActual

let case016 testInput =
  let values = testInput
  let testActual = allSplits false CsvTypes.byteOptions (Bytes.fromList values)
  Expect.isTrue "property: allSplits false CsvTypes.byteOptions (Bytes.fromList values)" testActual

let partition bytes sizes offset pieces =
  match sizes with
  | [] -> List.reverse (Bytes.slice offset (Bytes.length bytes) bytes :: pieces)
  | size :: rest ->
    let count = Int.floorMod size (Bytes.length bytes - offset + 1)
    partition bytes rest (offset + count) (Bytes.slice offset (offset + count) bytes :: pieces)

let partitioned values sizes =
  let bytes = Bytes.fromList values
  parse false CsvTypes.byteOptions (partition bytes sizes 0 []) = parse false CsvTypes.byteOptions [
    bytes
  ]

let case017 testInput =
  let (values, sizes) = testInput
  let testActual = partitioned values sizes
  Expect.isTrue "property: partitioned values sizes" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "CsvChunkSpec" [
  Test.test "allSplits true CsvTypes.options bytes" case001,
  Test.test "parse true CsvTypes.options (oneByteChunks bytes) = parse true CsvTypes.options [bytes]" case002,
  Test.test "allSplits true CsvTypes.options (Bytes.fromString \"a\\r\\nb,c\\r\\n\")" case003,
  Test.test "allSplits true CsvTypes.options (Bytes.fromString \"\\\"a\\\"\\\"b\\\"\")" case004,
  Test.test "allSplits true CsvTypes.options (Bytes.fromList [239, 187])" case005,
  Test.test "allSplits false { CsvTypes.byteOptions with bom = CsvTypes.StripUtf8Bom } (Bytes.fromList [239, 10])" case006,
  Test.test "allSplits true { CsvTypes.options with dialect = { CsvTypes.dialect with endings = CsvTypes.CrLfOnly } } bytes" case007,
  Test.test "early" case008,
  Test.test "alias" case009,
  Test.test "position" case010,
  Test.test "invalid [97, 44, 255] 2" case011,
  Test.test "invalid [97, 44, 240, 128, 128, 128] 2" case012,
  Test.test "invalid [97, 44, 237, 160, 128] 2" case013,
  Test.test "invalid [97, 44, 240, 159, 153] 2" case014,
  Test.property "property: allSplits true CsvTypes.options (Bytes.fromString source)" Test.string case015,
  Test.property "property: allSplits false CsvTypes.byteOptions (Bytes.fromList values)" (Test.list Test.int) case016,
  Test.property "property: partitioned values sizes" (Test.tuple2 (Test.list Test.int) (Test.list Test.int)) case017
]
