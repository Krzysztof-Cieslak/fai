module CsvBytes

public opaque type Record = CsvTypes.Record Bytes

public opaque type Headers = CsvRecord.Headers Bytes

public type HeaderMode =
  | NoHeader
  | FirstRecord
  | Supplied Headers

public type Table = { headers : Option Headers, records : Array Record }

public options : CsvTypes.Options
let options = CsvTypes.byteOptions

public parseWith : CsvTypes.Options -> Bytes -> Result (Array Record) CsvTypes.Error
let parseWith options bytes = CsvRecord.parse false options bytes

public parse : Bytes -> Result (Array Record) CsvTypes.Error
let parse bytes = parseWith options bytes

public recordWith : CsvTypes.Limits -> Array Bytes -> Result Record CsvTypes.Error
let recordWith limits values = CsvRecord.make limits Bytes.length values

public record : Array Bytes -> Result Record CsvTypes.Error
let record values = recordWith CsvTypes.limits values

public fields : Record -> Array Bytes
let fields record = CsvRecord.values record

public field : Int -> Record -> Result Bytes CsvTypes.Error
let field index record =
  match Array.get index record.fields with
  | Some field -> Ok field.value
  | None ->
    Err (CsvTypes.at record (Some index) (CsvTypes.error CsvTypes.MissingColumn "CSV field index is out of bounds"))

public inspect : Record -> CsvTypes.Record Bytes
let inspect record = record

internal wrap : CsvTypes.Record Bytes -> Record
let wrap record = record

public headersWith : (Bytes -> Bytes) -> Record -> Result Headers CsvTypes.Error
let headersWith normalize record = CsvRecord.headers normalize Bytes.isEmpty record

public headers : Record -> Result Headers CsvTypes.Error
let headers record = headersWith identity record

public headerNames : Headers -> Array Bytes
let headerNames headers = headers.names

public column : Bytes -> Headers -> Result Int CsvTypes.Error
let column name headers = CsvRecord.lookup name headers

public named : Bytes -> Headers -> Record -> Result Bytes CsvTypes.Error
let named name headers record =
  match column name headers with
  | Err error -> Err error
  | Ok index -> field index record

internal headerMode : HeaderMode -> CsvRecord.HeaderMode Bytes
let headerMode mode =
  match mode with
  | NoHeader -> CsvRecord.NoHeader
  | FirstRecord -> CsvRecord.FirstRecord
  | Supplied headers -> CsvRecord.Supplied headers

internal wrapHeaders : CsvRecord.Headers Bytes -> Headers
let wrapHeaders headers = headers

internal unwrapHeaders : Headers -> CsvRecord.Headers Bytes
let unwrapHeaders headers = headers

public parseTableWith : CsvTypes.Options -> HeaderMode -> Bytes -> Result Table CsvTypes.Error
let parseTableWith options mode bytes =
  match CsvRecord.optionsFor options (headerMode mode) with
  | Err error -> Err error
  | Ok options ->
    match parseWith options bytes with
    | Err error -> Err error
    | Ok records -> CsvRecord.table Bytes.isEmpty (headerMode mode) records

public parseTable : Bytes -> Result Table CsvTypes.Error
let parseTable bytes = parseTableWith options FirstRecord bytes

public opaque type Parser = CsvCore.Parser

public type Status =
  | NeedInput
  | RecordReady Record
  | End
  | Failed CsvTypes.Error

public type Feed = { next : Int, parser : Parser, status : Status }

public parserWith : CsvTypes.Options -> Result Parser CsvTypes.Error
let parserWith options = CsvCore.parser false options

public parser : Unit -> Result Parser CsvTypes.Error
let parser unit = parserWith options

let converted fed =
  let status =
    match fed.status with
    | CsvCore.NeedInput -> NeedInput
    | CsvCore.End -> End
    | CsvCore.Failed error -> Failed error
    | CsvCore.RecordReady record -> RecordReady record
  { next = fed.next, parser = fed.parser, status = status }

public feedFrom : Parser -> Bytes -> Int -> Feed
let feedFrom parser bytes offset = converted (CsvCore.feed parser bytes offset)

public feed : Parser -> Bytes -> Feed
let feed parser bytes = feedFrom parser bytes 0

public finish : Parser -> Feed
let finish parser = converted (CsvCore.finish parser)

public headerRecord : Headers -> Record
let headerRecord headers = headers.original
