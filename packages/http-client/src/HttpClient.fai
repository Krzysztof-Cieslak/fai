module HttpClient

/// Metadata for the final response. Attempts count actual HTTP exchanges.
public type ResponseHead = {
  attempts : Int,
  headers : Headers,
  reason : String,
  status : Int,
  url : Url
}

/// A response retains its metadata alongside the application's decoded value.
public type Response 'a = { body : 'a, head : ResponseHead }

/// Located codec errors and HTTP metadata remain available without parsing text.
public type Error =
  | InvalidConfiguration String
  | InvalidRequest String
  | Encoding JsonEncode.Error
  | Transport String
  | BodyRead ResponseHead String
  | DeadlineExceeded
  | Cancelled
  | RedirectLimit Int
  | UnexpectedStatus ResponseHead Bytes Bool
  | BodyTooLarge ResponseHead Int
  | UnsupportedJsonMediaType ResponseHead (Option String)
  | InvalidJson ResponseHead JsonDecode.ReadError
  | InvalidText ResponseHead
  | ConsumerFailure String
  | EventCodec Sse.Error
  | EventMediaType ResponseHead (Option String)
  | EventStatus ResponseHead
  | EventConnectTimeout
  | EventIdleTimeout
  | EventReconnectLimit Int

/// Immutable client configuration. Size limits are bytes; timeouts are milliseconds.
public type Config = {
  baseUrl : String,
  extraRoots : Option Bytes,
  followRedirects : Bool,
  headers : Headers,
  maxBodyBytes : Int,
  maxErrorBytes : Int,
  maxRedirects : Int,
  retry : HttpClientPolicy.RetryPolicy,
  sensitiveHeaders : List String,
  timeoutMs : Option Int
}

/// Defaults: a 30-second deadline, 16 MiB buffered body, and 8 KiB error preview.
public config : String -> Config
let config baseUrl = {
  baseUrl = baseUrl,
  extraRoots = None,
  followRedirects = true,
  headers = Headers.empty,
  maxBodyBytes = 16777216,
  maxErrorBytes = 8192,
  maxRedirects = 10,
  retry = HttpClientPolicy.noRetry,
  sensitiveHeaders = ["Authorization", "Cookie", "Proxy-Authorization"],
  timeoutMs = Some 30000
}

/// The opt-in default retry policy: two additional attempts on transient statuses.
public retryTransient : HttpClientPolicy.RetryPolicy
let retryTransient = HttpClientPolicy.retryTransient

let headerName pair =
  let (name, value) = pair
  name

policySettings : Config -> HttpClientPolicy.Settings
let policySettings cfg = {
  followRedirects = cfg.followRedirects,
  maxRedirects = cfg.maxRedirects,
  retry = cfg.retry,
  sensitiveHeaders = List.append cfg.sensitiveHeaders (List.map headerName (Headers.toList cfg.headers))
}

type Expectation =
  | AnyStatus
  | Success
  | JsonSuccess

type RequestInfo = {
  body : Bytes,
  expectation : Expectation,
  headers : Headers,
  issue : Option Error,
  method : Http.Method,
  query : List (String * String),
  removed : List String,
  target : String
}

/// A pure request description and a pure response decoder.
public opaque type Request 'a =
  | MkRequest RequestInfo (ResponseHead -> Bytes -> Result 'a Error)

/// A validated wire request. Useful for inspecting and testing request builders.
public type Prepared = { body : Bytes, headers : Headers, method : Http.Method, url : Url }

/// Construct a raw-byte request; every HTTP status is returned to the caller.
public request : Http.Method -> String -> Request Bytes
let request method target =
  MkRequest {
    body = Bytes.empty,
    expectation = AnyStatus,
    headers = Headers.empty,
    issue = None,
    method = method,
    query = [],
    removed = [],
    target = target
  } (fun head bytes -> Ok bytes)

/// Construct a GET request.
public get : String -> Request Bytes
let get target = request Http.GET target

/// Construct a HEAD request.
public head : String -> Request Bytes
let head target = request Http.HEAD target

/// Construct a POST request.
public post : String -> Request Bytes
let post target = request Http.POST target

/// Construct a PUT request.
public put : String -> Request Bytes
let put target = request Http.PUT target

/// Construct a PATCH request.
public patch : String -> Request Bytes
let patch target = request Http.PATCH target

/// Construct a DELETE request.
public delete : String -> Request Bytes
let delete target = request Http.DELETE target

/// Replace all request fields of this name, case-insensitively.
public header : String -> String -> Request 'a -> Request 'a
let header name value req =
  match req with
  | MkRequest info decode ->
    MkRequest { info with headers = Headers.set name value info.headers } decode

/// Append a duplicate-preserving request header.
public addHeader : String -> String -> Request 'a -> Request 'a
let addHeader name value req =
  match req with
  | MkRequest info decode ->
    MkRequest { info with headers = Headers.add name value info.headers } decode

/// Remove a field, including any client default with the same name.
public removeHeader : String -> Request 'a -> Request 'a
let removeHeader name req =
  match req with
  | MkRequest info decode ->
    MkRequest { info with
      headers = Headers.remove name info.headers,
      removed = name :: info.removed
    } decode

/// Append a percent-encoded query pair, retaining repeated names and order.
public query : String -> String -> Request 'a -> Request 'a
let query name value req =
  match req with
  | MkRequest info decode ->
    MkRequest { info with query = List.append info.query [(name, value)] } decode

/// Supply immutable bytes. Framing headers are generated at execution time.
public bytesBody : String -> Bytes -> Request 'a -> Request 'a
let bytesBody media bytes req =
  match req with
  | MkRequest info decode ->
    MkRequest { info with
      body = bytes,
      headers = Headers.set "Content-Type" media info.headers
    } decode

/// Supply UTF-8 text with a text/plain media type.
public textBody : String -> Request 'a -> Request 'a
let textBody text req = bytesBody "text/plain; charset=utf-8" (Bytes.fromString text) req

/// Encode once during request construction. Encoding errors precede all I/O.
public jsonBody : JsonEncode.Encoder 'a -> 'a -> Request 'b -> Request 'b
let jsonBody encoder value req =
  match JsonEncode.toString encoder value with
  | Ok text -> bytesBody "application/json" (Bytes.fromString text) req
  | Err error ->
    match req with
    | MkRequest info decode -> MkRequest { info with issue = Some (Encoding error) } decode

let formPair pair =
  let (name, value) = pair
  Url.encodeComponent name ++ "=" ++ Url.encodeComponent value

/// Supply URL-encoded form fields, retaining duplicates and order.
public formBody : List (String * String) -> Request 'a -> Request 'a
let formBody pairs req =
  bytesBody "application/x-www-form-urlencoded" (Bytes.fromString (String.join "&" (List.map formPair pairs))) req

/// Require a 2xx response and retain its raw bytes.
public expectBytes : Request 'a -> Request Bytes
let expectBytes req =
  match req with
  | MkRequest info _ -> MkRequest { info with expectation = Success } (fun head bytes -> Ok bytes)

decodeText : ResponseHead -> Bytes -> Result String Error
let decodeText head bytes =
  match Bytes.toString bytes with
  | Some text -> Ok text
  | None -> Err (InvalidText head)

/// Require a 2xx response and valid UTF-8.
public expectText : Request 'a -> Request String
let expectText req =
  match req with
  | MkRequest info _ -> MkRequest { info with expectation = Success } decodeText

/// Require 2xx and discard the body. Useful for HEAD and 204 responses.
public expectEmpty : Request 'a -> Request Unit
let expectEmpty req =
  match req with
  | MkRequest info _ -> MkRequest { info with expectation = Success } (fun head bytes -> Ok ())

/// Require 2xx and a JSON media type, then decode with located JSON errors.
public expectJson : JsonDecode.Decoder 'a -> Request 'b -> Request 'a
let expectJson decoder req =
  match req with
  | MkRequest info _ ->
    MkRequest { info with
      expectation = JsonSuccess
    } (fun head bytes -> Result.mapError (InvalidJson head) (JsonDecode.fromBytes decoder bytes))

let asciiTokenByte b =
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || List.member b [
    33,
    35,
    36,
    37,
    38,
    39,
    42,
    43,
    45,
    46,
    94,
    95,
    96,
    124,
    126
  ]

let bytesAll predicate bytes i =
  i >= Bytes.length bytes || (predicate (Bytes.unsafeGet i bytes) && bytesAll predicate bytes (i + 1))

let token text = text <> "" && bytesAll asciiTokenByte (Bytes.fromString text) 0

let validHeader pair =
  let (name, value) = pair
  token name && bytesAll (fun b -> (b >= 32 && b <> 127) || b = 9) (Bytes.fromString value) 0

let validHeaders headers = List.all validHeader (Headers.toList headers)

let validUrl url =
  (Url.scheme url = Some "http" || Url.scheme url = Some "https") && Url.host url <> None && Url.userinfo url = None && bytesAll (fun b ->
    b > 32 && b <> 127) (Bytes.fromString (Url.requestTarget url)) 0

/// Validate configuration without opening a connection.
public validateConfig : Config -> Result Unit Error
let validateConfig cfg =
  if cfg.maxBodyBytes < 0 || cfg.maxErrorBytes < 0 then
    Err (InvalidConfiguration "body limits must be nonnegative")
  else if not (validHeaders cfg.headers) then
    Err (InvalidConfiguration "invalid default header")
  else if (match cfg.timeoutMs with
  | Some ms -> ms <= 0
  | None -> false) then
    Err (InvalidConfiguration "timeout must be positive or None")
  else
    match Url.parse cfg.baseUrl with
    | Ok url ->
      if validUrl url then
        Result.mapError InvalidConfiguration (HttpClientPolicy.validate (policySettings cfg))
      else
        Err (InvalidConfiguration "base URL must be an absolute http(s) URL without userinfo")
    | Err message -> Err (InvalidConfiguration message)

let sameOrigin a b =
  Url.scheme a = Url.scheme b && Option.map String.toLower (Url.host a) = Option.map String.toLower (Url.host b) && Url.effectivePort a = Url.effectivePort b

let removePair headers pair =
  let (name, value) = pair
  Headers.remove name headers

let appendPair headers pair =
  let (name, value) = pair
  Headers.add name value headers

let mergeHeaders defaults overrides removed =
  let base = List.foldl (fun headers name -> Headers.remove name headers) defaults removed
  List.foldl appendPair (List.foldl removePair base (Headers.toList overrides)) (Headers.toList overrides)

let withQuery url pairs =
  let text = Option.withDefault "" (List.head (String.split "#" (Url.toString url)))
  if List.isEmpty pairs then
    Ok url
  else
    Url.parse (text ++ (if Url.query url = None then
      "?"
    else
      "&") ++ String.join "&" (List.map formPair pairs))

let methodName method =
  match method with
  | Http.GET -> "GET"
  | Http.HEAD -> "HEAD"
  | Http.POST -> "POST"
  | Http.PUT -> "PUT"
  | Http.PATCH -> "PATCH"
  | Http.DELETE -> "DELETE"
  | Http.OPTIONS -> "OPTIONS"
  | Http.Custom name -> name

/// Resolve a request and merge headers without effects. Default headers apply
/// only to the base origin; request fields override defaults as a group.
public prepare : Config -> Request 'a -> Result Prepared Error
let prepare cfg req =
  match validateConfig cfg with
  | Err error -> Err error
  | Ok _ ->
    match req with
    | MkRequest info _ ->
      match info.issue with
      | Some error -> Err error
      | None ->
        if not (token (methodName info.method)) || not (validHeaders info.headers) then
          Err (InvalidRequest "invalid method or header")
        else
          match Url.parse cfg.baseUrl with
          | Err message -> Err (InvalidConfiguration message)
          | Ok base ->
            match Url.resolve base info.target with
            | Err message -> Err (InvalidRequest message)
            | Ok resolved ->
              match withQuery resolved info.query with
              | Err message -> Err (InvalidRequest message)
              | Ok url ->
                if not (validUrl url) then
                  Err (InvalidRequest "target must be an absolute http(s) URL without userinfo")
                else
                  let headers =
                    mergeHeaders (if sameOrigin base url then
                      cfg.headers
                    else
                      Headers.empty) info.headers info.removed
                  Ok {
                    body = info.body,
                    headers = Headers.remove "Host" (Headers.remove "Content-Length" (Headers.remove "Transfer-Encoding" headers)),
                    method = info.method,
                    url = url
                  }

let successful status = status >= 200 && status < 300

let jsonMedia media =
  let name =
    String.toLower (String.trim (Option.withDefault "" (List.head (String.split ";" media))))
  name = "application/json" || (String.take 12 name = "application/" && String.length name > 17 && token (String.drop 12 name) && String.drop (String.length name - 5) name = "+json" && not (String.contains name "*"))

let jsonHeader headers =
  match Headers.getAll "Content-Type" headers with
  | media :: [] -> jsonMedia media
  | _ -> false

checkHead : Expectation -> ResponseHead -> Result Unit Error
let checkHead expectation response =
  if expectation = JsonSuccess && not (jsonHeader response.headers) then
    Err (UnsupportedJsonMediaType response (Headers.get "Content-Type" response.headers))
  else
    Ok ()

/// Decode a buffered response without effects, using the same status, media,
/// and size rules as live requests. This is also a deterministic testing seam.
public decodeResponse : Config -> Request 'a -> Response Bytes -> Result (Response 'a) Error
let decodeResponse cfg req response =
  match validateConfig cfg with
  | Err error -> Err error
  | Ok _ -> decodeBuffered cfg req response

decodeBuffered : Config -> Request 'a -> Response Bytes -> Result (Response 'a) Error
let decodeBuffered cfg req response =
  match req with
  | MkRequest info decode ->
    if info.expectation <> AnyStatus && not (successful response.head.status) then
      Err (UnexpectedStatus response.head (Bytes.slice 0 cfg.maxErrorBytes response.body) (Bytes.length response.body > cfg.maxErrorBytes))
    else
      match checkHead info.expectation response.head with
      | Err error -> Err error
      | Ok _ ->
        if Bytes.length response.body > cfg.maxBodyBytes then
          Err (BodyTooLarge response.head cfg.maxBodyBytes)
        else
          Result.map (fun value -> {
            body = value,
            head = response.head
          }) (decode response.head response.body)

// A balanced concatenation avoids quadratic copying with small network chunks.
let joinRange chunks start count =
  if count = 0 then
    Bytes.empty
  else if count = 1 then
    Array.unsafeGet start chunks
  else
    let half = count / 2
    Bytes.concat (joinRange chunks start half) (joinRange chunks (start + half) (count - half))

let join chunks = joinRange chunks 0 (Array.length chunks)

readPrefix : ResponseHead -> Int -> Stream Bytes 'e -> Array Bytes -> Result (Bytes * Bool) Error / 'e
let readPrefix head remaining stream chunks =
  match Stream.uncons stream with
  | Err message -> Err (BodyRead head message)
  | Ok None -> Ok (join chunks, false)
  | Ok (Some (bytes, rest)) ->
    if Bytes.length bytes = 0 then
      readPrefix head remaining rest chunks
    else if Bytes.length bytes > remaining then
      Ok (join (Array.push (Bytes.slice 0 remaining bytes) chunks), true)
    else
      readPrefix head (remaining - Bytes.length bytes) rest (Array.push bytes chunks)

type Capabilities = { clock : Clock, concurrency : Concurrency, net : Net, tls : Tls }

/// A scoped pool and its immutable configuration. Use only inside withClient.
public opaque type Client =
  | MkClient Config Capabilities Http.Client

/// Validate configuration and run a callback with a reusable connection pool.
public withClient : { clock : Clock, concurrency : Concurrency, net : Net, tls : Tls | 'r } -> Config -> (Client -> Result 'a Error / 'e) -> Result 'a Error / { Concurrency | 'e }
let withClient env cfg callback =
  match validateConfig cfg with
  | Err error -> Err error
  | Ok _ ->
    Http.withClientWith env cfg.extraRoots (fun pool ->
      callback (MkClient cfg {
        clock = env.clock,
        concurrency = env.concurrency,
        net = env.net,
        tls = env.tls
      } pool))

bufferResponse : Config -> Request 'a -> ResponseHead -> Stream Bytes 'e -> Result (Response 'a) Error / 'e
let bufferResponse cfg req head body =
  match req with
  | MkRequest info _ ->
    let rejected = info.expectation <> AnyStatus && not (successful head.status)
    let limit = if rejected then cfg.maxErrorBytes else cfg.maxBodyBytes
    match (if rejected then Ok () else checkHead info.expectation head) with
    | Err error -> Err error
    | Ok _ ->
      match readPrefix head limit body Array.empty with
      | Err error -> Err error
      | Ok (bytes, truncated) ->
        if rejected then
          Err (UnexpectedStatus head bytes truncated)
        else if truncated then
          Err (BodyTooLarge head limit)
        else
          decodeResponse cfg req { body = bytes, head = head }

/// Consume and decode a response stream with bounded buffering. Pure streams
/// make chunk-boundary and body-failure behavior testable with ordinary contracts.
public decodeStream : Config -> Request 'a -> Response (Stream Bytes 'e) -> Result (Response 'a) Error / 'e
let decodeStream cfg req response =
  match validateConfig cfg with
  | Err error -> Err error
  | Ok _ -> bufferResponse cfg req response.head response.body

deadlineTimer : Concurrency -> Clock -> Int -> Channel (Result 'a Error) -> Unit / { Clock, Concurrency }
let deadlineTimer c clock ms output =
  let slept = clock.sleep ms
  c.send output (Err DeadlineExceeded)

deadlineScope : Concurrency -> Clock -> Option Int -> (Unit -> Result 'a Error / 'e) -> Nursery -> Result 'a Error / { Clock, Concurrency | 'e }
let deadlineScope c clock timeout work nursery =
  let output = c.channel 1
  let worker = c.spawn nursery (fun _ -> c.send output (work ()))
  let timer =
    match timeout with
    | None -> None
    | Some ms -> Some (c.spawn nursery (fun _ -> deadlineTimer c clock ms output))
  let received = c.recv output
  let cancelledWorker = c.cancel worker
  let cancelledTimer =
    match timer with
    | None -> ()
    | Some task -> c.cancel task
  let closed = c.close output
  match received with
  | None -> Err Cancelled
  | Some result -> result

deadline : Capabilities -> Option Int -> (Unit -> Result 'a Error / 'e) -> Result 'a Error / { Clock, Concurrency | 'e }
let deadline env timeout work =
  env.concurrency.scope (deadlineScope env.concurrency env.clock timeout work)

type Exchange 'a =
  | Finished 'a
  | Again Prepared Int Int Int

wireRequest : Prepared -> Http.Request 'e
let wireRequest wire = {
  body = Http.bytesBody wire.body,
  headers = wire.headers,
  method = wire.method,
  url = wire.url
}

chooseResponse : Config -> Capabilities -> Prepared -> Int -> Int -> Int -> (Response (Stream Bytes { Concurrency, Net, Tls }) -> Result 'a Error / 'e) -> Http.Response { Concurrency, Net, Tls } -> Result (Exchange 'a) Error / { Clock | 'e }
let chooseResponse cfg env wire retries redirects attempts consume response =
  let now = Int.floorDiv (env.clock.now ()) 1000
  match HttpClientPolicy.decide (policySettings cfg) wire response.status response.headers retries redirects now with
  | HttpClientPolicy.InvalidRedirect message -> Err (InvalidRequest message)
  | HttpClientPolicy.RedirectLimit limit -> Err (RedirectLimit limit)
  | HttpClientPolicy.Follow next -> Ok (Again next retries (redirects + 1) 0)
  | HttpClientPolicy.RetryAfter delay -> Ok (Again wire (retries + 1) redirects delay)
  | HttpClientPolicy.Return ->
    Result.map Finished (consume {
      body = response.body,
      head = {
        attempts = attempts,
        headers = response.headers,
        reason = response.reason,
        status = response.status,
        url = wire.url
      }
    })

// Every next exchange starts after the previous response scope has ended.
// The consumer sees only the final response and is never retried.
exchange : Config -> Capabilities -> Http.Client -> Prepared -> Int -> Int -> Int -> (Response (Stream Bytes { Concurrency, Net, Tls }) -> Result 'a Error / 'e) -> Result 'a Error / { Clock, Concurrency, Net, Tls | 'e }
let exchange cfg env pool wire retries redirects attempts consume =
  match Http.withResponseOn env pool (wireRequest wire) (chooseResponse cfg env wire retries redirects attempts consume) with
  | Err message -> Err (Transport message)
  | Ok (Err error) -> Err error
  | Ok (Ok (Finished result)) -> Ok result
  | Ok (Ok (Again next retries redirects delay)) ->
    let slept = if delay > 0 then env.clock.sleep delay else ()
    exchange cfg env pool next retries redirects (attempts + 1) consume

/// Execute and buffer a typed response. One deadline covers the full exchange.
public send : Client -> Request 'a -> Result (Response 'a) Error / { Clock, Concurrency, Net, Tls }
let send client req =
  match client with
  | MkClient cfg env pool ->
    match prepare cfg req with
    | Err error -> Err error
    | Ok wire ->
      deadline env cfg.timeoutMs (fun _ -> exchange cfg env pool wire 0 0 1 (decodeStream cfg req))

streamResponse : Config -> Request Bytes -> (Response (Stream Bytes { Concurrency, Net, Tls }) -> Result 'a Error / 'e) -> Response (Stream Bytes { Concurrency, Net, Tls }) -> Result 'a Error / { Concurrency, Net, Tls | 'e }
let streamResponse cfg req consume response =
  match req with
  | MkRequest info _ ->
    if info.expectation <> AnyStatus && not (successful response.head.status) then
      match readPrefix response.head cfg.maxErrorBytes response.body Array.empty with
      | Err error -> Err error
      | Ok (bytes, truncated) -> Err (UnexpectedStatus response.head bytes truncated)
    else
      match checkHead info.expectation response.head with
      | Err error -> Err error
      | Ok _ -> consume response

/// Consume the final response inside its lifetime scope. The callback runs once
/// after redirects/retries, shares the overall deadline, and may return early.
/// Raw requests expose every status; expectBytes requires 2xx. The buffered-body
/// limit does not constrain streaming. Use the body only within this callback.
public withResponse : Client -> (Response (Stream Bytes { Concurrency, Net, Tls }) -> Result 'a Error / 'e) -> Request Bytes -> Result 'a Error / { Clock, Concurrency, Net, Tls | 'e }
let withResponse client consume req =
  match client with
  | MkClient cfg env pool ->
    match prepare cfg req with
    | Err error -> Err error
    | Ok wire ->
      deadline env cfg.timeoutMs (fun _ ->
        exchange cfg env pool wire 0 0 1 (streamResponse cfg req consume))

/// SSE-specific timeouts and buffering limits. None disables a timeout.
public type EventOptions = SseOptions.Events

/// Default connect/read-idle timeouts and decoder limits, with no total deadline.
public eventOptions : EventOptions
let eventOptions = SseOptions.events

/// Return StopEvents to finish a scoped event reader successfully.
public type EventDecision =
  | ContinueEvents
  | StopEvents

/// Progress is committed one protocol observation at a time, including ID-only
/// blocks and retry hints. received counts dispatched events across connections.
public type EventState = { lastEventId : String, received : Int, retryDelayMs : Option Int }

/// A normal end of an event connection or subscription.
public type EventEnd =
  | EventEof
  | EventStopped
  | EventNoContent

/// The normal stopping reason and the last committed protocol progress.
public type EventResult = { reason : EventEnd, state : EventState }

type EventOutcome =
  | EventEnded EventEnd
  | EventLost Error
  | EventRejected Error

type EventAttempt = { outcome : EventOutcome, state : EventState, url : Option Url }

let emptyEventState = { lastEventId = "", received = 0, retryDelayMs = None }

eventProgress : EventState -> Sse.Update -> EventState
let eventProgress state update =
  match update with
  | Sse.Checkpoint id -> { state with lastEventId = id }
  | Sse.Retry delay -> { state with retryDelayMs = Some delay }
  | Sse.Dispatch event -> { state with
    lastEventId = event.lastEventId,
    received = state.received + 1
  }

eventAttempt : ResponseHead -> EventState -> EventOutcome -> EventAttempt
let eventAttempt head state outcome = { outcome = outcome, state = state, url = Some head.url }

cancellationPoint : Concurrency -> Bool / { Concurrency }
let cancellationPoint c =
  let gate = c.channel 1
  let sent = c.send gate ()
  let alive = c.recv gate
  let closed = c.close gate
  alive <> None

readEvents : Capabilities -> EventOptions -> (Sse.Event -> Result EventDecision Error / 'e) -> ResponseHead -> Sse.Decoder -> Bytes -> Int -> Stream Bytes { Concurrency, Net, Tls } -> EventState -> EventAttempt / { Clock, Concurrency, Net, Tls | 'e }
let readEvents env options consume head decoder bytes index source state =
  match Sse.next decoder bytes index with
  | Err error -> eventAttempt head state (EventRejected (EventCodec error))
  | Ok progress ->
    match progress.update with
    | Some update ->
      let updated = eventProgress state update
      match update with
      | Sse.Dispatch event ->
        if not (cancellationPoint env.concurrency) then
          eventAttempt head state (EventRejected Cancelled)
        else
          match consume event with
          | Err error -> eventAttempt head updated (EventRejected error)
          | Ok StopEvents -> eventAttempt head updated (EventEnded EventStopped)
          | Ok ContinueEvents ->
            readEvents env options consume head progress.decoder bytes progress.nextIndex source updated
      | _ ->
        readEvents env options consume head progress.decoder bytes progress.nextIndex source updated
    | None ->
      let read =
        deadline env options.readIdleTimeoutMs (fun _ ->
          Result.mapError (BodyRead head) (Stream.uncons source))
      match read with
      | Err DeadlineExceeded -> eventAttempt head state (EventLost EventIdleTimeout)
      | Err Cancelled -> eventAttempt head state (EventRejected Cancelled)
      | Err error -> eventAttempt head state (EventLost error)
      | Ok None -> eventAttempt head state (EventEnded EventEof)
      | Ok (Some (chunk, rest)) ->
        readEvents env options consume head progress.decoder chunk 0 rest state

let eventMedia headers =
  match Headers.getAll "Content-Type" headers with
  | media :: [] ->
    String.toLower (String.trim (Option.withDefault "" (List.head (String.split ";" media)))) = "text/event-stream"
  | _ -> false

cancelTimer : Concurrency -> Option (Task Unit) -> Unit / { Concurrency }
let cancelTimer c timer =
  match timer with
  | None -> ()
  | Some task -> c.cancel task

consumeEventResponse : Capabilities -> EventOptions -> Prepared -> EventState -> Option (Task Unit) -> (ResponseHead -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> Response (Stream Bytes { Concurrency, Net, Tls }) -> Result EventAttempt Error / { Clock, Concurrency, Net, Tls | 'e }
let consumeEventResponse env options wire previous timer connected consume response =
  let stoppedTimer = cancelTimer env.concurrency timer
  let state =
    if sameOrigin wire.url response.head.url then previous else { previous with lastEventId = "" }
  if response.head.status = 204 then
    Ok (eventAttempt response.head state (EventEnded EventNoContent))
  else if response.head.status <> 200 then
    Ok (eventAttempt response.head state (EventRejected (EventStatus response.head)))
  else if not (eventMedia response.head.headers) then
    Ok (eventAttempt response.head state (EventRejected (EventMediaType response.head (Headers.get "Content-Type" response.head.headers))))
  else
    match connected response.head with
    | Err error -> Ok (eventAttempt response.head state (EventRejected error))
    | Ok _ ->
      match Sse.decoderFrom options.limits state.lastEventId with
      | Err error -> Ok (eventAttempt response.head state (EventRejected (EventCodec error)))
      | Ok decoder ->
        Ok (readEvents env options consume response.head decoder Bytes.empty 0 response.body state)

runEventConnection : Config -> Capabilities -> Http.Client -> EventOptions -> Prepared -> EventState -> Option (Task Unit) -> (ResponseHead -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> Channel EventAttempt -> Unit / { Clock, Concurrency, Net, Tls | 'e }
let runEventConnection cfg env pool options wire state timer connected consume output =
  let response =
    exchange cfg env pool wire 0 0 1 (consumeEventResponse env options wire state timer connected consume)
  let attempt =
    match response with
    | Ok attempt -> attempt
    | Err (Transport message) -> {
      outcome = EventLost (Transport message),
      state = state,
      url = None
    }
    | Err error -> { outcome = EventRejected error, state = state, url = None }
  env.concurrency.send output attempt

eventConnectTimer : Capabilities -> Int -> EventState -> Channel EventAttempt -> Unit / { Clock, Concurrency }
let eventConnectTimer env timeout state output =
  let slept = env.clock.sleep timeout
  env.concurrency.send output { outcome = EventLost EventConnectTimeout, state = state, url = None }

eventConnectionScope : Config -> Capabilities -> Http.Client -> EventOptions -> Prepared -> EventState -> (ResponseHead -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> Nursery -> EventAttempt / { Clock, Concurrency, Net, Tls | 'e }
let eventConnectionScope cfg env pool options wire state connected consume nursery =
  let output = env.concurrency.channel 1
  let timer =
    match options.connectTimeoutMs with
    | None -> None
    | Some timeout ->
      Some (env.concurrency.spawn nursery (fun _ -> eventConnectTimer env timeout state output))
  let worker =
    env.concurrency.spawn nursery (fun _ ->
      runEventConnection cfg env pool options wire state timer connected consume output)
  let received = env.concurrency.recv output
  let stoppedWorker = env.concurrency.cancel worker
  let stoppedTimer = cancelTimer env.concurrency timer
  let closed = env.concurrency.close output
  Option.withDefault { outcome = EventRejected Cancelled, state = state, url = None } received

eventConnection : Config -> Capabilities -> Http.Client -> EventOptions -> Prepared -> EventState -> (ResponseHead -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> EventAttempt / { Clock, Concurrency, Net, Tls | 'e }
let eventConnection cfg env pool options wire state connected consume =
  env.concurrency.scope (eventConnectionScope cfg env pool options wire state connected consume)

let eventResult attempt =
  match attempt.outcome with
  | EventEnded reason -> Ok { reason = reason, state = attempt.state }
  | EventLost error -> Err error
  | EventRejected error -> Err error

eventConfig : Config -> Config
let eventConfig cfg = { cfg with
  retry = HttpClientPolicy.noRetry,
  sensitiveHeaders = "Last-Event-ID" :: cfg.sensitiveHeaders
}

/// Read one SSE response (including POST-based APIs). Events are delivered in
/// order until EOF, 204, consumer stop, or error. SSE-specific timeouts replace
/// the client's overall timeout for this operation; callback time is not read idle.
public withEvents : Client -> EventOptions -> (Sse.Event -> Result EventDecision Error / 'e) -> Request Bytes -> Result EventResult Error / { Clock, Concurrency, Net, Tls | 'e }
let withEvents client options consume request =
  match SseOptions.validateEvents options with
  | Err message -> Err (InvalidConfiguration message)
  | Ok _ ->
    match client with
    | MkClient original env pool ->
      let cfg = eventConfig original
      match prepare cfg (header "Accept" "text/event-stream" request) with
      | Err error -> Err error
      | Ok wire ->
        deadline env options.subscriptionTimeoutMs (fun _ ->
          eventResult (eventConnection cfg env pool options wire emptyEventState (fun _ ->
            Ok ()) consume))

/// All subscription durations, reconnect bounds, and the optional initial cursor.
public type SubscriptionOptions = SseOptions.Subscription

/// Default indefinite subscription settings; every duration is configurable.
public subscriptionOptions : SubscriptionOptions
let subscriptionOptions = SseOptions.subscription

/// Lifecycle observations are sequential with event delivery. Returning an error
/// from an observer stops the subscription just like an event consumer error.
public type SubscriptionNotice =
  | EventOpening Int
  | EventConnected ResponseHead
  | EventReconnecting { cause : Option Error, connection : Int, delayMs : Int, state : EventState }

resumeHeaders : EventState -> Prepared -> Result Prepared Error
let resumeHeaders state wire =
  if not (SseOptions.validResumeId state.lastEventId) then
    Err (InvalidRequest "SSE event ID cannot be represented as an HTTP header")
  else
    let headers =
      if state.lastEventId = "" then
        Headers.remove "Last-Event-ID" wire.headers
      else
        Headers.set "Last-Event-ID" state.lastEventId wire.headers
    Ok { wire with headers = headers }

reconnectWire : Config -> Prepared -> EventAttempt -> Prepared
let reconnectWire cfg wire attempt =
  match attempt.url with
  | None -> wire
  | Some url ->
    let headers =
      if sameOrigin wire.url url then
        wire.headers
      else
        List.foldl (fun headers name ->
          Headers.remove name headers) wire.headers (policySettings cfg).sensitiveHeaders
    { wire with headers = headers, url = url }

subscriptionLoop : Config -> Capabilities -> Http.Client -> SubscriptionOptions -> Prepared -> EventState -> Int -> (SubscriptionNotice -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> Result EventResult Error / { Clock, Concurrency, Net, Tls | 'e }
let subscriptionLoop cfg env pool options wire state reconnects observe consume =
  if not (cancellationPoint env.concurrency) then
    Err Cancelled
  else
    match resumeHeaders state wire with
    | Err error -> Err error
    | Ok prepared ->
      match observe (EventOpening (reconnects + 1)) with
      | Err error -> Err error
      | Ok _ ->
        let attempt =
          eventConnection cfg env pool options.events prepared state (fun head ->
            observe (EventConnected head)) consume
        match attempt.outcome with
        | EventRejected error -> Err error
        | EventEnded EventStopped -> Ok { reason = EventStopped, state = attempt.state }
        | EventEnded EventNoContent -> Ok { reason = EventNoContent, state = attempt.state }
        | _ ->
          let exhausted =
            match options.maxReconnects with
            | None -> false
            | Some limit -> reconnects >= limit
          if exhausted then
            Err (EventReconnectLimit reconnects)
          else
            let delay = SseOptions.reconnectDelay options attempt.state.retryDelayMs
            let cause =
              match attempt.outcome with
              | EventLost error -> Some error
              | _ -> None
            match observe (EventReconnecting {
              cause = cause,
              connection = reconnects + 2,
              delayMs = delay,
              state = attempt.state
            }) with
            | Err error -> Err error
            | Ok _ ->
              let slept = if delay > 0 then env.clock.sleep delay else ()
              subscriptionLoop cfg env pool options (reconnectWire cfg prepared attempt) attempt.state (reconnects + 1) observe consume

/// Subscribe with lifecycle notifications. Only GET is replayed. EOF, connection
/// loss and read-idle expiry reconnect; 204 and consumer stop succeed, while
/// status/media/codec/consumer errors are terminal. One optional total deadline
/// covers connections, consumers, notices and all reconnect delays.
public subscribeEventsWith : Client -> SubscriptionOptions -> (SubscriptionNotice -> Result Unit Error / 'e) -> (Sse.Event -> Result EventDecision Error / 'e) -> String -> Result EventResult Error / { Clock, Concurrency, Net, Tls | 'e }
let subscribeEventsWith client options observe consume target =
  match SseOptions.validateSubscription options with
  | Err message -> Err (InvalidConfiguration message)
  | Ok _ ->
    match client with
    | MkClient original env pool ->
      let cfg = eventConfig original
      match prepare cfg (header "Accept" "text/event-stream" (get target)) with
      | Err error -> Err error
      | Ok wire ->
        let initial = { emptyEventState with lastEventId = options.initialLastEventId }
        deadline env options.events.subscriptionTimeoutMs (fun _ ->
          subscriptionLoop cfg env pool options wire initial 0 observe consume)

/// A reconnecting GET subscription without lifecycle notifications. Defaults
/// reconnect until stopped; every duration and the reconnect count are configurable.
public subscribeEvents : Client -> SubscriptionOptions -> (Sse.Event -> Result EventDecision Error / 'e) -> String -> Result EventResult Error / { Clock, Concurrency, Net, Tls | 'e }
let subscribeEvents client options consume target =
  subscribeEventsWith client options (fun _ -> Ok ()) consume target

/// Render a structured failure for a console or log.
public errorToString : Error -> String
let errorToString error =
  match error with
  | InvalidConfiguration message -> "invalid client configuration: " ++ message
  | InvalidRequest message -> "invalid request: " ++ message
  | Encoding error -> "request JSON: " ++ JsonEncode.errorToString error
  | Transport message -> "HTTP transport: " ++ message
  | BodyRead head message -> "response body: " ++ message
  | DeadlineExceeded -> "HTTP deadline exceeded"
  | Cancelled -> "HTTP operation cancelled"
  | RedirectLimit limit -> "HTTP redirect limit exceeded: " ++ Int.toString limit
  | UnexpectedStatus head bytes truncated -> "unexpected HTTP status " ++ Int.toString head.status
  | BodyTooLarge head limit -> "response body exceeds " ++ Int.toString limit ++ " bytes"
  | UnsupportedJsonMediaType head media -> "expected a JSON Content-Type"
  | InvalidJson head error -> "invalid response JSON: " ++ JsonDecode.readErrorToString error
  | InvalidText head -> "response body is not valid UTF-8"
  | ConsumerFailure message -> "response consumer: " ++ message
  | EventCodec error -> "SSE: " ++ Sse.errorToString error
  | EventMediaType head media -> "expected text/event-stream"
  | EventStatus head -> "unexpected SSE status " ++ Int.toString head.status
  | EventConnectTimeout -> "SSE connection timeout"
  | EventIdleTimeout -> "SSE read idle timeout"
  | EventReconnectLimit count -> "SSE reconnect limit reached: " ++ Int.toString count
