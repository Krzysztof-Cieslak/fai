module JsonEffects

import json.JsonDecode
import json.JsonEncode

source : Console -> Unit -> Stream Bytes { Console } / { Console }
let source console unit =
  let printed = console.writeLine "read"
  Http.stringBody "42"

handler : Console -> Int -> Web.HttpHandler { Console }
let handler console value ctx =
  let printed = console.writeLine "handled"
  Web.jsonWith JsonEncode.int value ctx

evaluate : Console -> Result Int String / { Console }
let evaluate console =
  match Web.mockContext Http.POST "/" with
  | Err e -> Err e
  | Ok ctx ->
    let request = ctx.request
    let ctx = { ctx with
      request = { request with
        body = Stream.defer (source console),
        headers = Headers.set "Content-Type" "application/json" Headers.empty
      }
    }
    let outcome = Web.bindJson JsonDecode.int (handler console) ctx
    match Web.outcomeResponse outcome with
    | None -> Err "failed"
    | Some response -> Ok response.status

public main : Runtime -> Unit / { Console }
let main runtime =
  match evaluate runtime.console with
  | Err error -> runtime.console.writeLine error
  | Ok status -> runtime.console.writeLine (Int.toString status)

tests : Test.Suite Test.Context { Console }
let tests = Test.describe "JSON handler effects" [
  Test.test "effectful source and handler produce a response" (fun ctx ->
    Expect.ok identity (Expect.equal Int.toString 200) (evaluate ctx.runtime.console))
]
