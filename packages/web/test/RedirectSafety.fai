module RedirectSafety

app : Web.HttpHandler 'e
let app = Web.redirect (Url.decodeComponent "/safe%0D%0AX-Injected:%20yes")

fetch : Runtime -> Int -> String / { Net }
let fetch runtime port =
  match runtime.net.connect "127.0.0.1" port with
  | Err e -> e
  | Ok connection ->
    match runtime.net.send connection (Bytes.fromString "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n") with
    | Err e -> e
    | Ok sent ->
      match runtime.net.recv connection 4096 with
      | Err e -> e
      | Ok bytes -> if Bytes.isEmpty bytes then "rejected" else "wrote bytes"

serveThenFetch : Runtime -> Listener -> Nursery -> String / { Concurrency, Net, Tls }
let serveThenFetch runtime listener nursery =
  let server = runtime.concurrency.spawn nursery (fun _ -> Web.serveListener runtime listener app)
  let result = fetch runtime (runtime.net.localPort listener)
  let stopped = runtime.concurrency.cancel server
  result

response : Runtime -> Result String String / { Concurrency, Net, Tls }
let response runtime =
  match runtime.net.listen 0 with
  | Err error -> Err error
  | Ok listener -> Ok (runtime.concurrency.scope (serveThenFetch runtime listener))

public main : Runtime -> Unit / { Concurrency, Console, Net, Tls }
let main runtime =
  match response runtime with
  | Err e -> runtime.console.writeLine e
  | Ok result -> runtime.console.writeLine result

tests : Test.Suite Test.Context { Concurrency, Net, Tls }
let tests = Test.describe "redirect safety" [
  Test.test "header injection is rejected before bytes are sent" (fun ctx ->
    Expect.ok identity (Expect.equal identity "rejected") (response ctx.runtime))
]
