module LogSink

public type Sink 'e = LogTypes.Sink 'e

public type Output 'e = LogTypes.Output 'e

/// Give unnamed failures the destination's identity while retaining native detail.
public at : String -> LogTypes.Error -> LogTypes.Error
let at name error = { error with
  failures = List.map (fun failure -> { failure with
    destination = if failure.destination = "" then name else failure.destination
  }) error.failures
}

send : String -> LogTypes.Limits -> LogFormat.Format -> Output 'e -> LogTypes.Record -> Result (List LogTypes.Outcome) LogTypes.Error / 'e
let send name limits format output record =
  match LogFormat.render limits format record with
  | Err error -> Err (at name error)
  | Ok line ->
    Result.map (fun delivery -> [
      { delivery = delivery, destination = name }
    ]) (Result.mapError (at name) (output.writeLine line))

/// Format one complete record before invoking the line output once.
public formatted : String -> LogTypes.Limits -> LogFormat.Format -> Output 'e -> Sink 'e
let formatted name limits format output = {
  emit = send name limits format output,
  flush = fun _ -> Result.mapError (at name) (output.flush ()),
  names = [name]
}

public validate : Sink 'e -> Result Unit LogTypes.Error
let validate sink = validateWith LogTypes.limits.maxDestinations sink

public validateWith : Int -> Sink 'e -> Result Unit LogTypes.Error
let validateWith limit sink =
  if limit <= 0 || sink.names = [] || List.length sink.names > limit || List.any (fun name ->
    name = "") sink.names || Set.size (Set.fromList sink.names) <> List.length sink.names then
    Err (LogTypes.error LogTypes.Configuration "" "destinations must have distinct nonempty names within the configured limit")
  else
    Ok ()

join : Result (List LogTypes.Outcome) LogTypes.Error -> Result (List LogTypes.Outcome) LogTypes.Error -> Result (List LogTypes.Outcome) LogTypes.Error
let join first second =
  match (first, second) with
  | (Ok a, Ok b) -> Ok (List.append a b)
  | (Err a, Ok b) -> Err { a with outcomes = List.append a.outcomes b }
  | (Ok a, Err b) -> Err { b with outcomes = List.append a b.outcomes }
  | (Err a, Err b) -> Err {
    failures = List.append a.failures b.failures,
    outcomes = List.append a.outcomes b.outcomes
  }

sendBoth : Sink 'e -> Sink 'e -> LogTypes.Record -> Result (List LogTypes.Outcome) LogTypes.Error / 'e
let sendBoth first second record =
  let a = first.emit record
  let b = second.emit record
  join a b

flushBoth : Sink 'e -> Sink 'e -> Unit -> Result Unit LogTypes.Error / 'e
let flushBoth first second unit =
  let a = Result.map (fun _ -> []) (first.flush ())
  let b = Result.map (fun _ -> []) (second.flush ())
  Result.map (fun _ -> ()) (join a b)

/// Attempt each destination in registration order, including after earlier errors.
/// The shared effect parameter unions differently effectful arguments.
public combine : Sink 'e -> Sink 'e -> Sink 'e
let combine first second = {
  emit = sendBoth first second,
  flush = flushBoth first second,
  names = List.append first.names second.names
}

/// A pure sink for applications that explicitly discard logging.
public discard : String -> Sink { }
let discard name = {
  emit = fun _ -> Ok [{ delivery = LogTypes.Completed, destination = name }],
  flush = fun _ -> Ok (),
  names = [name]
}

public type FlushPolicy =
  | EachRecord
  | OnFlush

public type FileOptions = { flush : FlushPolicy, mode : FileSystem.WriteMode }

public fileOptions : FileOptions
let fileOptions = { flush = EachRecord, mode = FileSystem.Append }

/// Outputs receive one unterminated line and add exactly one newline.
public validateLine : String -> Result Unit LogTypes.Error
let validateLine line =
  if String.contains line "\n" || String.contains line "\r" then
    Err (LogTypes.error LogTypes.Validation "" "a log line contains a raw newline")
  else
    Ok ()

consoleWrite : Console -> Bool -> String -> Result LogTypes.Delivery LogTypes.Error / { Console }
let consoleWrite console stderr line =
  match validateLine line with
  | Err error -> Err error
  | Ok _ ->
    let written = if stderr then console.writeError line else console.writeLine line
    Ok LogTypes.Completed

/// Console exposes no OS write error or explicit flush result.
public stdout : Console -> Output { Console }
let stdout console = { flush = fun _ -> Ok (), writeLine = consoleWrite console false }

public stderr : Console -> Output { Console }
let stderr console = { flush = fun _ -> Ok (), writeLine = consoleWrite console true }

writerWrite : FileSystem -> Writer -> FlushPolicy -> String -> Result LogTypes.Delivery LogTypes.Error / { FileSystem }
let writerWrite fs writer policy line =
  match validateLine line with
  | Err error -> Err error
  | Ok _ ->
    match fs.writeChunk writer (Bytes.fromString (line ++ "\n")) with
    | Err error -> Err (LogTypes.nativeError LogTypes.Write "" error)
    | Ok _ ->
      let flushed = if policy = EachRecord then fs.flushWriter writer else Ok ()
      Result.map (fun _ ->
        LogTypes.Completed) (Result.mapError (LogTypes.nativeError LogTypes.Flush "") flushed)

/// Borrow a writer. The caller owns close; one native write keeps records intact.
public writer : FileSystem -> Writer -> FlushPolicy -> Output { FileSystem }
let writer fs handle policy = {
  flush = fun _ -> Result.mapError (LogTypes.nativeError LogTypes.Flush "") (fs.flushWriter handle),
  writeLine = writerWrite fs handle policy
}

/// Scope a file output. Retained output/logger aliases expire on return.
public withFile : { concurrency : Concurrency, fs : FileSystem | _ } -> FileOptions -> Path -> (Output { FileSystem } -> Result 'a 'error / 'e) -> Result 'a (LogTypes.ScopeError 'error) / { Concurrency, FileSystem | 'e }
let withFile env options path work =
  match env.fs.openWriter path options.mode with
  | Err error -> Err { body = None, cleanup = Some (LogTypes.nativeError LogTypes.Open "" error) }
  | Ok handle ->
    let result = work (writer env.fs handle options.flush)
    let closed = Wire.cleanup env.concurrency (fun _ -> env.fs.closeWriter handle)
    LogTypes.scopeResult result (Result.mapError (LogTypes.nativeError LogTypes.Close "") closed)

locked : Concurrency -> Channel Unit -> (Unit -> Result 'a LogTypes.Error / 'e) -> Result 'a LogTypes.Error / { Concurrency | 'e }
let locked concurrency gate work =
  match concurrency.recv gate with
  | None ->
    Err (LogTypes.asKind LogTypes.Cancelled (LogTypes.error LogTypes.Admission "" "logging operation cancelled"))
  | Some _ ->
    let result = work ()
    let released = Wire.cleanup concurrency (fun _ -> concurrency.send gate ())
    result

serialWrite : Concurrency -> Channel Unit -> Output 'e -> String -> Result LogTypes.Delivery LogTypes.Error / { Concurrency | 'e }
let serialWrite concurrency gate output line =
  locked concurrency gate (fun _ -> output.writeLine line)

serialFlush : Concurrency -> Channel Unit -> Output 'e -> Unit -> Result Unit LogTypes.Error / { Concurrency | 'e }
let serialFlush concurrency gate output unit = locked concurrency gate (fun _ -> output.flush ())

/// Share this wrapper to serialize a custom output's complete operations.
public serialized : Concurrency -> Output 'e -> Output { Concurrency | 'e } / { Concurrency }
let serialized concurrency output =
  let gate = concurrency.channel 1
  let seeded = Wire.cleanup concurrency (fun _ -> concurrency.send gate ())
  { flush = serialFlush concurrency gate output, writeLine = serialWrite concurrency gate output }
