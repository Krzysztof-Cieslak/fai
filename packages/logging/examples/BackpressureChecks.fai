module LogBackpressureChecks

stalled : Concurrency -> Channel Unit -> Channel Unit -> Channel Bool -> Bool -> String -> Result LogTypes.Delivery Log.Error / { Concurrency }
let stalled c entered release first fail line =
  let initial = Option.withDefault false (c.recv first)
  let restored = c.send first false
  if initial then
    let signalled = c.send entered ()
    let released = c.recv release
    if fail then
      Err (LogTypes.error LogTypes.Write "test" "stalled failure")
    else
      Ok LogTypes.Completed
  else
    Ok LogTypes.Completed

waitBlocked : Runtime -> LogQueue.Queue -> Bool / { Clock, Concurrency }
let waitBlocked env queue =
  let snapshot = queue.snapshot ()
  if snapshot.summary.blockedAdmissions > 0 then
    snapshot.pendingRecords > 0
  else
    let slept = env.clock.sleep 1
    waitBlocked env queue

pressureBody : Runtime -> LogQueue.Queue -> Channel Unit -> Channel Unit -> Bool -> Bool -> Nursery -> Result Bool Log.Error / { Clock, Concurrency }
let pressureBody env queue entered release bytes fail nursery =
  let one = queue.output.writeLine "aa"
  let active = env.concurrency.recv entered
  let two = if bytes then queue.output.writeLine "bb" else Ok LogTypes.Completed
  let blocked = env.concurrency.spawn nursery (fun _ -> queue.output.writeLine "cc")
  let waited = waitBlocked env queue
  let before = queue.snapshot ()
  let released = env.concurrency.send release ()
  let last = env.concurrency.await blocked
  let flushed = queue.output.flush ()
  let good =
    waited && Result.isOk one && Result.isOk two && before.pendingRecords = (if bytes then
      2
    else
      1) && before.pendingBytes = (if bytes then
      6
    else
      3) && (if fail then
      Result.isErr last && Result.isErr flushed
    else
      Result.isOk last && Result.isOk flushed)
  if good then
    Ok true
  else
    Err (LogTypes.error LogTypes.Admission "test" "backpressure invariant failed")

pressure : Runtime -> Bool -> Bool -> Bool / { Clock, Concurrency }
let pressure env bytes fail =
  let entered = env.concurrency.channel 1
  let release = env.concurrency.channel 1
  let first = env.concurrency.channel 1
  let seeded = env.concurrency.send first true
  let output = {
    flush = fun _ -> Ok (),
    writeLine = stalled env.concurrency entered release first fail
  }
  let options = { LogQueue.defaults with
    maxBytes = if bytes then 6 else 64,
    maxRecordBytes = 6,
    maxRecords = if bytes then 8 else 1
  }
  let result =
    LogQueue.withQueue env options output (fun queue ->
      env.concurrency.scope (pressureBody env queue entered release bytes fail))
  match result with
  | Ok result -> not fail && result.value && result.summary.completed = (if bytes then 3 else 2)
  | Err error ->
    fail && error.body = None && error.summary.failed = 1 && error.summary.abandoned = (if bytes then
      1
    else
      0)

waitStopped : Runtime -> LogQueue.Queue -> Unit / { Clock, Concurrency }
let waitStopped env queue =
  if (queue.snapshot ()).summary.failure <> None then
    ()
  else
    let slept = env.clock.sleep 1
    waitStopped env queue

closingBody : Runtime -> Channel LogQueue.Queue -> Channel Unit -> Channel Unit -> Bool -> LogQueue.Queue -> Result Unit String / { Concurrency }
let closingBody env published entered bodyGate cancel queue =
  let first = queue.output.writeLine "aa"
  let active = env.concurrency.recv entered
  let second = queue.output.writeLine "bb"
  let sent = env.concurrency.send published queue
  let wait = if cancel then env.concurrency.recv bodyGate else Some ()
  if Result.isOk first && Result.isOk second then Ok () else Err "admission failed"

closingScope : Runtime -> Bool -> Nursery -> Bool / { Clock, Concurrency }
let closingScope env cancel nursery =
  let published = env.concurrency.channel 1
  let entered = env.concurrency.channel 1
  let release = env.concurrency.channel 1
  let first = env.concurrency.channel 1
  let bodyGate = env.concurrency.channel 1
  let seeded = env.concurrency.send first true
  let output = {
    flush = fun _ -> Ok (),
    writeLine = stalled env.concurrency entered release first false
  }
  let options = { LogQueue.defaults with drainTimeoutMs = if cancel then None else Some 20 }
  let task =
    env.concurrency.spawn nursery (fun _ ->
      LogQueue.withQueue env options output (closingBody env published entered bodyGate cancel))
  match env.concurrency.recv published with
  | None -> false
  | Some queue ->
    let cancelled = if cancel then env.concurrency.cancel task else ()
    let stopped = waitStopped env queue
    let released = env.concurrency.send release ()
    let result = env.concurrency.await task
    let late = queue.output.writeLine "late"
    match result with
    | Ok _ -> false
    | Err error ->
      error.summary.accepted = 2 && error.summary.completed = 1 && error.summary.abandoned = 1 && error.summary.failure <> None && Result.isErr late

public main : Runtime -> Unit / { Clock, Concurrency, Console }
let main env =
  let records = pressure env false false
  let bytes = pressure env true false
  let failure = pressure env true true
  let deadline = env.concurrency.scope (closingScope env false)
  let cancel = env.concurrency.scope (closingScope env true)
  let admission = cancelledAdmission env
  let closed = env.concurrency.scope (normalClose env)
  env.console.writeLine (if records && bytes && failure && deadline && cancel && admission && closed then
    "logging backpressure checks passed"
  else
    "logging backpressure checks FAILED")

cancelAdmissionBody : Runtime -> Channel Unit -> Channel Unit -> LogQueue.Queue -> Nursery -> Result Bool Log.Error / { Clock, Concurrency }
let cancelAdmissionBody env entered release queue nursery =
  let first = queue.output.writeLine "aa"
  let active = env.concurrency.recv entered
  let task = env.concurrency.spawn nursery (fun _ -> queue.output.writeLine "bb")
  let waited = waitBlocked env queue
  let cancelled = env.concurrency.cancel task
  let result = env.concurrency.await task
  let before = queue.snapshot ()
  let released = env.concurrency.send release ()
  let flushed = queue.output.flush ()
  Ok (waited && before.summary.accepted = 1 && flushed = Ok () && (match result with
  | Err error ->
    List.all (fun failure ->
      failure.kind = LogTypes.Cancelled && not failure.uncertain) error.failures
  | _ -> false))

cancelledAdmission : Runtime -> Bool / { Clock, Concurrency }
let cancelledAdmission env =
  let entered = env.concurrency.channel 1
  let release = env.concurrency.channel 1
  let first = env.concurrency.channel 1
  let seeded = env.concurrency.send first true
  let output = {
    flush = fun _ -> Ok (),
    writeLine = stalled env.concurrency entered release first false
  }
  let result =
    LogQueue.withQueue env { LogQueue.defaults with
      maxRecords = 1
    } output (fun queue -> env.concurrency.scope (cancelAdmissionBody env entered release queue))
  match result with
  | Ok result -> result.value && result.summary.accepted = 1 && result.summary.completed = 1
  | _ -> false

waitClosing : Runtime -> LogQueue.Queue -> Unit / { Clock, Concurrency }
let waitClosing env queue =
  if not (queue.snapshot ()).accepting then
    ()
  else
    let slept = env.clock.sleep 1
    waitClosing env queue

normalClose : Runtime -> Nursery -> Bool / { Clock, Concurrency }
let normalClose env nursery =
  let published = env.concurrency.channel 1
  let entered = env.concurrency.channel 1
  let release = env.concurrency.channel 1
  let first = env.concurrency.channel 1
  let bodyGate = env.concurrency.channel 1
  let seeded = env.concurrency.send first true
  let output = {
    flush = fun _ -> Ok (),
    writeLine = stalled env.concurrency entered release first false
  }
  let task =
    env.concurrency.spawn nursery (fun _ ->
      LogQueue.withQueue env LogQueue.defaults output (closingBody env published entered bodyGate false))
  match env.concurrency.recv published with
  | None -> false
  | Some queue ->
    let closing = waitClosing env queue
    let rejected = queue.output.writeLine "late"
    let released = env.concurrency.send release ()
    let result = env.concurrency.await task
    match result with
    | Ok result ->
      result.summary.accepted = 2 && result.summary.completed = 2 && Result.isErr rejected
    | _ -> false

recordPressure : Test.Context -> Test.Check / { Clock, Concurrency }
let recordPressure ctx =
  Expect.isTrue "record budget blocks and resumes admission" (pressure ctx.runtime false false)

bytePressure : Test.Context -> Test.Check / { Clock, Concurrency }
let bytePressure ctx =
  Expect.isTrue "byte budget blocks and resumes admission" (pressure ctx.runtime true false)

failedPressure : Test.Context -> Test.Check / { Clock, Concurrency }
let failedPressure ctx =
  Expect.isTrue "blocked admission observes sink failure" (pressure ctx.runtime true true)

drainDeadline : Test.Context -> Test.Check / { Clock, Concurrency }
let drainDeadline ctx =
  Expect.isTrue "drain deadline preserves completed and abandoned counts" (ctx.runtime.concurrency.scope (closingScope ctx.runtime false))

cancelledDrain : Test.Context -> Test.Check / { Clock, Concurrency }
let cancelledDrain ctx =
  Expect.isTrue "cancellation releases queued work" (ctx.runtime.concurrency.scope (closingScope ctx.runtime true))

cancelledWrite : Test.Context -> Test.Check / { Clock, Concurrency }
let cancelledWrite ctx =
  Expect.isTrue "cancelled admission is not accepted" (cancelledAdmission ctx.runtime)

normalDrain : Test.Context -> Test.Check / { Clock, Concurrency }
let normalDrain ctx =
  Expect.isTrue "normal close drains accepted records" (ctx.runtime.concurrency.scope (normalClose ctx.runtime))

tests : Test.Suite Test.Context { Clock, Concurrency }
let tests = Test.describe "logging backpressure" [
  Test.test "record limit" recordPressure,
  Test.test "byte limit" bytePressure,
  Test.test "sink failure" failedPressure,
  Test.test "drain deadline" drainDeadline,
  Test.test "cancelled drain" cancelledDrain,
  Test.test "cancelled admission" cancelledWrite,
  Test.test "normal close" normalDrain
]
