module LogFileQueueChecks

import json.JsonDecode

writeLoop : Log.Logger { Concurrency } -> Int -> Result Unit Log.Error / { Concurrency }
let writeLoop logger count =
  if count <= 0 then
    Log.flush logger
  else
    match Log.info logger "queued record" [LogField.int "index" count] with
    | Err error -> Err error
    | Ok _ -> writeLoop logger (count - 1)

writeQueued : LogSink.Output { Concurrency } -> Result Unit Log.Error / { Concurrency }
let writeQueued output =
  match Log.create Log.defaults (LogSink.formatted "file" Log.limits LogFormat.JsonLines output) with
  | Err error -> Err error
  | Ok logger -> writeLoop logger 1000

queueFile : Runtime -> LogSink.Output { FileSystem } -> Result Bool String / { Clock, Concurrency, FileSystem }
let queueFile env output =
  match LogQueue.withOutput env { LogQueue.defaults with
    maxBytes = 2048,
    maxRecordBytes = 2048,
    maxRecords = 4
  } output writeQueued with
  | Err _ -> Err "queued file output failed"
  | Ok result ->
    Ok (result.summary.accepted = 1000 && result.summary.completed = 1000 && result.summary.peakBytes <= 2048 && result.summary.peakRecords <= 4)

check : Runtime -> Temp.Directory -> Result Test.Check String / { Clock, Concurrency, FileSystem }
let check env directory =
  let path =
    Path.join directory.path (Result.withDefault Path.empty (Path.fromString "queued.jsonl"))
  let result =
    LogSink.withFile env { LogSink.fileOptions with flush = LogSink.OnFlush } path (queueFile env)
  match env.fs.readFile path with
  | Err error -> Err (FileSystem.errorToString error)
  | Ok text ->
    let lines = List.filter (fun line -> line <> "") (String.split "\n" text)
    let indexes =
      List.map (JsonDecode.fromString (JsonDecode.field "fields" (JsonDecode.field "index" JsonDecode.int))) lines
    Ok (Expect.all [
      Expect.isTrue "all queued file records complete within queue budgets" (result = Ok true),
      Expect.isTrue "file contains every record in FIFO order" (indexes = List.map Ok (List.reverse (List.range 1 1001)))
    ])

public main : Runtime -> Unit / { Clock, Concurrency, Console, FileSystem }
let main env =
  match env.fs.temporaryDirectory () with
  | Err error -> env.console.writeLine (FileSystem.errorToString error)
  | Ok parent ->
    let result = Temp.withDirectory env parent (check env)
    env.console.writeLine (if result = Ok Test.pass then
      "queued file logging checks passed"
    else
      "queued file logging checks FAILED")

queuedFile : Test.Context -> Test.Check / { Clock, Concurrency, FileSystem }
let queuedFile ctx =
  Expect.ok LogIntegrationSupport.scopeError identity (Temp.withDirectory ctx.runtime ctx.tempRoot (check ctx.runtime))

tests : Test.Suite Test.Context { Clock, Concurrency, FileSystem }
let tests = Test.describe "queued file logging" [
  Test.test "one thousand complete FIFO records" queuedFile
]
