module LogEdgeSpec

import json.Json

let entry = Log.entry "message" []

let limits = Log.limits

let case001 _ =
  let testActual = LogField.merge limits [LogField.string "" "invalid"] |> Result.isErr
  Expect.isTrue "LogField.merge limits [LogField.string \"\" \"invalid\"] |> Result.isErr" testActual

let case002 _ =
  let testActual = LogField.merge { limits with maxFields = 0 } [LogField.int "x" 1] |> Result.isErr
  Expect.isTrue "LogField.merge { limits with maxFields = 0 } [LogField.int \"x\" 1] |> Result.isErr" testActual

let case003 _ =
  let testActual =
    LogField.merge { limits with
      maxValueNodes = 1
    } [LogField.int "x" 1, LogField.int "x" 2] |> Result.isErr
  Expect.isTrue "LogField.merge { limits with maxValueNodes = 1 } [LogField.int \"x\" 1, LogField.int \"x\" 2] |> Result.isErr" testActual

let case004 _ =
  let testActual =
    LogField.merge limits [
      LogField.string "timestamp" "user"
    ] = Ok (Json.Object [| ("timestamp", Json.String "user") |])
  Expect.isTrue "LogField.merge limits [ LogField.string \"timestamp\" \"user\" ] = Ok (Json.Object [| (\"timestamp\", Json.String \"user\") |])" testActual

let case005 _ =
  let testActual =
    Log.prepare Log.defaults "test" [] LogTypes.Info (Log.entry "nested" [
      LogField.json "x" (Json.Object [| ("duplicate", Json.Null), ("duplicate", Json.Null) |])
    ]) |> Result.isErr
  Expect.isTrue "Log.prepare Log.defaults \"test\" [] LogTypes.Info (Log.entry \"nested\" [ LogField.json \"x\" (Json.Object [| (\"duplicate\", Json.Null), (\"duplicate\", Json.Null) |…" testActual

let case006 _ =
  let testActual =
    Log.prepare { Log.defaults with
      minimum = None
    } "test" [] LogTypes.Fatal (Log.entry "hidden" [
      LogField.float "x" (Float.fromBits 0x7ff8000000000000)
    ]) = Ok None
  Expect.isTrue "Log.prepare { Log.defaults with minimum = None } \"test\" [] LogTypes.Fatal (Log.entry \"hidden\" [ LogField.float \"x\" (Float.fromBits 0x7ff8000000000000) ]) = O…" testActual

let case007 _ =
  let testActual =
    LogBudget.check { limits with maxRecordBytes = 3 } (Json.String "é") |> Result.isErr
  Expect.isTrue "LogBudget.check { limits with maxRecordBytes = 3 } (Json.String \"é\") |> Result.isErr" testActual

let case008 _ =
  let testActual = LogBudget.check { limits with maxRecordBytes = 4 } (Json.String "é") = Ok 4
  Expect.isTrue "LogBudget.check { limits with maxRecordBytes = 4 } (Json.String \"é\") = Ok 4" testActual

let case009 _ =
  let testActual = LogBudget.check { limits with maxRecordBytes = 4 } (Json.String "\n") = Ok 4
  Expect.isTrue "LogBudget.check { limits with maxRecordBytes = 4 } (Json.String \"\\n\") = Ok 4" testActual

let case010 _ =
  let testActual =
    LogBudget.check { limits with maxRecordBytes = 7 } (Json.String "\u{0}") |> Result.isErr
  Expect.isTrue "LogBudget.check { limits with maxRecordBytes = 7 } (Json.String \"\\u{0}\") |> Result.isErr" testActual

let case011 _ =
  let testActual = LogBudget.check { limits with maxRecordBytes = 8 } (Json.String "\u{0}") = Ok 8
  Expect.isTrue "LogBudget.check { limits with maxRecordBytes = 8 } (Json.String \"\\u{0}\") = Ok 8" testActual

let case012 _ =
  let testActual =
    LogFilter.enabled { Log.defaults with
      minimum = Some LogTypes.Fatal,
      overrides = [
        { minimum = Some LogTypes.Debug, target = "db" },
        { minimum = None, target = "db.pool" }
      ]
    } "db.cache" LogTypes.Debug
  Expect.isTrue "LogFilter.enabled { Log.defaults with minimum = Some LogTypes.Fatal, overrides = [ { minimum = Some LogTypes.Debug, target = \"db\" }, { minimum = None, target…" testActual

let case013 _ =
  let testActual =
    not (LogFilter.enabled { Log.defaults with
      overrides = [
        { minimum = Some LogTypes.Trace, target = "db" },
        { minimum = None, target = "db.pool" }
      ]
    } "db.pool.writer" LogTypes.Fatal)
  Expect.isTrue "not (LogFilter.enabled { Log.defaults with overrides = [ { minimum = Some LogTypes.Trace, target = \"db\" }, { minimum = None, target = \"db.pool\" } ] } \"db.poo…" testActual

let case014 _ =
  let testActual = LogSink.validateLine "line\nextra" |> Result.isErr
  Expect.isTrue "LogSink.validateLine \"line\\nextra\" |> Result.isErr" testActual

let case015 _ =
  let testActual = LogSink.validateLine "line\rextra" |> Result.isErr
  Expect.isTrue "LogSink.validateLine \"line\\rextra\" |> Result.isErr" testActual

let case016 _ =
  let testActual = LogSink.validateLine "" = Ok ()
  Expect.isTrue "LogSink.validateLine \"\" = Ok ()" testActual

let cleanupError = LogTypes.error LogTypes.Close "file" "close failed"

let case017 _ =
  let testActual =
    LogTypes.scopeResult (Err "body failed") (Err cleanupError) = Err {
      body = Some "body failed",
      cleanup = Some cleanupError
    }
  Expect.isTrue "LogTypes.scopeResult (Err \"body failed\") (Err cleanupError) = Err { body = Some \"body failed\", cleanup = Some cleanupError }" testActual

let case018 _ =
  let testActual =
    LogTypes.scopeResult (Ok 5) (Err cleanupError) = Err {
      body = None,
      cleanup = Some cleanupError
    }
  Expect.isTrue "LogTypes.scopeResult (Ok 5) (Err cleanupError) = Err { body = None, cleanup = Some cleanupError }" testActual

let case019 _ =
  let testActual = LogTypes.scopeResult (Ok 5) (Ok ()) = Ok 5
  Expect.isTrue "LogTypes.scopeResult (Ok 5) (Ok ()) = Ok 5" testActual

let case020 testInput =
  let (a, b) = testInput
  let testActual =
    LogField.merge limits [
      LogField.int "x" a,
      LogField.int "x" b
    ] = LogField.merge limits [LogField.int "x" b]
  Expect.isTrue "property: LogField.merge limits [ LogField.int \"x\" a, LogField.int \"x\" b ] = LogField.merge limits [LogField.int \"x\" b]" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "LogEdgeSpec" [
  Test.test "LogField.merge limits [LogField.string \"\" \"invalid\"] |> Result.isErr" case001,
  Test.test "LogField.merge { limits with maxFields = 0 } [LogField.int \"x\" 1] |> Result.isErr" case002,
  Test.test "LogField.merge { limits with maxValueNodes = 1 } [LogField.int \"x\" 1, LogField.int \"x\" 2] |> Result.isErr" case003,
  Test.test "LogField.merge limits [ LogField.string \"timestamp\" \"user\" ] = Ok (Json.Object [| (\"timestamp\", Json.String \"user\") |])" case004,
  Test.test "Log.prepare Log.defaults \"test\" [] LogTypes.Info (Log.entry \"nested\" [ LogField.json \"x\" (Json.Object [| (\"duplicate\", Json.Null), (\"duplicate\", Json.Null) |…" case005,
  Test.test "Log.prepare { Log.defaults with minimum = None } \"test\" [] LogTypes.Fatal (Log.entry \"hidden\" [ LogField.float \"x\" (Float.fromBits 0x7ff8000000000000) ]) = O…" case006,
  Test.test "LogBudget.check { limits with maxRecordBytes = 3 } (Json.String \"é\") |> Result.isErr" case007,
  Test.test "LogBudget.check { limits with maxRecordBytes = 4 } (Json.String \"é\") = Ok 4" case008,
  Test.test "LogBudget.check { limits with maxRecordBytes = 4 } (Json.String \"\\n\") = Ok 4" case009,
  Test.test "LogBudget.check { limits with maxRecordBytes = 7 } (Json.String \"\\u{0}\") |> Result.isErr" case010,
  Test.test "LogBudget.check { limits with maxRecordBytes = 8 } (Json.String \"\\u{0}\") = Ok 8" case011,
  Test.test "LogFilter.enabled { Log.defaults with minimum = Some LogTypes.Fatal, overrides = [ { minimum = Some LogTypes.Debug, target = \"db\" }, { minimum = None, target…" case012,
  Test.test "not (LogFilter.enabled { Log.defaults with overrides = [ { minimum = Some LogTypes.Trace, target = \"db\" }, { minimum = None, target = \"db.pool\" } ] } \"db.poo…" case013,
  Test.test "LogSink.validateLine \"line\\nextra\" |> Result.isErr" case014,
  Test.test "LogSink.validateLine \"line\\rextra\" |> Result.isErr" case015,
  Test.test "LogSink.validateLine \"\" = Ok ()" case016,
  Test.test "LogTypes.scopeResult (Err \"body failed\") (Err cleanupError) = Err { body = Some \"body failed\", cleanup = Some cleanupError }" case017,
  Test.test "LogTypes.scopeResult (Ok 5) (Err cleanupError) = Err { body = None, cleanup = Some cleanupError }" case018,
  Test.test "LogTypes.scopeResult (Ok 5) (Ok ()) = Ok 5" case019,
  Test.property "property: LogField.merge limits [ LogField.int \"x\" a, LogField.int \"x\" b ] = LogField.merge limits [LogField.int \"x\" b]" (Test.tuple2 Test.int Test.int) case020
]
