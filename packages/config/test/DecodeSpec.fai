module ConfigDecodeSpec

import toml.TomlTypes

let decode decoder source =
  match Config.toml Config.limits (ConfigTypes.origin ConfigTypes.Supplied "test.toml") (Bytes.fromString source) with
  | Err error -> Err [error]
  | Ok layer ->
    match Config.merge [layer] with
    | Err error -> Err [error]
    | Ok config -> ConfigDecode.decode decoder config

let text decoder value =
  match ConfigSource.snapshot Config.limits (ConfigTypes.origin ConfigTypes.Environment "env") [
    { name = "VALUE", path = ["value"] }
  ] [("VALUE", value)] with
  | Err error -> Err [error]
  | Ok layer ->
    match Config.merge [layer] with
    | Err error -> Err [error]
    | Ok config -> ConfigDecode.decode (ConfigDecode.field "value" decoder) config

let intField = ConfigDecode.field "value" ConfigDecode.int

let kinds result = Result.mapError (List.map (fun error -> error.kind)) result

let case001 _ =
  let testActual = decode intField "value=42" = Ok 42
  Expect.isTrue "decode intField \"value=42\" = Ok 42" testActual

let case002 _ =
  let testActual = kinds (decode intField "value='42'") = Err [ConfigTypes.WrongType]
  Expect.isTrue "kinds (decode intField \"value='42'\") = Err [ConfigTypes.WrongType]" testActual

let case003 _ =
  let testActual = text ConfigDecode.int "42" = Ok 42
  Expect.isTrue "text ConfigDecode.int \"42\" = Ok 42" testActual

let case004 _ =
  let testActual = text ConfigDecode.int "00042" = Ok 42
  Expect.isTrue "text ConfigDecode.int \"00042\" = Ok 42" testActual

let case005 _ =
  let testActual = text ConfigDecode.int "-9223372036854775808" = Ok (-9223372036854775807 - 1)
  Expect.isTrue "text ConfigDecode.int \"-9223372036854775808\" = Ok (-9223372036854775807 - 1)" testActual

let case006 _ =
  let testActual = text ConfigDecode.int "9223372036854775808" |> Result.isErr
  Expect.isTrue "text ConfigDecode.int \"9223372036854775808\" |> Result.isErr" testActual

let case007 _ =
  let testActual = text ConfigDecode.int "0x10" |> Result.isErr
  Expect.isTrue "text ConfigDecode.int \"0x10\" |> Result.isErr" testActual

let case008 _ =
  let testActual = text ConfigDecode.int "1_000" |> Result.isErr
  Expect.isTrue "text ConfigDecode.int \"1_000\" |> Result.isErr" testActual

let case009 _ =
  let testActual = text ConfigDecode.int " 42" |> Result.isErr
  Expect.isTrue "text ConfigDecode.int \" 42\" |> Result.isErr" testActual

let case010 _ =
  let testActual = text ConfigDecode.int "" |> Result.isErr
  Expect.isTrue "text ConfigDecode.int \"\" |> Result.isErr" testActual

let case011 _ =
  let testActual = text ConfigDecode.bool "false" = Ok false
  Expect.isTrue "text ConfigDecode.bool \"false\" = Ok false" testActual

let case012 _ =
  let testActual = text ConfigDecode.bool "False" |> Result.isErr
  Expect.isTrue "text ConfigDecode.bool \"False\" |> Result.isErr" testActual

let case013 _ =
  let testActual = text ConfigDecode.float "1.25e2" = Ok 125.0
  Expect.isTrue "text ConfigDecode.float \"1.25e2\" = Ok 125.0" testActual

let case014 _ =
  let testActual = text ConfigDecode.float "nan" |> Result.isErr
  Expect.isTrue "text ConfigDecode.float \"nan\" |> Result.isErr" testActual

let case015 _ =
  let testActual = text ConfigDecode.floatAll "inf" = Ok (Float.fromBits 0x7ff0000000000000)
  Expect.isTrue "text ConfigDecode.floatAll \"inf\" = Ok (Float.fromBits 0x7ff0000000000000)" testActual

let case016 _ =
  let testActual =
    decode (ConfigDecode.field "value" (ConfigDecode.withDefault 10 ConfigDecode.int)) "" = Ok 10
  Expect.isTrue "decode (ConfigDecode.field \"value\" (ConfigDecode.withDefault 10 ConfigDecode.int)) \"\" = Ok 10" testActual

let case017 _ =
  let testActual =
    kinds (decode (ConfigDecode.field "value" (ConfigDecode.withDefault 10 ConfigDecode.int)) "value='bad'") = Err [
      ConfigTypes.WrongType
    ]
  Expect.isTrue "kinds (decode (ConfigDecode.field \"value\" (ConfigDecode.withDefault 10 ConfigDecode.int)) \"value='bad'\") = Err [ ConfigTypes.WrongType ]" testActual

let case018 _ =
  let testActual = decode (ConfigDecode.optionalField "value" ConfigDecode.int) "" = Ok None
  Expect.isTrue "decode (ConfigDecode.optionalField \"value\" ConfigDecode.int) \"\" = Ok None" testActual

let case019 _ =
  let testActual =
    kinds (decode (ConfigDecode.optionalField "value" ConfigDecode.int) "value='bad'") = Err [
      ConfigTypes.WrongType
    ]
  Expect.isTrue "kinds (decode (ConfigDecode.optionalField \"value\" ConfigDecode.int) \"value='bad'\") = Err [ ConfigTypes.WrongType ]" testActual

let case020 _ =
  let testActual = kinds (decode intField "value=42\ntypo=1") = Err [ConfigTypes.UnknownField]
  Expect.isTrue "kinds (decode intField \"value=42\\ntypo=1\") = Err [ConfigTypes.UnknownField]" testActual

let case021 _ =
  let testActual = decode (ConfigDecode.allowUnknown intField) "value=42\nextra=1" = Ok 42
  Expect.isTrue "decode (ConfigDecode.allowUnknown intField) \"value=42\\nextra=1\" = Ok 42" testActual

let case022 _ =
  let testActual =
    kinds (decode (ConfigDecode.field "table" intField) "[table]\nvalue=1\ntypo=2") = Err [
      ConfigTypes.UnknownField
    ]
  Expect.isTrue "kinds (decode (ConfigDecode.field \"table\" intField) \"[table]\\nvalue=1\\ntypo=2\") = Err [ ConfigTypes.UnknownField ]" testActual

let two =
  ConfigDecode.map2 (fun a b ->
    (a, b)) (ConfigDecode.field "a" ConfigDecode.int) (ConfigDecode.field "b" ConfigDecode.bool)

let case023 _ =
  let testActual =
    kinds (decode two "a='bad'\nb=42") = Err [ConfigTypes.WrongType, ConfigTypes.WrongType]
  Expect.isTrue "kinds (decode two \"a='bad'\\nb=42\") = Err [ConfigTypes.WrongType, ConfigTypes.WrongType]" testActual

let case024 _ =
  let testActual =
    (match decode two "" with
    | Err errors ->
      List.map (fun error -> error.path) errors = [[TomlTypes.Key "a"], [TomlTypes.Key "b"]]
    | _ -> false)
  Expect.isTrue "(match decode two \"\" with | Err errors -> List.map (fun error -> error.path) errors = [[TomlTypes.Key \"a\"], [TomlTypes.Key \"b\"]] | _ -> false)" testActual

let case025 _ =
  let testActual =
    decode (ConfigDecode.field "values" (ConfigDecode.array ConfigDecode.int)) "values=[1,2,3]" = Ok [|
      1,
      2,
      3
    |]
  Expect.isTrue "decode (ConfigDecode.field \"values\" (ConfigDecode.array ConfigDecode.int)) \"values=[1,2,3]\" = Ok [| 1, 2, 3 |]" testActual

let case026 _ =
  let testActual =
    kinds (decode (ConfigDecode.field "values" (ConfigDecode.array ConfigDecode.int)) "values=['bad',true]") = Err [
      ConfigTypes.WrongType,
      ConfigTypes.WrongType
    ]
  Expect.isTrue "kinds (decode (ConfigDecode.field \"values\" (ConfigDecode.array ConfigDecode.int)) \"values=['bad',true]\") = Err [ ConfigTypes.WrongType, ConfigTypes.WrongType ]" testActual

let case027 _ =
  let testActual =
    decode (ConfigDecode.field "values" (ConfigDecode.dict ConfigDecode.int)) "[values]\na=1\nb=2" = Ok (Dict.fromList [
      ("a", 1),
      ("b", 2)
    ])
  Expect.isTrue "decode (ConfigDecode.field \"values\" (ConfigDecode.dict ConfigDecode.int)) \"[values]\\na=1\\nb=2\" = Ok (Dict.fromList [ (\"a\", 1), (\"b\", 2) ])" testActual

let case028 _ =
  let testActual =
    decode (ConfigDecode.field "value" (ConfigDecode.oneOf [
      ConfigDecode.map Int.toString ConfigDecode.int,
      ConfigDecode.string
    ])) "value='text'" = Ok "text"
  Expect.isTrue "decode (ConfigDecode.field \"value\" (ConfigDecode.oneOf [ ConfigDecode.map Int.toString ConfigDecode.int, ConfigDecode.string ])) \"value='text'\" = Ok \"text\"" testActual

let case029 _ =
  let testActual = text (ConfigDecode.choice [("small", 1), ("large", 2)]) "large" = Ok 2
  Expect.isTrue "text (ConfigDecode.choice [(\"small\", 1), (\"large\", 2)]) \"large\" = Ok 2" testActual

let case030 _ =
  let testActual = text (ConfigDecode.range 1 65535) "0" |> Result.isErr
  Expect.isTrue "text (ConfigDecode.range 1 65535) \"0\" |> Result.isErr" testActual

let case031 _ =
  let testActual =
    text (ConfigDecode.fromText (fun value ->
      if value = "on" then Ok true else Err "expected on")) "on" = Ok true
  Expect.isTrue "text (ConfigDecode.fromText (fun value -> if value = \"on\" then Ok true else Err \"expected on\")) \"on\" = Ok true" testActual

let located =
  match decode intField "value='bad'" with
  | Err [error] ->
    error.path = [
      TomlTypes.Key "value"
    ] && Option.andThen (fun origin ->
      origin.location) error.origin = Some {
      column = 7,
      endByte = 11,
      endColumn = 12,
      endLine = 1,
      line = 1,
      startByte = 6
    }
  | _ -> false

let case032 _ =
  let testActual = located
  Expect.isTrue "located" testActual

let capped =
  match Config.toml Config.limits (ConfigTypes.origin ConfigTypes.Supplied "test") (Bytes.fromString "a='bad'\nb=42\ntypo=1") with
  | Err _ -> false
  | Ok layer ->
    match Config.merge [layer] with
    | Err _ -> false
    | Ok config ->
      (ConfigDecode.decodeWith { Config.limits with
        maxErrors = 1
      } two config |> Result.mapError List.length) = Err 1

let case033 _ =
  let testActual = capped
  Expect.isTrue "capped" testActual

let pathBase =
  let base =
    Result.withDefault Path.empty (Path.fromString (if Path.nativeEncoding = "windows" then
      "C:\\app"
    else
      "/app"))
  let fileBase = Path.join base (Result.withDefault Path.empty (Path.fromString "config"))
  let origin = { (ConfigTypes.origin ConfigTypes.TomlFile "settings") with base = Some fileBase }
  match Config.toml Config.limits origin (Bytes.fromString "value='data'") with
  | Err _ -> false
  | Ok layer ->
    match Config.merge [layer] with
    | Err _ -> false
    | Ok config ->
      ConfigDecode.decode (ConfigDecode.field "value" (ConfigDecode.pathFromSource base)) config = Ok (Path.join fileBase (Result.withDefault Path.empty (Path.fromString "data")))

let case034 _ =
  let testActual = pathBase
  Expect.isTrue "pathBase" testActual

let case035 testInput =
  let number = testInput
  let testActual = text ConfigDecode.int (Int.toString number) = Ok number
  Expect.isTrue "property: text ConfigDecode.int (Int.toString number) = Ok number" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "ConfigDecodeSpec" [
  Test.test "decode intField \"value=42\" = Ok 42" case001,
  Test.test "kinds (decode intField \"value='42'\") = Err [ConfigTypes.WrongType]" case002,
  Test.test "text ConfigDecode.int \"42\" = Ok 42" case003,
  Test.test "text ConfigDecode.int \"00042\" = Ok 42" case004,
  Test.test "text ConfigDecode.int \"-9223372036854775808\" = Ok (-9223372036854775807 - 1)" case005,
  Test.test "text ConfigDecode.int \"9223372036854775808\" |> Result.isErr" case006,
  Test.test "text ConfigDecode.int \"0x10\" |> Result.isErr" case007,
  Test.test "text ConfigDecode.int \"1_000\" |> Result.isErr" case008,
  Test.test "text ConfigDecode.int \" 42\" |> Result.isErr" case009,
  Test.test "text ConfigDecode.int \"\" |> Result.isErr" case010,
  Test.test "text ConfigDecode.bool \"false\" = Ok false" case011,
  Test.test "text ConfigDecode.bool \"False\" |> Result.isErr" case012,
  Test.test "text ConfigDecode.float \"1.25e2\" = Ok 125.0" case013,
  Test.test "text ConfigDecode.float \"nan\" |> Result.isErr" case014,
  Test.test "text ConfigDecode.floatAll \"inf\" = Ok (Float.fromBits 0x7ff0000000000000)" case015,
  Test.test "decode (ConfigDecode.field \"value\" (ConfigDecode.withDefault 10 ConfigDecode.int)) \"\" = Ok 10" case016,
  Test.test "kinds (decode (ConfigDecode.field \"value\" (ConfigDecode.withDefault 10 ConfigDecode.int)) \"value='bad'\") = Err [ ConfigTypes.WrongType ]" case017,
  Test.test "decode (ConfigDecode.optionalField \"value\" ConfigDecode.int) \"\" = Ok None" case018,
  Test.test "kinds (decode (ConfigDecode.optionalField \"value\" ConfigDecode.int) \"value='bad'\") = Err [ ConfigTypes.WrongType ]" case019,
  Test.test "kinds (decode intField \"value=42\\ntypo=1\") = Err [ConfigTypes.UnknownField]" case020,
  Test.test "decode (ConfigDecode.allowUnknown intField) \"value=42\\nextra=1\" = Ok 42" case021,
  Test.test "kinds (decode (ConfigDecode.field \"table\" intField) \"[table]\\nvalue=1\\ntypo=2\") = Err [ ConfigTypes.UnknownField ]" case022,
  Test.test "kinds (decode two \"a='bad'\\nb=42\") = Err [ConfigTypes.WrongType, ConfigTypes.WrongType]" case023,
  Test.test "(match decode two \"\" with | Err errors -> List.map (fun error -> error.path) errors = [[TomlTypes.Key \"a\"], [TomlTypes.Key \"b\"]] | _ -> false)" case024,
  Test.test "decode (ConfigDecode.field \"values\" (ConfigDecode.array ConfigDecode.int)) \"values=[1,2,3]\" = Ok [| 1, 2, 3 |]" case025,
  Test.test "kinds (decode (ConfigDecode.field \"values\" (ConfigDecode.array ConfigDecode.int)) \"values=['bad',true]\") = Err [ ConfigTypes.WrongType, ConfigTypes.WrongType ]" case026,
  Test.test "decode (ConfigDecode.field \"values\" (ConfigDecode.dict ConfigDecode.int)) \"[values]\\na=1\\nb=2\" = Ok (Dict.fromList [ (\"a\", 1), (\"b\", 2) ])" case027,
  Test.test "decode (ConfigDecode.field \"value\" (ConfigDecode.oneOf [ ConfigDecode.map Int.toString ConfigDecode.int, ConfigDecode.string ])) \"value='text'\" = Ok \"text\"" case028,
  Test.test "text (ConfigDecode.choice [(\"small\", 1), (\"large\", 2)]) \"large\" = Ok 2" case029,
  Test.test "text (ConfigDecode.range 1 65535) \"0\" |> Result.isErr" case030,
  Test.test "text (ConfigDecode.fromText (fun value -> if value = \"on\" then Ok true else Err \"expected on\")) \"on\" = Ok true" case031,
  Test.test "located" case032,
  Test.test "capped" case033,
  Test.test "pathBase" case034,
  Test.property "property: text ConfigDecode.int (Int.toString number) = Ok number" Test.int case035
]
