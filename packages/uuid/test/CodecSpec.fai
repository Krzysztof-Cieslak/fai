module UuidCodecSpec

let canonical = "01234567-89ab-cdef-0123-456789abcdef"

let case001 _ =
  let testActual =
    Result.map Uuid.toString (Uuid.parse "01234567-89AB-CDEF-0123-456789ABCDEF") = Ok canonical
  Expect.isTrue "Result.map Uuid.toString (Uuid.parse \"01234567-89AB-CDEF-0123-456789ABCDEF\") = Ok canonical" testActual

let case002 _ =
  let testActual =
    Result.map Uuid.toBytes (Uuid.parse canonical) = Ok (Bytes.fromList [
      1,
      35,
      69,
      103,
      137,
      171,
      205,
      239,
      1,
      35,
      69,
      103,
      137,
      171,
      205,
      239
    ])
  Expect.isTrue "Result.map Uuid.toBytes (Uuid.parse canonical) = Ok (Bytes.fromList [ 1, 35, 69, 103, 137, 171, 205, 239, 1, 35, 69, 103, 137, 171, 205, 239 ])" testActual

let case003 _ =
  let testActual =
    Result.map Uuid.toString (Uuid.fromBytes (Bytes.fromList [
      1,
      35,
      69,
      103,
      137,
      171,
      205,
      239,
      1,
      35,
      69,
      103,
      137,
      171,
      205,
      239
    ])) = Ok canonical
  Expect.isTrue "Result.map Uuid.toString (Uuid.fromBytes (Bytes.fromList [ 1, 35, 69, 103, 137, 171, 205, 239, 1, 35, 69, 103, 137, 171, 205, 239 ])) = Ok canonical" testActual

let case004 _ =
  let testActual =
    Result.map Uuid.toString (Uuid.parseCompact "0123456789ABCDEF0123456789ABCDEF") = Ok canonical
  Expect.isTrue "Result.map Uuid.toString (Uuid.parseCompact \"0123456789ABCDEF0123456789ABCDEF\") = Ok canonical" testActual

let case005 _ =
  let testActual =
    Result.map Uuid.toString (Uuid.parseUrn "UrN:UuId:01234567-89AB-CDEF-0123-456789ABCDEF") = Ok canonical
  Expect.isTrue "Result.map Uuid.toString (Uuid.parseUrn \"UrN:UuId:01234567-89AB-CDEF-0123-456789ABCDEF\") = Ok canonical" testActual

let case006 _ =
  let testActual = Uuid.toString Uuid.nil
  let testExpected = "00000000-0000-0000-0000-000000000000"
  Expect.equal (Test.string).show testExpected testActual

let case007 _ =
  let testActual = Uuid.toString Uuid.max
  let testExpected = "ffffffff-ffff-ffff-ffff-ffffffffffff"
  Expect.equal (Test.string).show testExpected testActual

let case008 _ =
  let testActual = Uuid.toCompact Uuid.nil
  let testExpected = "00000000000000000000000000000000"
  Expect.equal (Test.string).show testExpected testActual

let case009 _ =
  let testActual = Uuid.toUrn Uuid.nil
  let testExpected = "urn:uuid:00000000-0000-0000-0000-000000000000"
  Expect.equal (Test.string).show testExpected testActual

let case010 _ =
  let testActual = Uuid.isNil Uuid.nil && not (Uuid.isNil Uuid.max) && Uuid.isMax Uuid.max
  Expect.isTrue "Uuid.isNil Uuid.nil && not (Uuid.isNil Uuid.max) && Uuid.isMax Uuid.max" testActual

let case011 _ =
  let testActual = Uuid.fromBytes Bytes.empty |> Result.isErr
  Expect.isTrue "Uuid.fromBytes Bytes.empty |> Result.isErr" testActual

let case012 _ =
  let testActual = Uuid.fromBytes (Bytes.fromList (List.range 0 15)) |> Result.isErr
  Expect.isTrue "Uuid.fromBytes (Bytes.fromList (List.range 0 15)) |> Result.isErr" testActual

let case013 _ =
  let testActual = Uuid.fromBytes (Bytes.fromList (List.range 0 17)) |> Result.isErr
  Expect.isTrue "Uuid.fromBytes (Bytes.fromList (List.range 0 17)) |> Result.isErr" testActual

let case014 _ =
  let testActual = Uuid.parse "0123456789abcdef0123456789abcdef" |> Result.isErr
  Expect.isTrue "Uuid.parse \"0123456789abcdef0123456789abcdef\" |> Result.isErr" testActual

let case015 _ =
  let testActual = Uuid.parse (" " ++ canonical) |> Result.isErr
  Expect.isTrue "Uuid.parse (\" \" ++ canonical) |> Result.isErr" testActual

let case016 _ =
  let testActual = Uuid.parse (canonical ++ " ") |> Result.isErr
  Expect.isTrue "Uuid.parse (canonical ++ \" \") |> Result.isErr" testActual

let case017 _ =
  let testActual = Uuid.parse ("{" ++ canonical ++ "}") |> Result.isErr
  Expect.isTrue "Uuid.parse (\"{\" ++ canonical ++ \"}\") |> Result.isErr" testActual

let case018 _ =
  let testActual = Uuid.parse ("urn:uuid:" ++ canonical) |> Result.isErr
  Expect.isTrue "Uuid.parse (\"urn:uuid:\" ++ canonical) |> Result.isErr" testActual

let case019 _ =
  let testActual = Uuid.parseCompact canonical |> Result.isErr
  Expect.isTrue "Uuid.parseCompact canonical |> Result.isErr" testActual

let case020 _ =
  let testActual =
    (match Uuid.parse "01234567_89ab-cdef-0123-456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 8
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567_89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 8 | _ -> false)" testActual

let case021 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab_cdef-0123-456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 13
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab_cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 13 | _ -> false)" testActual

let case022 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab-cdef_0123-456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 18
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab-cdef_0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 18 | _ -> false)" testActual

let case023 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab-cdef-0123_456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 23
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab-cdef-0123_456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 23 | _ -> false)" testActual

let case024 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab-cdef-0123-456789abcdeg" with
    | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" testActual

let case025 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab-cdef-0123-456789abcdeé" with
    | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcdeé\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" testActual

let case026 _ =
  let testActual =
    (match Uuid.parse "01234567-89ab-cdef-0123-456789abcde\u{0}" with
    | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcde\\u{0}\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" testActual

let case027 _ =
  let testActual =
    (match Uuid.parse "" with
    | Err error ->
      error.kind = Uuid.InvalidTextLength && error.expected = Some 36 && error.actual = Some 0 && error.offset = None
    | _ -> false)
  Expect.isTrue "(match Uuid.parse \"\" with | Err error -> error.kind = Uuid.InvalidTextLength && error.expected = Some 36 && error.actual = Some 0 && error.offset = None | _ …" testActual

let case028 _ =
  let testActual =
    (match Uuid.parseUrn "urn:guid:01234567-89ab-cdef-0123-456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 4
    | _ -> false)
  Expect.isTrue "(match Uuid.parseUrn \"urn:guid:01234567-89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 4 | _ -> false)" testActual

let case029 _ =
  let testActual =
    (match Uuid.parseUrn "urn:uuid:01234567-89ab-cdef-0123-456789abcdeg" with
    | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 44
    | _ -> false)
  Expect.isTrue "(match Uuid.parseUrn \"urn:uuid:01234567-89ab-cdef-0123-456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 44 | _ -> false)" testActual

let wordBytes word =
  List.map (fun index ->
    Int.and 255 (Int.shiftRightLogical word ((7 - index) * 8))) (List.range 0 8)

let roundTrip high low =
  let bytes = Bytes.fromList (List.append (wordBytes high) (wordBytes low))
  match Uuid.fromBytes bytes with
  | Err _ -> false
  | Ok uuid ->
    Uuid.toBytes uuid = bytes && Uuid.parse (Uuid.toString uuid) = Ok uuid && Uuid.parseCompact (Uuid.toCompact uuid) = Ok uuid && Uuid.parseUrn (Uuid.toUrn uuid) = Ok uuid

let case030 testInput =
  let (high, low) = testInput
  let testActual = roundTrip high low
  Expect.isTrue "property: roundTrip high low" testActual

let total text =
  match Uuid.parse text with
  | Ok uuid -> Bytes.length (Uuid.toBytes uuid) = 16 && String.length (Uuid.toString uuid) = 36
  | Err error ->
    match error.offset with
    | None -> true
    | Some offset -> offset >= 0 && offset < Bytes.length (Bytes.fromString text)

let case031 testInput =
  let text = testInput
  let testActual = total text
  Expect.isTrue "property: total text" testActual

let case032 _ =
  let testActual =
    (match Uuid.parseCompact "0123456789abcdef0123456789abcdeg" with
    | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 31
    | _ -> false)
  Expect.isTrue "(match Uuid.parseCompact \"0123456789abcdef0123456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 31 | _ -> false)" testActual

let case033 _ =
  let testActual =
    (match Uuid.parseUrn "urn:uuİd:01234567-89ab-cdef-0123-456789abcdef" with
    | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 6
    | _ -> false)
  Expect.isTrue "(match Uuid.parseUrn \"urn:uuİd:01234567-89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 6 | _ -> false)" testActual

let case034 _ =
  let testActual =
    (match Uuid.parse (String.joinArray "" (Array.repeat 4096 "0")) with
    | Err error -> error.kind = Uuid.InvalidTextLength && error.actual = Some 4096
    | _ -> false)
  Expect.isTrue "(match Uuid.parse (String.joinArray \"\" (Array.repeat 4096 \"0\")) with | Err error -> error.kind = Uuid.InvalidTextLength && error.actual = Some 4096 | _ -> fa…" testActual

let case035 _ =
  let testActual =
    (match Uuid.fromBytes (Bytes.fromList [1, 2]) with
    | Err error ->
      error.kind = Uuid.InvalidByteLength && error.expected = Some 16 && error.actual = Some 2
    | _ -> false)
  Expect.isTrue "(match Uuid.fromBytes (Bytes.fromList [1, 2]) with | Err error -> error.kind = Uuid.InvalidByteLength && error.expected = Some 16 && error.actual = Some 2 | …" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "UuidCodecSpec" [
  Test.test "Result.map Uuid.toString (Uuid.parse \"01234567-89AB-CDEF-0123-456789ABCDEF\") = Ok canonical" case001,
  Test.test "Result.map Uuid.toBytes (Uuid.parse canonical) = Ok (Bytes.fromList [ 1, 35, 69, 103, 137, 171, 205, 239, 1, 35, 69, 103, 137, 171, 205, 239 ])" case002,
  Test.test "Result.map Uuid.toString (Uuid.fromBytes (Bytes.fromList [ 1, 35, 69, 103, 137, 171, 205, 239, 1, 35, 69, 103, 137, 171, 205, 239 ])) = Ok canonical" case003,
  Test.test "Result.map Uuid.toString (Uuid.parseCompact \"0123456789ABCDEF0123456789ABCDEF\") = Ok canonical" case004,
  Test.test "Result.map Uuid.toString (Uuid.parseUrn \"UrN:UuId:01234567-89AB-CDEF-0123-456789ABCDEF\") = Ok canonical" case005,
  Test.test "Uuid.toString Uuid.nil = \"00000000-0000-0000-0000-000000000000\"" case006,
  Test.test "Uuid.toString Uuid.max = \"ffffffff-ffff-ffff-ffff-ffffffffffff\"" case007,
  Test.test "Uuid.toCompact Uuid.nil = \"00000000000000000000000000000000\"" case008,
  Test.test "Uuid.toUrn Uuid.nil = \"urn:uuid:00000000-0000-0000-0000-000000000000\"" case009,
  Test.test "Uuid.isNil Uuid.nil && not (Uuid.isNil Uuid.max) && Uuid.isMax Uuid.max" case010,
  Test.test "Uuid.fromBytes Bytes.empty |> Result.isErr" case011,
  Test.test "Uuid.fromBytes (Bytes.fromList (List.range 0 15)) |> Result.isErr" case012,
  Test.test "Uuid.fromBytes (Bytes.fromList (List.range 0 17)) |> Result.isErr" case013,
  Test.test "Uuid.parse \"0123456789abcdef0123456789abcdef\" |> Result.isErr" case014,
  Test.test "Uuid.parse (\" \" ++ canonical) |> Result.isErr" case015,
  Test.test "Uuid.parse (canonical ++ \" \") |> Result.isErr" case016,
  Test.test "Uuid.parse (\"{\" ++ canonical ++ \"}\") |> Result.isErr" case017,
  Test.test "Uuid.parse (\"urn:uuid:\" ++ canonical) |> Result.isErr" case018,
  Test.test "Uuid.parseCompact canonical |> Result.isErr" case019,
  Test.test "(match Uuid.parse \"01234567_89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 8 | _ -> false)" case020,
  Test.test "(match Uuid.parse \"01234567-89ab_cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 13 | _ -> false)" case021,
  Test.test "(match Uuid.parse \"01234567-89ab-cdef_0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 18 | _ -> false)" case022,
  Test.test "(match Uuid.parse \"01234567-89ab-cdef-0123_456789abcdef\" with | Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 23 | _ -> false)" case023,
  Test.test "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" case024,
  Test.test "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcdeé\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" case025,
  Test.test "(match Uuid.parse \"01234567-89ab-cdef-0123-456789abcde\\u{0}\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 35 | _ -> false)" case026,
  Test.test "(match Uuid.parse \"\" with | Err error -> error.kind = Uuid.InvalidTextLength && error.expected = Some 36 && error.actual = Some 0 && error.offset = None | _ …" case027,
  Test.test "(match Uuid.parseUrn \"urn:guid:01234567-89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 4 | _ -> false)" case028,
  Test.test "(match Uuid.parseUrn \"urn:uuid:01234567-89ab-cdef-0123-456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 44 | _ -> false)" case029,
  Test.property "property: roundTrip high low" (Test.tuple2 Test.int Test.int) case030,
  Test.property "property: total text" Test.string case031,
  Test.test "(match Uuid.parseCompact \"0123456789abcdef0123456789abcdeg\" with | Err error -> error.kind = Uuid.InvalidHex && error.offset = Some 31 | _ -> false)" case032,
  Test.test "(match Uuid.parseUrn \"urn:uuİd:01234567-89ab-cdef-0123-456789abcdef\" with | Err error -> error.kind = Uuid.InvalidPrefix && error.offset = Some 6 | _ -> false)" case033,
  Test.test "(match Uuid.parse (String.joinArray \"\" (Array.repeat 4096 \"0\")) with | Err error -> error.kind = Uuid.InvalidTextLength && error.actual = Some 4096 | _ -> fa…" case034,
  Test.test "(match Uuid.fromBytes (Bytes.fromList [1, 2]) with | Err error -> error.kind = Uuid.InvalidByteLength && error.expected = Some 16 && error.actual = Some 2 | …" case035
]
