example: Result.map Uuid.toString (Uuid.parseCompact "0123456789ABCDEF0123456789ABCDEF") = Ok canonical
example: Result.map Uuid.toString (Uuid.parseUrn "UrN:UuId:01234567-89AB-CDEF-0123-456789ABCDEF") = Ok canonical
example: Uuid.toString Uuid.nil = "00000000-0000-0000-0000-000000000000"
example: Uuid.toString Uuid.max = "ffffffff-ffff-ffff-ffff-ffffffffffff"
example: Uuid.toCompact Uuid.nil = "00000000000000000000000000000000"
example: Uuid.toUrn Uuid.nil = "urn:uuid:00000000-0000-0000-0000-000000000000"
example: Uuid.isNil Uuid.nil && not (Uuid.isNil Uuid.max) && Uuid.isMax Uuid.max
example: Uuid.fromBytes Bytes.empty |> Result.isErr
example: Uuid.fromBytes (Bytes.fromList (List.range 0 15)) |> Result.isErr
example: Uuid.fromBytes (Bytes.fromList (List.range 0 17)) |> Result.isErr
example: Uuid.parse "0123456789abcdef0123456789abcdef" |> Result.isErr
example: Uuid.parse (" " ++ canonical) |> Result.isErr
example: Uuid.parse (canonical ++ " ") |> Result.isErr
example: Uuid.parse ("{" ++ canonical ++ "}") |> Result.isErr
example: Uuid.parse ("urn:uuid:" ++ canonical) |> Result.isErr
example: Uuid.parseCompact canonical |> Result.isErr
example: (match Uuid.parse "01234567_89ab-cdef-0123-456789abcdef" with
| Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 8
| _ -> false)
example: (match Uuid.parse "01234567-89ab_cdef-0123-456789abcdef" with
| Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 13
| _ -> false)
example: (match Uuid.parse "01234567-89ab-cdef_0123-456789abcdef" with
| Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 18
| _ -> false)
example: (match Uuid.parse "01234567-89ab-cdef-0123_456789abcdef" with
| Err error -> error.kind = Uuid.InvalidSeparator && error.offset = Some 23
| _ -> false)
