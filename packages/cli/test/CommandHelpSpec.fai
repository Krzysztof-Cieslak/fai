module CommandHelpSpec

let serve = Args.optionWithDefault 8080 Args.int (Args.short 'p' (Args.named "port" "TCP port"))

let parser =
  Args.map2 (fun verbose port ->
    (verbose, port)) (Args.flag (Args.short 'v' (Args.named "verbose" "Verbose output"))) (Args.commands [
    Args.command "serve" "Serve files" serve
  ])

let app = Args.program (Args.version "tool 1.0" (Args.described "tool" "Example tool")) parser

let root =
  "Usage: tool [OPTIONS] <COMMAND>\n\nExample tool\n\nCommands:\n  serve  Serve files\n\nOptions:\n  -v, --verbose  Verbose output\n  -h, --help  Show this help\n  -V, --version  Show version\n"

let child =
  "Usage: tool serve [OPTIONS]\n\nServe files\n\nOptions:\n  -v, --verbose  Verbose output\n  -p, --port INT  TCP port (default: 8080)\n  -h, --help  Show this help\n  -V, --version  Show version\n"

let case001 _ =
  let testActual = Args.help app = Ok root
  Expect.isTrue "Args.help app = Ok root" testActual

let case002 _ =
  let testActual = Args.helpFor app [] = Ok root
  Expect.isTrue "Args.helpFor app [] = Ok root" testActual

let case003 _ =
  let testActual = Args.helpFor app ["serve"] = Ok child
  Expect.isTrue "Args.helpFor app [\"serve\"] = Ok child" testActual

let case004 _ =
  let testActual = Args.parse app ["--help", "serve"] = Ok (Args.Help root)
  Expect.isTrue "Args.parse app [\"--help\", \"serve\"] = Ok (Args.Help root)" testActual

let case005 _ =
  let testActual = Args.parse app ["serve", "--help"] = Ok (Args.Help child)
  Expect.isTrue "Args.parse app [\"serve\", \"--help\"] = Ok (Args.Help child)" testActual

let case006 _ =
  let testActual = Args.parse app ["serve", "-vh"] = Ok (Args.Help child)
  Expect.isTrue "Args.parse app [\"serve\", \"-vh\"] = Ok (Args.Help child)" testActual

let case007 _ =
  let testActual =
    Args.parse app ["serve", "--port=bad", "--help", "ignored"] = Ok (Args.Help child)
  Expect.isTrue "Args.parse app [\"serve\", \"--port=bad\", \"--help\", \"ignored\"] = Ok (Args.Help child)" testActual

let case008 _ =
  let testActual = Args.parse app ["serve", "--version"] = Ok (Args.Version "tool 1.0")
  Expect.isTrue "Args.parse app [\"serve\", \"--version\"] = Ok (Args.Version \"tool 1.0\")" testActual

let case009 _ =
  let testActual = Args.parse app ["serve", "-V"] = Ok (Args.Version "tool 1.0")
  Expect.isTrue "Args.parse app [\"serve\", \"-V\"] = Ok (Args.Version \"tool 1.0\")" testActual

let case010 _ =
  let testActual =
    Args.helpFor app [
      "unknown"
    ] = Err {
      command = ["tool"],
      index = None,
      kind = Args.UnknownCommand,
      message = "unknown command \"unknown\"",
      token = None
    }
  Expect.isTrue "Args.helpFor app [ \"unknown\" ] = Err { command = [\"tool\"], index = None, kind = Args.UnknownCommand, message = \"unknown command \\\"unknown\\\"\", token = None }" testActual

let nested =
  Args.program (Args.described "tool" "Root") (Args.commands [
    Args.command "config" "Configuration" (Args.commands [
      Args.command "get" "Read" (Args.argument Args.string (Args.positional "KEY" "Key name"))
    ])
  ])

let case011 _ =
  let testActual =
    Args.helpFor nested [
      "config",
      "get"
    ] = Ok "Usage: tool config get [OPTIONS] KEY\n\nRead\n\nArguments:\n  KEY  Key name\n\nOptions:\n  -h, --help  Show this help\n"
  Expect.isTrue "Args.helpFor nested [ \"config\", \"get\" ] = Ok \"Usage: tool config get [OPTIONS] KEY\\n\\nRead\\n\\nArguments:\\n KEY Key name\\n\\nOptions:\\n -h, --help Show this he…" testActual

let case012 _ =
  let testActual =
    Args.parse nested [
      "config",
      "get",
      "--help"
    ] = Result.map (fun text -> Args.Help text) (Args.helpFor nested ["config", "get"])
  Expect.isTrue "Args.parse nested [ \"config\", \"get\", \"--help\" ] = Result.map (fun text -> Args.Help text) (Args.helpFor nested [\"config\", \"get\"])" testActual

let required =
  Args.program (Args.described "tool" "") (Args.map2 (fun key result ->
    (key, result)) (Args.requiredOption Args.string (Args.named "key" "API key")) (Args.commands [
    Args.command "run" "Execute" (Args.succeed ())
  ]))

let case013 _ =
  let testActual =
    Args.helpFor required [
      "run"
    ] = Ok "Usage: tool run [OPTIONS] --key TEXT\n\nExecute\n\nOptions:\n  --key TEXT  API key (required)\n  -h, --help  Show this help\n"
  Expect.isTrue "Args.helpFor required [ \"run\" ] = Ok \"Usage: tool run [OPTIONS] --key TEXT\\n\\nExecute\\n\\nOptions:\\n --key TEXT API key (required)\\n -h, --help Show this help\\n\"" testActual

let case014 _ =
  let testActual = Result.isOk (Args.parse required ["run", "--help"])
  Expect.isTrue "Result.isOk (Args.parse required [\"run\", \"--help\"])" testActual

let case015 _ =
  let testActual =
    Args.helpFor nested [
      "config",
      "missing"
    ] = Err {
      command = ["tool", "config"],
      index = None,
      kind = Args.UnknownCommand,
      message = "unknown command \"missing\"",
      token = None
    }
  Expect.isTrue "Args.helpFor nested [ \"config\", \"missing\" ] = Err { command = [\"tool\", \"config\"], index = None, kind = Args.UnknownCommand, message = \"unknown command \\\"miss…" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "CommandHelpSpec" [
  Test.test "Args.help app = Ok root" case001,
  Test.test "Args.helpFor app [] = Ok root" case002,
  Test.test "Args.helpFor app [\"serve\"] = Ok child" case003,
  Test.test "Args.parse app [\"--help\", \"serve\"] = Ok (Args.Help root)" case004,
  Test.test "Args.parse app [\"serve\", \"--help\"] = Ok (Args.Help child)" case005,
  Test.test "Args.parse app [\"serve\", \"-vh\"] = Ok (Args.Help child)" case006,
  Test.test "Args.parse app [\"serve\", \"--port=bad\", \"--help\", \"ignored\"] = Ok (Args.Help child)" case007,
  Test.test "Args.parse app [\"serve\", \"--version\"] = Ok (Args.Version \"tool 1.0\")" case008,
  Test.test "Args.parse app [\"serve\", \"-V\"] = Ok (Args.Version \"tool 1.0\")" case009,
  Test.test "Args.helpFor app [ \"unknown\" ] = Err { command = [\"tool\"], index = None, kind = Args.UnknownCommand, message = \"unknown command \\\"unknown\\\"\", token = None }" case010,
  Test.test "Args.helpFor nested [ \"config\", \"get\" ] = Ok \"Usage: tool config get [OPTIONS] KEY\\n\\nRead\\n\\nArguments:\\n KEY Key name\\n\\nOptions:\\n -h, --help Show this he…" case011,
  Test.test "Args.parse nested [ \"config\", \"get\", \"--help\" ] = Result.map (fun text -> Args.Help text) (Args.helpFor nested [\"config\", \"get\"])" case012,
  Test.test "Args.helpFor required [ \"run\" ] = Ok \"Usage: tool run [OPTIONS] --key TEXT\\n\\nExecute\\n\\nOptions:\\n --key TEXT API key (required)\\n -h, --help Show this help\\n\"" case013,
  Test.test "Result.isOk (Args.parse required [\"run\", \"--help\"])" case014,
  Test.test "Args.helpFor nested [ \"config\", \"missing\" ] = Err { command = [\"tool\", \"config\"], index = None, kind = Args.UnknownCommand, message = \"unknown command \\\"miss…" case015
]
