module CommandDefinitionSpec

let invalid path parser =
  match Args.parse (Args.program (Args.described "tool" "") parser) ["--help"] with
  | Err error -> error.kind = Args.InvalidDefinition && error.command = path && error.index = None
  | Ok _ -> false

let case001 _ =
  let testActual = invalid ["tool"] (Args.commands [])
  Expect.isTrue "invalid [\"tool\"] (Args.commands [])" testActual

let case002 _ =
  let testActual = invalid ["tool"] (Args.commands [Args.command "" "" (Args.succeed ())])
  Expect.isTrue "invalid [\"tool\"] (Args.commands [Args.command \"\" \"\" (Args.succeed ())])" testActual

let case003 _ =
  let testActual =
    invalid [
      "tool"
    ] (Args.commands [
      Args.command "same" "" (Args.succeed 1),
      Args.command "same" "" (Args.succeed 2)
    ])
  Expect.isTrue "invalid [ \"tool\" ] (Args.commands [Args.command \"same\" \"\" (Args.succeed 1), Args.command \"same\" \"\" (Args.succeed 2)])" testActual

let case004 _ =
  let testActual = invalid ["tool"] (Args.commands [Args.command "bad name" "" (Args.succeed ())])
  Expect.isTrue "invalid [\"tool\"] (Args.commands [Args.command \"bad name\" \"\" (Args.succeed ())])" testActual

let case005 _ =
  let testActual = invalid ["tool"] (Args.commands [Args.command "--bad" "" (Args.succeed ())])
  Expect.isTrue "invalid [\"tool\"] (Args.commands [Args.command \"--bad\" \"\" (Args.succeed ())])" testActual

let case006 _ =
  let testActual = invalid ["tool"] (Args.commands [Args.command "é" "" (Args.succeed ())])
  Expect.isTrue "invalid [\"tool\"] (Args.commands [Args.command \"é\" \"\" (Args.succeed ())])" testActual

let case007 _ =
  let testActual =
    invalid [
      "tool"
    ] (Args.map2 (fun a b ->
      (a, b)) (Args.commands [
      Args.command "one" "" (Args.succeed 1)
    ]) (Args.commands [Args.command "two" "" (Args.succeed 2)]))
  Expect.isTrue "invalid [ \"tool\" ] (Args.map2 (fun a b -> (a, b)) (Args.commands [ Args.command \"one\" \"\" (Args.succeed 1) ]) (Args.commands [Args.command \"two\" \"\" (Args.succ…" testActual

let case008 _ =
  let testActual =
    invalid [
      "tool"
    ] (Args.map2 (fun a b ->
      (a, b)) (Args.argument Args.string (Args.positional "FILE" "")) (Args.commands [
      Args.command "run" "" (Args.succeed ())
    ]))
  Expect.isTrue "invalid [ \"tool\" ] (Args.map2 (fun a b -> (a, b)) (Args.argument Args.string (Args.positional \"FILE\" \"\")) (Args.commands [ Args.command \"run\" \"\" (Args.succee…" testActual

let case009 _ =
  let testActual =
    invalid [
      "tool",
      "run"
    ] (Args.map2 (fun a b ->
      (a, b)) (Args.flag (Args.named "verbose" "")) (Args.commands [
      Args.command "run" "" (Args.flag (Args.named "verbose" ""))
    ]))
  Expect.isTrue "invalid [ \"tool\", \"run\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.named \"verbose\" \"\")) (Args.commands [ Args.command \"run\" \"\" (Args.flag (Args.named …" testActual

let case010 _ =
  let testActual =
    invalid [
      "tool",
      "run"
    ] (Args.map2 (fun a b ->
      (a, b)) (Args.flag (Args.short 'x' (Args.named "one" ""))) (Args.commands [
      Args.command "run" "" (Args.flag (Args.short 'x' (Args.named "two" "")))
    ]))
  Expect.isTrue "invalid [ \"tool\", \"run\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.short 'x' (Args.named \"one\" \"\"))) (Args.commands [ Args.command \"run\" \"\" (Args.flag…" testActual

let case011 _ =
  let testActual =
    invalid [
      "tool",
      "bad"
    ] (Args.commands [
      Args.command "good" "" (Args.succeed false),
      Args.command "bad" "" (Args.flag (Args.named "help" ""))
    ])
  Expect.isTrue "invalid [ \"tool\", \"bad\" ] (Args.commands [ Args.command \"good\" \"\" (Args.succeed false), Args.command \"bad\" \"\" (Args.flag (Args.named \"help\" \"\")) ])" testActual

let case012 _ =
  let testActual =
    invalid [
      "tool",
      "outer",
      "inner"
    ] (Args.map2 (fun a b ->
      (a, b)) (Args.flag (Args.named "global" "")) (Args.commands [
      Args.command "outer" "" (Args.commands [
        Args.command "inner" "" (Args.flag (Args.named "global" ""))
      ])
    ]))
  Expect.isTrue "invalid [ \"tool\", \"outer\", \"inner\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.named \"global\" \"\")) (Args.commands [ Args.command \"outer\" \"\" (Args.comma…" testActual

let versionConflict =
  Args.program (Args.version "1.0" (Args.described "tool" "")) (Args.commands [
    Args.command "run" "" (Args.flag (Args.named "version" ""))
  ])

let case013 _ =
  let testActual = Result.isErr (Args.validateDefinition versionConflict)
  Expect.isTrue "Result.isErr (Args.validateDefinition versionConflict)" testActual

tests : Test.Suite Test.Context { }
let tests = Test.describe "CommandDefinitionSpec" [
  Test.test "invalid [\"tool\"] (Args.commands [])" case001,
  Test.test "invalid [\"tool\"] (Args.commands [Args.command \"\" \"\" (Args.succeed ())])" case002,
  Test.test "invalid [ \"tool\" ] (Args.commands [Args.command \"same\" \"\" (Args.succeed 1), Args.command \"same\" \"\" (Args.succeed 2)])" case003,
  Test.test "invalid [\"tool\"] (Args.commands [Args.command \"bad name\" \"\" (Args.succeed ())])" case004,
  Test.test "invalid [\"tool\"] (Args.commands [Args.command \"--bad\" \"\" (Args.succeed ())])" case005,
  Test.test "invalid [\"tool\"] (Args.commands [Args.command \"é\" \"\" (Args.succeed ())])" case006,
  Test.test "invalid [ \"tool\" ] (Args.map2 (fun a b -> (a, b)) (Args.commands [ Args.command \"one\" \"\" (Args.succeed 1) ]) (Args.commands [Args.command \"two\" \"\" (Args.succ…" case007,
  Test.test "invalid [ \"tool\" ] (Args.map2 (fun a b -> (a, b)) (Args.argument Args.string (Args.positional \"FILE\" \"\")) (Args.commands [ Args.command \"run\" \"\" (Args.succee…" case008,
  Test.test "invalid [ \"tool\", \"run\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.named \"verbose\" \"\")) (Args.commands [ Args.command \"run\" \"\" (Args.flag (Args.named …" case009,
  Test.test "invalid [ \"tool\", \"run\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.short 'x' (Args.named \"one\" \"\"))) (Args.commands [ Args.command \"run\" \"\" (Args.flag…" case010,
  Test.test "invalid [ \"tool\", \"bad\" ] (Args.commands [ Args.command \"good\" \"\" (Args.succeed false), Args.command \"bad\" \"\" (Args.flag (Args.named \"help\" \"\")) ])" case011,
  Test.test "invalid [ \"tool\", \"outer\", \"inner\" ] (Args.map2 (fun a b -> (a, b)) (Args.flag (Args.named \"global\" \"\")) (Args.commands [ Args.command \"outer\" \"\" (Args.comma…" case012,
  Test.test "Result.isErr (Args.validateDefinition versionConflict)" case013
]
