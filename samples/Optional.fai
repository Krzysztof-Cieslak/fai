module Optional

// `Option`, `Some`, and `None` come from the prelude, visible unqualified
// everywhere; its operations are reached qualified, e.g. `Option.map`.
/// Safe division: `None` when the divisor is zero.
public safeDivide : Int -> Int -> Option Int
let safeDivide a b = if b = 0 then None else Some (a / b)

/// Double the value inside an `Option`, if present.
public doubled : Option Int -> Option Int
let doubled opt = Option.map (fun x -> x * 2) opt

/// Wrap any value, including another option.
public present : 'a -> Option 'a
let present value = Some value
example: present (Some 7) = Some (Some 7)
example: Option.withDefault 1.25 (present 2.5) = 2.5
