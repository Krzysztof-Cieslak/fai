module Lists

/// Apply f to every element, preserving order.
/// This is strict: a later short-circuiting consumer does not skip map's work.
public map : ('a -> 'b) -> List 'a -> List 'b
let map f xs =
  match xs with
  | [] -> []
  | x :: rest -> f x :: map f rest
example: map (fun x -> x + 1) [1, 2, 3] = [2, 3, 4]
forall xs: map (fun x -> x) xs = xs

public foldl : ('acc -> 'a -> 'acc) -> 'acc -> List 'a -> 'acc
let foldl f acc xs =
  match xs with
  | [] -> acc
  | x :: rest -> foldl f (f acc x) rest

// `reverse` can refer to `foldl` above freely (mutual recursion, no `rec`).
public reverse : List 'a -> List 'a
let reverse xs = foldl (fun acc x -> x :: acc) [] xs
forall xs: reverse (reverse xs) = xs

/// Stable sorting keeps equal-key elements in their original order.
public byRemainder : List Int -> List Int
let byRemainder xs = List.sortBy (fun a b -> compare (a % 3) (b % 3)) xs
example: byRemainder [3, 1, 6, 4, 9, 2] = [3, 6, 9, 1, 4, 2]
// Large stable sorts use two private buffers, with one initial bulk copy.
example: List.sortBy compare (reverse (List.range 0 65)) = List.range 0 65
example: List.sortBy compare (List.map (const 7) (List.range 0 65)) = List.map (const 7) (List.range 0 65)

/// Folding concatenated chunks preserves their left-to-right element order.
public chunkSum : List (List Int) -> Int
let chunkSum chunks = List.foldl (fun acc x -> acc + x) 0 (List.concat chunks)
example: chunkSum [[1, 2], [], [3]] = 6

/// Reverse a prefix while preserving the remaining elements.
public reverseFirst : Int -> List 'a -> List 'a
let reverseFirst n xs = List.append (List.reverse (List.take n xs)) (List.drop n xs)
example: reverseFirst 3 [1, 2, 3, 4, 5] = [3, 2, 1, 4, 5]
example: reverseFirst (-1) [1, 2] = [1, 2]
example: reverseFirst 20 [1, 2] = [2, 1]
