module MapSumShared

// The shared twin of `MapSum`: `xs` is used again by `Array.sum xs` after
// `Array.map`, so the source must remain materialized through two traversals.
// The map/sum intermediate fuses away. The Rust and OCaml peers likewise build
// one array, fold doubled elements, then fold the original elements. Used by the
// Rust-vs-Fai runtime benchmark.
/// The benchmark workload: sum of doubling [0, n) plus the sum of [0, n), which
/// equals 3 * sum [0, n).
public run : Int -> Int
let run n =
  let xs = Array.range 0 n
  Array.sum (Array.map (fun x -> x * 2) xs) + Array.sum xs
example: run 4 = 18

public main : Runtime -> Unit / { Console }
let main runtime = runtime.console.writeLine (Int.toString (run 1500000))
