module ExprEval

// A recursive-descent parser for arithmetic expressions: a token `List` becomes
// an `Expr` tree honouring `*` over `+`/`-`, then an iterative evaluator consumes it.
// The parser threads `Option` results through the token stream, building a nested
// algebraic data type — a linked `List` is the structure a recursive-descent
// parser naturally consumes (head/tail), so the Rust baseline parses the same way
// over a cons-list rather than folding a `Vec`. Tokens are generated
// programmatically. Used by the Rust-vs-Fai runtime benchmark.
type Token =
  | TNum Int
  | TPlus
  | TMinus
  | TStar

type Expr =
  | Num Int
  | Add Expr Expr
  | Sub Expr Expr
  | Mul Expr Expr

// A factor is a single number.
parseFactor : List Token -> Option (Expr * List Token)
let parseFactor tokens =
  match tokens with
  | TNum k :: rest -> Some (Num k, rest)
  | _ -> None

// A term is a factor followed by zero or more `* factor`.
parseTerm : List Token -> Option (Expr * List Token)
let parseTerm tokens =
  match parseFactor tokens with
  | None -> None
  | Some (left, rest) -> parseTermTail left rest

parseTermTail : Expr -> List Token -> Option (Expr * List Token)
let parseTermTail left tokens =
  match tokens with
  | TStar :: rest ->
    match parseFactor rest with
    | None -> None
    | Some (right, rest2) -> parseTermTail (Mul left right) rest2
  | _ -> Some (left, tokens)

// An expression is a term followed by zero or more `(+|-) term`.
parseExpr : List Token -> Option (Expr * List Token)
let parseExpr tokens =
  match parseTerm tokens with
  | None -> None
  | Some (left, rest) -> parseExprTail left rest

parseExprTail : Expr -> List Token -> Option (Expr * List Token)
let parseExprTail left tokens =
  match tokens with
  | TPlus :: rest ->
    match parseTerm rest with
    | None -> None
    | Some (right, rest2) -> parseExprTail (Add left right) rest2
  | TMinus :: rest ->
    match parseTerm rest with
    | None -> None
    | Some (right, rest2) -> parseExprTail (Sub left right) rest2
  | _ -> Some (left, tokens)

type Work =
  | Visit Expr
  | AddResult
  | SubResult
  | MulResult

// Linked work and value stacks keep a deep left spine off the native stack.
evalLoop : List Work -> List Int -> Int
let evalLoop work values =
  match work with
  | [] ->
    match values with
    | result :: _ -> result
    | [] -> 0
  | Visit (Num k) :: rest -> evalLoop rest (k :: values)
  | Visit (Add a b) :: rest -> evalLoop (Visit a :: Visit b :: AddResult :: rest) values
  | Visit (Sub a b) :: rest -> evalLoop (Visit a :: Visit b :: SubResult :: rest) values
  | Visit (Mul a b) :: rest -> evalLoop (Visit a :: Visit b :: MulResult :: rest) values
  | operation :: rest ->
    match values with
    | right :: left :: tail ->
      let result =
        match operation with
        | AddResult -> left + right
        | SubResult -> left - right
        | MulResult -> left * right
        | Visit _ -> 0
      evalLoop rest (result :: tail)
    | _ -> 0

eval : Expr -> Int
let eval e = evalLoop [Visit e] []
example: eval (Sub (Num 20) (Mul (Num 3) (Num 4))) = 8

// The operator between numbers i and i+1, cycling +, *, -.
opFor : Int -> Token
let opFor i =
  let m = i % 3
  if m = 0 then TPlus else if m = 1 then TStar else TMinus

// Build back-to-front with the same constant-stack constructor order on each peer.
genTokens : Int -> List Token -> List Token
let genTokens i acc =
  if i < 0 then
    acc
  else
    let withNumber = TNum (i % 9 + 1) :: acc
    let next = if i = 0 then withNumber else opFor (i - 1) :: withNumber
    genTokens (i - 1) next

/// The benchmark workload: evaluate a generated n-number expression.
public run : Int -> Int
let run n =
  match parseExpr (genTokens (n - 1) []) with
  | None -> 0
  | Some (e, _) -> eval e
example: run 3 = 7

public main : Runtime -> Unit / { Console }
let main runtime = runtime.console.writeLine (Int.toString (run 4000))
