module JsonSerialize

// Build a balanced JSON-like tree of a given size, then serialize it to a string
// and measure that string's length. This exercises a recursive, multi-constructor
// algebraic data type and one growing output string (`++`, `Int.toString`).
// Used by the Rust-vs-Fai runtime benchmark.
type Json =
  | JNull
  | JBool Bool
  | JInt Int
  | JArr (List Json)
  | JObj (List (String * Json))

// A leaf chosen by the seed, cycling null / bool / int.
leaf : Int -> Json
let leaf seed =
  let m = seed % 3
  if m = 0 then JNull else if m = 1 then JBool true else JInt seed

// A balanced tree of `size` nodes: split the budget between two children, choosing
// an array or object by the seed. Recursion depth is logarithmic in `size`.
build : Int -> Int -> Json
let build seed size =
  if size <= 1 then
    leaf seed
  else
    let half = size / 2
    if seed % 2 = 0 then
      JArr [build (seed + 1) half, build (seed + 2) (size - half - 1)]
    else
      JObj [("a", build (seed + 1) half), ("b", build (seed + 2) (size - half - 1))]

// Thread the output through the traversal so unique string appends reuse the
// buffer. Children do not create intermediate serialized strings.
serializeInto : String -> Json -> String
let serializeInto output j =
  match j with
  | JNull -> output ++ "null"
  | JBool b -> output ++ (if b then "true" else "false")
  | JInt k -> output ++ Int.toString k
  | JArr items -> serializeItems (output ++ "[") true items ++ "]"
  | JObj fields -> serializeFields (output ++ "{") true fields ++ "}"

serializeItems : String -> Bool -> List Json -> String
let serializeItems output first items =
  match items with
  | [] -> output
  | item :: rest ->
    let prefix = if first then output else output ++ ","
    serializeItems (serializeInto prefix item) false rest

serializeFields : String -> Bool -> List (String * Json) -> String
let serializeFields output first fields =
  match fields with
  | [] -> output
  | (key, value) :: rest ->
    let prefix = if first then output else output ++ ","
    serializeFields (serializeInto (prefix ++ "\"" ++ key ++ "\":") value) false rest

serialize : Json -> String
let serialize j = serializeInto "" j
example: serialize (JArr []) = "[]"
example: serialize (JObj []) = "{}"
example: serialize (JBool false) = "false"
example: serialize (build 0 4) = "[{\"a\":2,\"b\":null},2]"

/// The benchmark workload: the length of the serialized n-node JSON tree.
public run : Int -> Int
let run n = String.length (serialize (build 0 n))
example: run 1 = 4

public main : Runtime -> Unit / { Console }
let main runtime = runtime.console.writeLine (Int.toString (run 30000))
