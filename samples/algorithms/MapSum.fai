module MapSum

// Map and sum a range through the Array API. The directly nested pipeline can
// fuse without materializing a buffer. A compiler may also reduce this arithmetic
// series to a closed form; this is an optimization case, not sustained array
// traversal throughput. Used by the Rust-vs-Fai runtime benchmark.
/// The benchmark workload: sum of doubling every element of [0, n).
public run : Int -> Int
let run n = Array.sum (Array.map (fun x -> x * 2) (Array.range 0 n))
example: run 4 = 12

public main : Runtime -> Unit / { Console }
let main runtime = runtime.console.writeLine (Int.toString (run 1500000))
